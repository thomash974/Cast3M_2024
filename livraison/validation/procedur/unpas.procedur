          'SI' ITHER ;
            'DETR' FTHE ;
             XXX1= (TETA2 - TETA1) * COEPI + TETA1;
             STAB12.'TET2' = XXX1;
             ETT MSRTT = PAS_EPTH PRECED ZMODL ZMAT XXX1;
          'FINS';
          'SI' LOGDEF ;
             XXX1 = 'REDU' (DDEFOR0 '*' COEPI) ZMODLI;
             STAB12.'DEFOR2' = STAB12.'DEFOR1' '+' XXX1    ;
            'DETR' XXX1;'DETR' FDEF ;
          'FINS';
'FINS';

'SI'  IDYN  ;
           STAB12.'FOPL' = ZFP ;
           STAB12.'VITI' = VITI;
           STAB12.'ACCEI' = ACCEI;
           'SI' IMPLP; STAB12.'VAUX' = VADD; 'FINS';
'FINS' ;
