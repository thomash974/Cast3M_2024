'FINSI' ;

*Nombre maximum de sous-pas atteint? si oui, arret de pasapas
WTAB.'ISOUSPAS' = WTAB.'ISOUSPAS' + 1;
'SI' (WTAB.'ISOUSPAS' >EG WTAB.'MAXSOUSPAS');
     'ERREUR' 996 ;
'FINS';
