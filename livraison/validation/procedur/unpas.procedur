'FINS' ;
'SINON' ;
  'SI' WTAB.'NVSTNL' ; 'SI' ZFLCONV ; 'QUITTE' ETIQ ; 'FINSI'; 'FINSI' ;
*FOR_MECA
'FINSI' ;
*
*'SI' IPLAVI ;
*     'DETR' ZSIGF ;  'DETR' ZVARF ;  'DETR' ZDEIF ;
*'FINS' ;

'SI' IFEFP ; 'DETR' ZRIKTA ; 'DETR' GEOM2;  'FINS' ;
*
*   PERF-RAID niveau 3 : stagnation de la convergence. La raideur gelee en
*   debut de pas est devenue trop raide pour l'endommagement courant : elle
*   est reconstruite (memes HOOK et RIGI qu'en debut de pas) avec les
*   variables internes de l'iteration courante. Le residu et les criteres
*   d'arret ne changent pas. Au plus 3 fois par pas, a 4 iterations
*   d'intervalle, jamais en non-convergence deja declaree.
'SI' ISTGOK ;
  TSTG . IT = XCONV ;
  XSTG3 = 1.E50 ;
  ISTG3 = IT - 3 ;
  'SI' ('EXIS' TSTG ISTG3) ;
    XSTG3 = TSTG . ISTG3 ;
  'FINSI' ;
*   trace PERF-RAID (une seule fois par table, a l'iteration 6)
  'SI' ((IT '>EG' 6) 'ET' ('NON' ('EXIS' WTAB 'STAG_TRACE'))) ;
    WTAB . 'STAG_TRACE' = VRAI ;
    'MESS' ' PERF-RAID trace it=' IT ' XCONV=' XCONV ' XSTG3=' XSTG3 ' ZPREC=' ZPREC ;
    'MESS' ' PERF-RAID trace NBRFR=' NBRFR ' ITRFR=' ITRFR ;
    'SI' PASTEST ; 'MESS' ' PERF-RAID trace PASTEST vrai' ; 'FINSI' ;
    'SI' NONCONV ; 'MESS' ' PERF-RAID trace NONCONV vrai' ; 'FINSI' ;
    'MESS' ' PERF-RAID trace type ZVARF=' ('TYPE' ZVARF) ;
  'FINSI' ;
  'SI' ((IT '>EG' 5) 'ET' ((IT - ITRFR) '>EG' 4) 'ET' (NBRFR '<' 3) 'ET'
        ('NON' PASTEST) 'ET' ('NON' NONCONV) 'ET'
        ('EGA' ('TYPE' ZVARF) 'MCHAML  ') 'ET'
        (XCONV '>' (10. * ZPREC)) 'ET' (XCONV '>' (0.7 * XSTG3))) ;
    'MESS' ' PERF-RAID : stagnation a l''iteration' ' ' IT
           ' : raideur reconstruite avec l''endommagement courant' ;
    HOOKRF = 'HOOK' ZMODL MMMM ZVARF ;
    RHRF   = 'RIGI' ZMODL HOOKRF MMMM ;
    'DETR' HOOKRF ;
    ZRAID  = RHRF 'ET' ZCLIM0 ;
    IRFRCH = VRAI ;
    NBRFR  = NBRFR + 1 ;
    ITRFR  = IT ;
    ITACC  = 4 ;
    WTAB . 'NB_RAFRAICH' = WTAB . 'NB_RAFRAICH' + 1 ;
  'FINSI' ;
'FINSI' ;
*
IPREM = FAUX;      IAFAIR=VRAI; RECA_K = FAUX;
*
dpsmaxp = dpsmax;
zsigfp =zsigf;
depstp = depst;
zdeptp = zdept;
'FIN' ETIQ ;

*=======================================================================
*===== FIN DE LA BOUCLE DE CONVERGENCE                             =====
*=======================================================================
'SI' WTAB.'NVSTNL' ; 
  STAB12.'ZVIFL' = ZVIFL ;
  'SI' ('NON' ('EXISTE' WTAB 'QNSL')) ;
    WTAB.'QNSL' = 'MASSE' 'PRES' WTAB.'MOD_NSL' WTAB.'MAT_NSL' ;
  'FINSI' ;
  QNSL = WTAB.'QNSL' ;
  FPREFL = 'PROI' WTAB.'MOD_NSL' ZVIFL ;
  ZPREFL = 'RESOUT' QNSL FPREFL ;
  STAB12.'ZPREFL' = ZPREFL ;
'FINSI' ;

'SI' WTAB.'FOR_MECA' ;
*
 'FORM' geom1;
 augmult = augmult * 0.55 ;
    si (augmult < 1d-2); augmult = 1d-2; finsi;
 zdep1d = zdept 'ENLE' 'LX';
*
*  on sauve les pseudo forces de frottement pour initialiser
*  l'iteration suivante
'SI' (WTAB. 'CAFROTTE' 'ET' IMPO12);
     STAB12.'FFROT'= 'COPIER' FFROT;
'FINS';
**  ON cherche a sauver la partie Forces nonlineaires trouvee pendant
*  ce pas pour s'en servir pour l'estimation  de l'initialisation du pas
*  DFNL = K*DU  - DF  - residu
*  Ktot*dutot ne contient pas les forces de reactions mais les forces
* internes dues a un champ de deformation initiales ( thermique)
* donc  enlever ZDFINI au lieu de DFEXT0
* pour les forces suiveuses on fait delta FP
* pour etre plus precis on fait  aussi intervenir le residu
*
               STAB12.'RESIDU' = RESIDC;
***            'SI' ('NEG' ('TYPE' ZRAIDNA) 'RIGIDITE'); ZRAIDNA = ZRAID; 'FINSI';
*   PERF-RAID niveau 3 : l'estimation de FNONL utilise la raideur du debut
*   de pas (comme sans rafraichissement)
           'SI' IRFRCH ;
               ZRAID = ZRAIDS0 ;
           'FINSI' ;
            zraidna = zraid;
               XXX1 = ZRAIDNA * ZDEPT;
               XXX3 = ZDFINI * COEPI;
               XXX4 = XXX1 - XXX3;
               XXX3 = XXX4 + RESIDC;
               XXX1 = XXX3 - FREAP ;
               XXX5 = XXX1 'ENLEVER' 'FLX ' ;
               'DETR' XXX1 ; 'DETR' XXX3 ; 'DETR' XXX4 ;
* en cas de non convergence on cumule les forces non lineaires
           'SI' WTAB.'CONV';
               STAB12.'FNONL' = XXX5 ;
           'SINON';
               STAB12.'FNONL' = XXX5 + STAB12.'FNONL';
               'DETR' XXX5 ;
           'FINS';
*fba verifier                WTAB.'ITERPREC' =IT;
               STAB12.'DTPREC'= WTAB.'DT_INIT';
**             STAB12.'DTPREC'= STAB12.'DT' ;
*
* On garde la derniere matrice KTAN calculee dans ETIQ si necessaire
'SI' IKTAN ;
  'SI' IFEFP ;
*  'MESS' 'FEFP: Last KTAN is kept for next increment' ;
    STAB12.'LASTKTAN' = ZRIKTA ;
  'SINON' ;
    'SI' (IKT_SAUV 'ET' IKT) ;
*     'MESS' 'KTAN : La matrice est conservee pour le pas suivant' ;
      STAB12.'LASTKTAN' = ZRIKTA ;
    'FINS' ;
  'FINS' ;
'FINS' ;
*
*  quelques destructions supplementaires
*
'SI' IPLAVI ;
      'SI' ('NEG' WTAB.'MOVA' 'RIEN') ;
