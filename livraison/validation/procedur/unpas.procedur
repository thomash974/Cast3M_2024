      STAB12.'TET1'  = STAB12.'TET2'  ;
    'FINS' ;
    'SI' ITHER ;
      STAB12.'TETA1' = STAB12.'TETA2' ;
    'FINS' ;
  'FINS' ;

'SI' (ZICONV 'OU' ('NON' WTAB.'CONVERGENCE_FORCEE')) ;
