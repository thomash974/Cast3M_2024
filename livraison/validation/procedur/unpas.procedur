   STAB12.'ETHER2'    ='REDU' ETT   ZMODLI  ;
   STAB12.'ETHER1'    = STAB12.'ETHER2'       ;
  'SI'  POR1 ;
     STAB12.'MSRTHER2'='REDU' MSRTT ZMODLI;
  'FINS';
'FINS';


