**********************************************************************
* test elementaire de VIBC
* syntaxe : [ A - \lambda I ] . X = 0
* avec A = rigidite elementaire réelle symetrique
**********************************************************************

opti dime 2 elem seg2;
p1 = 0. 0.;
p2 = 1. 0.;
mesh = droi 1 p1 p2;
prA= PROG 1.0000    0.5000    0.3333    0.2500
    0.5000    1.0000    0.6667    0.5000
    0.3333    0.6667    1.0000    0.7500
    0.2500    0.5000    0.7500    1.0000;
moprim = MOTS 'UX' 'UY';
modual = MOTS 'FX' 'FY';
A = MANU 'RIGI' mesh moprim  prA;

tmodA = VIBC A;

* resultats https://www.wolframalpha.com:
* λ_1≈2.53616, v_1≈(0.742622, 1.04602, 1.10333, 1)
* λ_2≈0.848229, v_2≈(-1.73861, -0.402678, 0.645626, 1)
* λ_3≈0.407833, v_3≈(0.881891, -1.47979, -0.0969911, 1)
* λ_4≈0.207775, v_4≈(-0.132821, 0.693238, -1.47418, 1)

* on pourrait comparer, mais on va se contenter de calculer les résidus

prMaxRes1 = PROG;
prMaxYvp  = PROG;

nmod1 = 4;
REPE Bmod1 nmod1;
  xvp = tmodA . 'MODES' . &Bmod1 . 'VALEUR_PROPRE';
  Yvp = tmodA . 'MODES' . &Bmod1 . 'DEFORMEE_MODALE';
*  MESS ' ';
  MESS  '\l_'&Bmod1  ' = ' xvp;  
*  LIST Yvp;
  Res1 = (A * Yvp) - (xvp * (EXCO Yvp moprim modual));
*  LIST Res1;
  prmaxYvp  = prmaxYvp ET (MAXI 'ABS' Yvp);
  prmaxRes1 = prmaxRes1 ET (MAXI 'ABS' Res1);
FIN  Bmod1;


xRes1 = (MAXI prmaxRes1) / (MAXI prmaxYvp);
* rem : on met une tolérance très serrée
xTol1 = 10. * (VALE 'PREC');
MESS xRes1 xTol1;

SI (xRes1 > xTol1); ERRE 5; FINSI;

FIN;
 

