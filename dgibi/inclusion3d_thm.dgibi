* fichier : inclusion3d_thm.dgibi
************************************************************************
* Section : Mecanique Viscoplastique
************************************************************************
*
* test de la formulation du mdele inclusion3d
* ----------------------------------------------------------------------
*
* Alain Sellier, Elsa Anglade, Aurelie Papon,
* Clement Lacombe, Thierry Vidal
* mercredi 4 janvier 2023
*
*-----------------------------------------------------------------------
* Exemple de calcul d un element soumis a sechage suivi d un essai
* de traction
*-----------------------------------------------------------------------
graph1=FAUX;

*maillage d'1/8 de cube (pour avoir les memes conditions limites que dans fluendo3d
OPTI DIME 3 ELEM CUB8;
*
* Repere
*
* Z
* | Y
* |/
* O----X
*
* Points du maillage-----------------------------------------------------------
*
*   8----7
*  /|   /|
* 5----6 |
* | 4--|-3
* |/   |/
* 1----2
*
*Dimensions du cube (HAUTEUR,LARGEUR,PROFONDEUR)
HAUT=1.;
LARG=1.;
PROF=1.;
*
*Nb d'éléments par arrete du cube (HAUTEUR,LARGEUR,PROFONDEUR)
NELH=1;
NELL=1;
NELP=1;
*
*---Creation des points
P1 = POIN 0. 0. 0.;
P2 = POIN LARG 0. 0.;
P3 = POIN LARG PROF 0.;
P4 = POIN 0. PROF 0.;
P5 = POIN 0. 0. HAUT;
P6 = POIN LARG 0. HAUT;
P7 = POIN LARG PROF HAUT;
P8 = POIN 0. PROF HAUT;
*---Creation de la face inferieure du maillage (SINF)
D12=DROI NELL P1 P2;
D23=DROI NELP P2 P3;
D34=DROI NELL P3 P4;
D41=DROI NELP P4 P1;
SINF=DALL d12 d23 d34 d41;
*---Creation du cube par translation
CUB1 = (SINF VOLU NELH TRAN P5);
ELIM (CUB1 ET SINF) 0.0001;
*---Creation et denomination des droites sur Z
D15=DROI NELH P1 P5;
D26=DROI NELH P2 P6;
D37=DROI NELH P3 P7;
D48=DROI NELH P4 P8;
ELIM (CUB1 ET D15 ET D26 ET D37 ET D48) 0.0001;
*---Creation et denomination des droites sur la surface superieure
D56=DROI NELH P5 P6;
D67=DROI NELH P6 P7;
D78=DROI NELH P7 P8;
D85=DROI NELH P8 P5;
*---Denomination des surfaces
SAVA=D12 TRAN NELH P5 ;
SGAU=D41 TRAN NELH P5 ;
SSUP=(SINF PLUS P5) ;
SARR=(SAVA PLUS P4) ;
SDRO=(SGAU PLUS P2) ;
ELIM (CUB1 ET SAVA ET SGAU ET SSUP ET SARR ET SDRO) 0.0001 ;
ELIM (CUB1 ET D56 ET D67 ET D78 ET D85) 0.0001;
*---Affichage du maillage
si (graph1);
 TRAC CUB1 'QUAL' ;
finsi;
*
*
*Paramètres du modèle--------------------------------------------------------
*
*
*--Inclusion
**général
frac1=0.6;
youn1=100000.;
nu1=0.3;
alpi1=5.0e-6;
**retrait
srwi1=1.;
**plasticité
rti1=10.;
rri1=10.;
**réaction chimique
pchi1=0.;
tchi1=2.;
eaci1=46000.;
wsci1=1;
*
*--Matrice
**général
frac0=1-frac1;
youn0=35.;
nu0=0.3;
alpm0=1.0e-6;
**retrait
evol1=evol manu 'EAU' (prog 0. 1.) 'SWP0' (prog 0. 1.);
srwm0=evol1;
porm0=0.48;
mvgm0=0.13;
nvgm0=1.-(1./1.685);
**plasticité
rtm0=0.052;
rrm0=0.052;
**réaction chimique
pchm0=0.;
tchm0=2.;
eacm0=46000.;
wscm0=1;
**fluage
tflm0=0.;
kflm0=0.;
eafm0=17000.;
*
*
*--Matériau homogène
youh0=1./(frac1/youn1+frac0/youn0);
nuh0=0.3;
rho0=2400.;
alph0=1.0e-5;
trf0=20.;
nin0=1.;
*
*Modele et Materiau-----------------------------------------------------
mod1=mode CUB1 mecanique elastique viscoplastique inclusion3d; 
*
*--elasticity, plasticity and damage
math1=MATE mod1 YOUN youh0 NU nuh0 RHO rho0 ALPH alph0 TTRF trf0 
TREF 20. TALP 20. NINC nin0 RT 0. RR 0. DIM3 0.; 
 
*
*--Matrice
*
matm1=MATE mod1 FRA0 frac0  YOU0 youn0  NUP0 nu0 ALP0 alpm0 
  RTI0 rtm0 RTP0 rtm0 RFI0 rtm0 RFP0 rtm0 POR0 porm0 SWP0 srwm0 MVG0 mvgm0 NVG0 nvgm0 
  FLM0 0.  FLK0 0.25 TFL0 0. EAF0 17000. VCH0 0.  ACS0 0. CPH0 (1./4.9)
  SRS0 0.9  TCH0 1. EAC0 46000. COH0 10. DLT0 0.5 BTA0 0.2 KCH0 0.;  

*--Inclusion
mati1=MATE mod1  'FRA1' frac1 'YOU1' youn1 'NUP1' nu1 'ALP1' alpi1  
  'RTI1' rtm0 'RFI1' rtm0 'RTP1' rti1 'RFP1' rti1 'POR1' 0.001 'SWP1' srwi1 'MVG1' 0. 'NVG1' 0.5 'CPH1' 0.
  'FLM1' 1.  'FLK1' 0.1 'TFL1' 0. 'EAF1' 17000. 'VCH1' 0.  'ACS1' 0. 
  'SRS1' 0.9  'TCH1' 1. 'EAC1' 46000. 'COH1' 20. 'DLT1' 0.5 'BTA1' 0.2 KCH1 0.; 
*
*--assemblage
mat1=math1 et matm1 ET mati1 ;
*
*
*
*Conditions aux limites-------------------------------------------------------------------------
*
*--Blocages
cl1=bloq SGAU UX;
cl2=bloq SAVA UY;
cl3=bloq SINF UZ;
*
*--Déplacements égaux sur une surface
SDRO2=SDRO MOIN P7;
SARR2=SARR MOIN P7;
SSUP2=SSUP MOIN P7;
rig1=rela 1. 'UX' SDRO2 - 1. 'UX' P7;
rig2=rela 1. 'UY' SARR2 - 1. 'UY' P7;
rig3=rela 1. 'UZ' SSUP2 - 1. 'UZ' P7;
*
*--assemblage des conditions limites
cl0=cl1 et cl2 et cl3 et rig1 et rig2 et rig3;
*
*
*
*Chargements-----------------------------------------------------------------------------------
*
*--Chargement mécanique
FX1= -0.0001 0. 0.;
FY1= 0. -0.0001 0.;
FZ1= 0. 0. -0.0001;
TFIN=1000.;
* 
FOR1=Forc FX1 SDRO;
FOR2=Forc FY1 SARR;
FOR3=forc FZ1 SSUP;
* 

evolf1=evol manu 'TEMPS' (prog 0. TFIN) 'COEFF' (prog 0. 1.);
evolf2=evol manu 'TEMPS' (prog 0. TFIN) 'COEFF' (prog 0. 1.);
char1=char 'MECA' FOR1 evolf1;
char2=char 'MECA' FOR2 evolf2;
char3=char 'MECA' FOR3 evolf2;
si (graph1) ;
 dess evolf1 titr 'chargement mecanique';
finsi ;
*
*vec1=(vect FOR1 1. 'FORC') coul roug;
*vec2=(vect FOR2 1. 'FORC') coul bleu;
*vec3=(vect FOR3 1. 'FORC') coul vert;
*trac (vec1 et vec2  et vec3) (CUB1);
*
charm1=char1 et char2 et char3;
*
*
*--Chargement thermique
temp1=manu chpo CUB1 'T' 1.;
ltth1=prog 0. TFIN;
ltemp1=prog 20. 20.;
evolth1=evol manu 'TEMPS' ltth1 'COEFF' ltemp1 coul roug;
si (graph1) ;
 dess evolth1 titr 'CHARGEMENT THERMIQUE';
finsi ;
chart1=char 'T' temp1 evolth1;
*
*
*-- Chargement hydrique
eau1=manu chpo CUB1 'EAU' 1.;
*evolution  en fonction du temps 
liste1=prog 0.   pas 0.5   TFIN;
liste11=prog 0.  pas 0.5   TFIN;
liste2=(liste11/180.)**5.;
liste5=(liste11/160.)**2.;
liste3=0.02+(0.98/(liste11/190.+liste2+liste5+ 1.));
evole4=evol manu 'temps' liste1 'COEFF' liste3;
si (graph1);
 dess evole4 titr 'sechage';
finsi;
*Chargement hydrique sans retrait 
*evolution  en fonction du temps 
* liste1=prog 0.   pas 0.5 TFIN;
* liste2=(liste1/180.)**5.;
* liste5=(liste1/160.)**2.;
* liste3=0.88+(0.12/(liste1/190.+liste2+liste5+ 1.));
*evole4=evol manu 'temps' liste1 'COEFF' liste3;

*dess evole4 titr 'Evolution SRW matrice';
charr1=char 'EAU' eau1 evole4;
*
*
*
*Définitions pour le calcul pas a pas du chargement initial--------------------------------
tab1=table;
*opti sauv 'cas_test_inclusion3d.sauv';
*sauv CUB1;
*sauv mod1;
*sauv p7;
ltc1=prog 0.  pas  1. 10. pas 5. 100. pas 10. 700. ;
tab1.temps_calcules=ltc1;
tab1.caracteristiques=mat1;
tab1.modele=mod1;
tab1.blocages_mecaniques=cl0;
tab1.chargement=charm1 et chart1 et charr1;
tab1.precision=1.0e-5;
tab1.temps_sauves=ltc1;
*tab1.temps_sauvegardes=ltc1;
pasapas tab1;
*


*essai de traction 
n1=dime tab1.temps;
n1=n1-1;
udroi=extr  tab1.deplacements.n1 'UX' p2;
cl14=bloq SDRO UX;
cl0=cl1 et cl2 et cl3 et  rig2 et rig3 et cl14;
depi4=DEPI cl14 1.;
evol4=evol manu 'TEMPS' (prog 0. 700.  TFIN) 
                'COEFF' (prog 0. udroi 0.1);
*dess evol4;
char1=char 'MECA' depi4 evol4;
charm1=char1 et char2 et char3;

tab1.chargement=charm1 et chart1 et charr1;
tab1.blocages_mecaniques=cl0;
ltc1=prog 700.05  pas 0.05  730.  ;
* ltc1=prog 705. pas 5.  TFIN  ;
tab1.temps_calcules=ltc1;
tab1.temps_sauves=ltc1;
*tab1.temps_sauvegardes=ltc1;
pasapas tab1;

************************************************************************
************************************************************************
*   exploitation des resultats
************************************************************************
************************************************************************

n1=dime (tab1.temps);
i1=0;
dp5=prog;
e1s=prog;
e2s=prog;
e2d1=prog;
e1d1=prog;
lt5=prog;
epx1=prog;
epy1=prog;
epz1=prog;
six1=prog;
siy1=prog;
siz1=prog;
eel00=prog;
eelt0=prog;
youn0=youn1;
repeter bloc0 n1;
 z5=extr tab1.deplacements.i1 'UX' p3;
 vari1=tab1.variables_internes.i1;
 depi1=tab1.deplacements.i1;
 epsi1=epsi depi1 mod1;
 sig1=tab1.contraintes.i1;
 epxx1=extr ( exco epsi1 'EPXX') 'EPXX' 1 1 1;
* dc1=extr (exco dc tab1.variables_internes.i1) dc 1 1 1 ;
 dc1=0.;
 youn1=youn0*(1.-dc1);
 sxx1=extr ( exco sig1 'SMXX') 'SMXX' 1 1 1;
 epyy1=extr(exco epsi1 'EPYY') 'EPYY' 1 1 1;
 syy1=extr ( exco sig1 'SMYY') 'SMYY' 1 1 1;
 epzz1=extr(exco epsi1 'EPZZ') 'EPZZ' 1 1 1;
 szz1=extr ( exco sig1 'SMZZ') 'SMZZ' 1 1 1;
 epxe1=0.;
 epye1=0.;
 epze1=0.;
 dp5=dp5 et (prog z5);
 epx1=epx1 et (prog (epxx1-epxe1));
 six1=six1 et (prog sxx1);
 epy1=epy1 et (prog (epyy1-epye1));
 siy1=siy1 et (prog syy1);
 epz1=epz1 et (prog (epzz1-epze1));
 siz1=siz1 et (prog szz1);
 lt5=lt5 et (prog (tab1.temps.i1));
 i1=i1+1;
fin bloc0;

edp5=evol manu 'TEMPS' lt5 'DP5' dp5;
*points de controle
n1=90; fref1= -7.95742E-03;
n2=684; fref2= 2.73214E-03;
LISTF1='EXTR' edp5 'ORDO';
fcal1='EXTR' LISTF1 (n1);
fcal2='EXTR' LISTF1 (n2);
err1 = abs ((fref1 - fcal1)/fref1) ; 
err2 = abs ((fref2 - fcal2)/fref2) ;
si ((err1 < 1.e-3) et (err2 < 1.e-3)) ;
    erre 0 ;
sinon ;
    erre 5 ;
finsi ;


si (graph1);
dess edp5 titr 'retrait suivi de la traction';
epx1=epx1;
eepx1=(evol manu 'TEMPS' lt5 'EPXX' epx1) coul roug;
esix1=evol manu 'TEMPS' lt5 'SMXX' six1;
esiepx=evol manu 'EPXX' epx1 'SMXX' six1;
*dess esiepx;
eepx1=eepx1 coul roug;
epy1=epy1;
eepy1=evol manu 'TEMPS' lt5 'EPYY' epy1;
esiy1=evol manu 'TEMPS' lt5 'SMYY' siy1;
eepy1=eepy1 coul vert;
epz1=epz1;
eepz1=evol manu 'TEMPS' lt5 'EPZZ' epz1;
esiz1=evol manu 'TEMPS' lt5 'SMZZ' siz1;

tab2=table;
tab2.1 = 'MARQ CROI ' ;
tab2.'TITRE' = 'TABLE' ;
tab2.'TITRE'. 1 = MOT 'Dep P5' ;
dess (eepx1 ) lege tab2;
tab2.'TITRE'. 1 = MOT 'SMXX' ;
dess (esix1 ) lege tab2;
*opti donn 5;

*points experimentaux
lt6= prog 0. 1. 4. 10. 20. 28. 29. 30. 34. 40. 50.;
exx0=prog 0. 50. 130. 200. 250. 280. 220. 205. 200.
 200. 200.;
exx0=-1.*exx0;
evx0=evol manu 'TEMPS' lt6 'EPXX exp' exx0;
evx0=evx0 coul roug;
tab3=table;
tab3.1 = 'MARQ CROI NOLI' ;
tab3.'TITRE' = 'TABLE' ;
tab3.'TITRE'. 1 = MOT 'fluageXX exp' ;
tab3.'TITRE'. 2 = MOT 'EPXX th' ;
tab3.'TITRE'. 3 = MOT 'EPYY th' ;
tab3.'TITRE'. 4=  MOT 'EPZZ th' ;
tab3.'TITRE'. 5=  MOT 'SIXX th' ;
tab3.'TITRE'. 6=  MOT 'SIYY th' ;
tab3.'TITRE'. 7=  MOT 'SIZZ th' ;
*dess (evx0 et eepx1 
*et eepy1 et eepz1 et esix1 et esiy1 et esiz1) lege tab3;
*opti donn 5;

*OPTI 'SORT' 'gopala_inclusion_uniax.xls' ;
*SORT 'EXCE' eepx1 evx0 eepy1 eepz1;
*OPTI 'SORT' 'EPXX_60S' ;
*SORT 'EXCE' eepx1  'SEPA' 'VIRG';

*opti sort 'gopola_uniax_epxx_expe.res';
*evolepx=evol manu lt6 exx0;
*sort 'EXCE' evolepx ;
**'SEPA' 'ESPA';



************************************************************************
*hydrique

*trace d un sclaire
n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 2;
 lt1=prog;
 ls1=prog;
 nom1=chain 'EPH' (&bou2-1);
 repe bou1 n1;
   vari1=tab1.variables_internes.(&bou1-1);
   temp1=tab1.temps.(&bou1-1);
   ds1=extr (exco vari1 nom1) nom1 1 1 1;
   lt1=lt1 et (prog temp1);
  ls1=ls1 et (prog ds1);
 fin bou1;
 ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
 tab2.'TITRE'. &bou2 = nom1 ;
fin bou2;
tab2.1 = 'MARQ CROI ' ;
tab2.2 = 'MARQ PLUS ' ;
tab2.3 = 'MARQ ETOI ' ;
dess ( ecc1.1 et ecc1.2  ) lege tab2;



* opti donn 5;
*trace d un sclaire
n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 2;
  lt1=prog;
  ls1=prog;
  nom1=chain 'SEW' (&bou2-1);
  repe bou1 n1;
    vari1=tab1.variables_internes.(&bou1-1);
    temp1=tab1.temps.(&bou1-1);
    ds1=extr (exco vari1 nom1) nom1 1 1 1;
    lt1=lt1 et (prog temp1);
    ls1=ls1 et (prog ds1);
  fin bou1;
  ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
  tab2.'TITRE'. &bou2 = nom1 ;
fin bou2;
tab2.1 = 'MARQ CROI ' ;
tab2.2 = 'MARQ PLUS ' ;
tab2.3 = 'MARQ ETOI ' ;
dess ( ecc1.1 et ecc1.2  ) lege tab2;


************************************************************************
*contraintes dans les phases
************************************************************************

n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 6;
  lt1=prog;
  ls1=prog;
  nom1=chain 'RS0' (&bou2);
  repe bou1 n1;
    vari1=tab1.variables_internes.(&bou1-1);
    temp1=tab1.temps.(&bou1-1);
    ds1=extr (exco vari1 nom1) nom1 1 1 1;
    lt1=lt1 et (prog temp1);
    ls1=ls1 et (prog ds1);
  fin bou1;
  ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
  tab2.'TITRE'. &bou2 = nom1 ;
fin bou2;
tab2.1 = 'MARQ CROI ' ;
tab2.2 = 'MARQ PLUS ' ;
tab2.3 = 'MARQ ETOI ' ;
tab2.4 = 'MARQ CARR ' ;
tab2.5 = 'MARQ LOSA ' ;
tab2.6 = 'MARQ ETOI NOLI' ;
tab2.7 = 'MARQ CARR NOLI' ;
dess ( ecc1.1 et ecc1.2 et ecc1.3 et ecc1.4 
 et ecc1.5 et ecc1.6 ) lege tab2;
 


n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 6;
  lt1=prog;
  ls1=prog;
  nom1=chain 'RS1' (&bou2);
  repe bou1 n1;
    vari1=tab1.variables_internes.(&bou1-1);
    temp1=tab1.temps.(&bou1-1);
    ds1=extr (exco vari1 nom1) nom1 1 1 1;
    lt1=lt1 et (prog temp1);
    ls1=ls1 et (prog ds1);
  fin bou1;
  ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
  tab2.'TITRE'. &bou2 = nom1 ;
fin bou2;
tab2.1 = 'MARQ CROI ' ;
tab2.2 = 'MARQ PLUS ' ;
tab2.3 = 'MARQ ETOI ' ;
tab2.4 = 'MARQ CARR ' ;
tab2.5 = 'MARQ LOSA ' ;
tab2.6 = 'MARQ ETOI NOLI' ;
tab2.7 = 'MARQ CARR NOLI' ;
dess ( ecc1.1 et ecc1.2 et ecc1.3 et ecc1.4 
 et ecc1.5 et ecc1.6  ) lege tab2;
 
n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 6;
  lt1=prog;
  ls1=prog;
  nom1=chain 'IS1' (&bou2);
  repe bou1 n1;
    vari1=tab1.variables_internes.(&bou1-1);
    temp1=tab1.temps.(&bou1-1);
    ds1=extr (exco vari1 nom1) nom1 1 1 1;
    lt1=lt1 et (prog temp1);
    ls1=ls1 et (prog ds1);
  fin bou1;
  ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
  tab2.'TITRE'. &bou2 = nom1 ;
fin bou2;
tab2.1 = 'MARQ CROI ' ;
tab2.2 = 'MARQ PLUS ' ;
tab2.3 = 'MARQ ETOI ' ;
tab2.4 = 'MARQ CARR ' ;
tab2.5 = 'MARQ LOSA ' ;
tab2.6 = 'MARQ ETOI NOLI' ;
tab2.7 = 'MARQ CARR NOLI' ;
dess ( ecc1.1 et ecc1.2 et ecc1.3 et ecc1.4 
 et ecc1.5 et ecc1.6  ) lege tab2;
  
n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 6;
  lt1=prog;
  ls1=prog;
  nom1=chain 'OS1' (&bou2);
  repe bou1 n1;
    vari1=tab1.variables_internes.(&bou1-1);
    temp1=tab1.temps.(&bou1-1);
    ds1=extr (exco vari1 nom1) nom1 1 1 1;
    lt1=lt1 et (prog temp1);
    ls1=ls1 et (prog ds1);
  fin bou1;
  ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
  tab2.'TITRE'. &bou2 = nom1 ;
fin bou2;
tab2.1 = 'MARQ CROI ' ;
tab2.2 = 'MARQ PLUS ' ;
tab2.3 = 'MARQ ETOI ' ;
tab2.4 = 'MARQ CARR ' ;
tab2.5 = 'MARQ LOSA ' ;
tab2.6 = 'MARQ ETOI NOLI' ;
tab2.7 = 'MARQ CARR NOLI' ;
dess ( ecc1.1 et ecc1.2 et ecc1.3 et ecc1.4 
 et ecc1.5 et ecc1.6 ) lege tab2;

************************************************************************
* deformations elastiques dans les phases
************************************************************************

n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 6;
  lt1=prog;
  ls1=prog;
  nom1=chain 'RE0' (&bou2);
  repe bou1 n1;
    vari1=tab1.variables_internes.(&bou1-1);
    temp1=tab1.temps.(&bou1-1);
    ds1=extr (exco vari1 nom1) nom1 1 1 1;
    lt1=lt1 et (prog temp1);
    ls1=ls1 et (prog ds1);
  fin bou1;
  ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
  tab2.'TITRE'. &bou2 = nom1 ;
fin bou2;
tab2.1 = 'MARQ CROI ' ;
tab2.2 = 'MARQ PLUS ' ;
tab2.3 = 'MARQ ETOI ' ;
tab2.4 = 'MARQ CARR ' ;
tab2.5 = 'MARQ LOSA ' ;
tab2.6 = 'MARQ ETOI NOLI' ;
tab2.7 = 'MARQ CARR NOLI' ;
dess ( ecc1.1 et ecc1.2 et ecc1.3 et ecc1.4 
 et ecc1.5 et ecc1.6 ) lege tab2; 
 

 
 n1=dime tab1.temps;
ecc1=table;
tab2=table;
tab2.'TITRE'=table;
repe bou2 6;
  lt1=prog;
  ls1=prog;
  nom1=chain 'RE1' (&bou2);
  repe bou1 n1;
    vari1=tab1.variables_internes.(&bou1-1);
    temp1=tab1.temps.(&bou1-1);
    ds1=extr (exco vari1 nom1) nom1 1 1 1;
    lt1=lt1 et (prog temp1);
    ls1=ls1 et (prog ds1);
  fin bou1;
  ecc1.&bou2=(evol manu 'temps' lt1 nom1 ls1);
  tab2.'TITRE'. &bou2 = nom1 ;
