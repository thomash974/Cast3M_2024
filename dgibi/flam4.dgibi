* fichier : flam4.dgibi
*
************************************************************************
*
* Flambage d'une plaque carree sous deformation de cisaillement
*
*    Y ^
*      |              
*      |              
*    p2+----------------+ ^ F
*     >|                | |
*      |                |
*     >|                | ^ F
*      |                | | 
*     >|                |
*      |                | ^ F
*     >|                | |
*    p1+----------------+--------> X
*     
*
* introduit dans la base des cas-tests en mai 2019
*
* la matrice Ksigma n'est pas definie>0
* VIBR doit en tenir compte pour la numerotation des modes
* on teste la charge critique >0 ou <0 et le numero de mode
* 
************************************************************************

************************************************************************
* OPTIONS 
************************************************************************

opti dime 3 elem qua4 ;
* GRAPH = VRAI; opti TRAC PSC;
GRAPH = FAUX;


************************************************************************
* MAILLAGE
************************************************************************

p1 = 0 0 0 ; 
p2 = 0 1 0;
l1 = p1 DROI 10 p2 ;
sur1 = tran l1 (1 0 0) 10 ;
l1 = coul l1 ROUG ;
l2 = (cote 2 sur1) coul VERT;
l3 = (cote 3 sur1) coul BLEU;
l4 = (cote 4 sur1) coul JAUN;
SI GRAPH; 
  trac (sur1 et l1 et l2 et l3 et l4); 
FINSI;


************************************************************************
* MODELE, MATERIAU, BLOCAGES, CHARGEMENT
************************************************************************

mod1 = mode sur1 mecanique coq4;
*sur1 = chan sur1 tri3 ; mod1 = mode sur1 mecanique dst;
mat1 = mate mod1 youn 2.E11 nu 0. epai .1 rho 1000.;

blo1 = bloq l1 ux uy uz rx ry ;
blo2 = bloq l3 ux uz rx ry ; 

* force selon Y
f1 = force l3 (0 1 0) ;


************************************************************************
* MISE EN PRECONTRAINTE ELASTIQUE
************************************************************************

rig1 = rigi mod1 mat1 ;
rigt = rig1 et blo1 et blo2 ;

dep1 = reso rigt f1 ;
def1 = defo dep1 (sur1 et l1) ;
SI GRAPH;  trac def1 ; FINSI;

sig1 = sigm mod1 mat1 dep1 ;
ksig1 = ksig sig1 mod1 mat1 'FLAM' ;
ksig11 = -1. * ksig1;

nvpneg1 = DIAG ksig11;
mess '>>> Ksigma n est pas definie positive ('nvpneg1' v.p. <0)' ;
mess '>>> dimension =' (dime ksig11) (dime rigt);


************************************************************************
* CALCUL DE FLAMBAGE (avec 3 algorithmes differents)
************************************************************************

SI GRAPH; 
  mopost = MOTS 'TABL' 'DEFO' 'DEF0'; 
SINON;
  mopost = MOTS 'TABL'; 
FINSI;
nmod = 8;

TITR 'VIBR IRAM';
tab2_iram =vibr iram 0. nmod rigt ksig11;
POSTVIBR tab2_iram mopost;

TITR 'VIBR SIMUL';
tab2_simu =vibr simu 0. nmod rigt ksig11;
POSTVIBR tab2_simu mopost;

TITR 'VIBR PROCH';
tab2_proc =vibr proc (prog 0.) (lect nmod) rigt ksig11;
POSTVIBR tab2_proc mopost;


************************************************************************
* TEST DE NON REGRESSION
************************************************************************
* pour les 3 algos de VIBR
* on teste 2 numeros de mode et 2 frequences propres

* on rassemble les resultats dans 1 seule table pour automatiser 
TALGO = TABL;
TALGO . 1 = tab2_iram . 'MODES';
TALGO . 2 = tab2_simu . 'MODES';
TALGO . 3 = tab2_proc . 'MODES';

* listes pour les modes  4 et 5
pr_num4 = lect;
pr_frq4 = prog;
pr_num5 = lect;
pr_frq5 = prog;

* on devrait etre parfaitement symetrique du fait du pb en cisaillement
repe BALGO 3;
  pr_num4 = pr_num4 et TALGO . &BALGO . 4 . 'NUMERO_MODE';
  pr_frq4 = pr_frq4 et TALGO . &BALGO . 4 . 'FREQUENCE';
  pr_num5 = pr_num5 et TALGO . &BALGO . 5 . 'NUMERO_MODE';
  pr_frq5 = pr_frq5 et TALGO . &BALGO . 5 . 'FREQUENCE';
fin  BALGO;

mess '>>>'; LIST pr_num4;
* attendu sur linux64:    183   183   183
mess '>>>';  LIST pr_frq4;
* attendu:     -5232.8      -5232.8      -5232.8    
mess '>>>';  LIST pr_num5;
* attendu sur linux64:      184   184   184
mess '>>>';  LIST pr_frq5;
* attendu:      5232.8       5232.8       5232.8    

NBERR = 0;

*pb dec20: on desactive la qualif du no de mode
*SI ((MAXI pr_num4) NEG nvpneg1); NBERR = NBERR + 1; FINSI;
*SI ((MINI pr_num4) NEG nvpneg1); NBERR = NBERR + 1; FINSI;
*SI ((MAXI pr_num5) NEG (nvpneg1 + 1)); NBERR = NBERR + 1; FINSI;
*SI ((MINI pr_num5) NEG (nvpneg1 + 1)); NBERR = NBERR + 1; FINSI;

err4 = MAXI 'ABS' ((pr_frq4 + 5232.8) / 5232.8);
err5 = MAXI 'ABS' ((pr_frq5 - 5232.8) / 5232.8);
SI (err4 > 1.E-5); NBERR = NBERR + 1; FINSI;
SI (err5 > 1.E-5); NBERR = NBERR + 1; FINSI;

* erreur ou pas
  MESS '>>> Il y a ' NBERR ' erreur(s)';
SI (NBERR >EG 1); 
  ERRE 5;
FINSI;


FIN ;
 

 

 

 

