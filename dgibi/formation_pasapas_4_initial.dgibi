* fichier : formation_pasapas_4_initial.dgibi
************************************************************************
*              FORMATION AVANCEE SUR LA PROCEDURE PASAPAS              *
*                                                                      *
* Variation d'un jeu sous l'action d'une sollicitation thermique en    *
* regime transitoire                                                   *
*                                                                      *
* Ce fichier constitue la mise donnee initiale du probleme et realise  *
* - le maillage                                                        *
* - la definition du modele et des parametres materiaux                *
* - la definition du chargement                                        *
* - la resolution avec PASAPAS                                         *
* - le post traitement                                                 *
************************************************************************


** Options generales
OPTI 'DIME' 2 'ELEM' 'QUA4' 'MODE' 'PLAN' 'DEFO' 'ECHO' 0 ;
ITRAC = FAUX ;


** Parametres geometriques, materiaux et CL
L       = 1. ;
EPAI    = 0.1 ;
JEU_INI = 0.01*L ;
T_INI   = 20. ;
T1      = 500. ;
T4      = 20. ;
TEMPS_F = 5.E5 ;
XPAS    = 5.E3 ;


** Maillage
P1 = 0. 0. ;
P2 = L 0. ;
L0 = DROI 10 P1 P2 ;
S1 = L0 TRAN 1 (0. EPAI) ;
L1 = S1 COTE 4 ;
L2 = S1 COTE 2 ;
S2 = S1 PLUS ((L + JEU_INI) 0.) ;
L3 = S2 COTE 4 ;
L4 = S2 COTE 2 ;
P3 = S2 POIN 'PROC' ((L + JEU_INI) 0.) ;
P4 = S2 POIN 'PROC' (((2. * L) + JEU_INI) 0.) ;
MAILT  = S1 ET S2 ;
SI ITRAC ;
  TRAC MAILT 'TITR' 'Maillage' ;
FINSI ;


** Modeles et materiaux
MODM1 = MODE S1    'MECANIQUE' 'ELASTIQUE' 'ISOTROPE' ;
MATM1 = MATE MODM1 'ALPHA' 12.E-6 'TALP' 0. 'TREF' 20. 'YOUN' 200.E9 'NU' 0.3 ;
MODM2 = MODE S2    'MECANIQUE' 'ELASTIQUE' 'ISOTROPE' ;
MATM2 = MATE MODM2 'ALPHA' 12.E-6 'TALP' 0. 'TREF' 20. 'YOUN' 200.E9 'NU' 0.3 ;
MODT1 = MODE S1    'THERMIQUE' 'ISOTROPE' ;
MATT1 = MATE MODT1 'K' 60. 'C' 800. 'RHO' 7800. 'TINI' T_INI ;
MODT2 = MODE S2    'THERMIQUE' 'ISOTROPE' ;
MATT2 = MATE MODT2 'K' 80. 'C' 100. 'RHO' 7800. 'TINI' T_INI ;
MOD_TH = MODT1 ET MODT2 ;
MAT_TH = MATT1 ET MATT2 ;
MOD_ME = MODM1 ET MODM2 ;
MAT_ME = MATM1 ET MATM2 ;


** Blocages mecaniques
CL1   = BLOQ 'UY' MAILT ;
CL2   = BLOQ 'UX' L1 ;
CL3   = BLOQ 'UX' L4 ;
RE1   = RELA 'MAXI' 'UX' L2 - 'UX' L3 ;
CL_ME = CL1 ET CL2 ET CL3 ET RE1 ;


** Blocages thermiques
CL4   = BLOQ 'T' L1 ;
CL5   = BLOQ 'T' L4 ;
CL_TH = CL4 ET CL5 ;


** Chargements mecaniques et thermiques
EV1  = EVOL 'MANU' (PROG 0. TEMPS_F) (PROG 1. 1.) ;
F1   = DEPI RE1 JEU_INI ;
CHA1 = CHAR 'DIMP' F1 EV1 ;
TEM1 = DEPI CL4 T1 ;
TEM2 = DEPI CL5 T4 ;
CHA2 = CHAR 'TIMP' (TEM1 ET TEM2) EV1 ;


** Resolution avec PASAPAS
TAB1                         = TABL ;
TAB1 . 'MODELE'              = MOD_ME ET MOD_TH ;
TAB1 . 'CARACTERISTIQUES'    = MAT_ME ET MAT_TH ;
TAB1 . 'BLOCAGES_MECANIQUES' = CL_ME ;
TAB1 . 'BLOCAGES_THERMIQUES' = CL_TH ;
TAB1 . 'CHARGEMENT'          = CHA1 ET CHA2 ;
TAB1 . 'TEMPS_CALCULES'      = PROG XPAS 'PAS' XPAS TEMPS_F ;
PASAPAS TAB1 ;


** Post-traitement
LTPS = PROG ;
LJEU = PROG ;
LT2  = PROG ;
LT3  = PROG ;
NB1  = DIME (TAB1 . 'TEMPS') ;
MESS '  Temps          Jeu              T2              T3' ;
* listage du jeu et des temperatures a chaque pas de temps
CONF0 = FORM ;
REPE B1 NB1 ;
  TPS1 = TAB1 . 'TEMPS' . (&B1 - 1) ;
  LTPS = LTPS ET TPS1 ;
  TE1 = TAB1 . 'TEMPERATURES' . (&B1 - 1) ;
  U1 = TAB1 . 'DEPLACEMENTS' . (&B1 - 1) ;
  CONF1 = FORM U1 ;
  J1 = NORM (P3 MOIN P2) ;
  T2 = EXTR TE1 'T' P2 ;
  T3 = EXTR TE1 'T' P3 ;
  MESS TPS1 J1 T2 T3 ;
  LJEU = LJEU ET J1 ;
  LT2 = LT2 ET T2 ;
  LT3 = LT3 ET T3 ;
  SI ITRAC ;
    TRAC TE1 MAILT (PROG T4 PAS ((T1 - T4) / 20.) T1) 'TITR' (CHAI 'Temperature au temps' TPS1) ;
  FINSI ;
  FORM CONF0 ;
FIN B1 ;
* jeu P2 <--> P3 VS temps
JEUVST = EVOL 'ROUG' 'MANU' 'Temps' LTPS 'Jeu' LJEU ;
* temperatures en P2 et P3 VS temps
T2VST = EVOL 'ROUG' 'MANU' 'Temps' LTPS 'Temperature' LT2 ;
T3VST = EVOL 'BLEU' 'MANU' 'Temps' LTPS 'Temperature' LT3 ;
TLEG               = TABL ;
TLEG . 'TITRE'     = TABL ;
TLEG . 'TITRE' . 1 = 'Point P2';
TLEG . 'TITRE' . 2 = 'Point P3' ;
SI ITRAC ;
  DESS JEUVST 'TITR' 'Jeu VS temps' ;
  DESS (T2VST ET T3VST) 'TITR' 'Temperature VS temps' 'LEGE' TLEG ;
FINSI ;

FIN ;

 

 

