$$$$ POINTSPH
* POINTSPH  PROCEDUR  FD218221  20/06/17    21:15:09     10629          
*
*     DEFINITION D'UN POINT (OU D'UN MAILLAGE DE POINTS)
*               PAR SES COORDONNEES SPHERIQUES
*
'DEBPROC' POINTSPH ;

* Gestion des 2 syntaxes (avec des FLOTTANTs ou des LISTREELs)
'ARGU' LONG/'LISTREEL' ;
'SI' ('EGA' ('TYPE' LONG) 'ANNULE') ;
  'ARGU' LONG*'FLOTTANT' TETA*'FLOTTANT' PHI*'FLOTTANT' ;
'SINON' ;
  'ARGU' TETA*'LISTREEL' PHI*'LISTREEL' ;
'FINSI' ;
*
* Caclul des coordonnees cartesiennes
COS_PHI = LONG * ('COS' PHI) ;
X = COS_PHI * ('COS' TETA) ;
Y = COS_PHI * ('SIN' TETA) ;
Z = LONG * ('SIN' PHI) ;
*
* Creation du (des) point(s)
PT = 'POIN' X Y Z ;
*
'FINPROC' PT ;
