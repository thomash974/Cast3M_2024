$$$$ ORDOVIBC
* ORDOVIBC  PROCEDUR  BP208322  21/09/06    21:15:06     11096          
*
* ======================== DEBUT DOCUMENTATION ========================
* .. _procedur_ordovibc:
* 
* ordovibc
* --------
* 
* **Description**
* 
* Crée des listreels des frequences réelles {wr} et imaginaires {wi} 
* d'une base modale complexe TbasC2 obtenue avec VIBC 
* et ordonne les modes complexes :
* 
* - selon {wr} croissant si TbasC1 n'est pas fourni
* - selon l'ordre des modes de TbasC1 de manière à minimiser
*   les produits scalaires complexes <\psi1,\psi2> + <w1,w2>
*
* **Appel**
* 
* .. code-block:: none
* 
*   ORDOVIBC TbasC2 (TbasC1);

* **Arguments**
* 
* Détail des indices de sortie de la table TbasC2 : ::
*
*   TbasC2
*   . 'MODES' = table des modes |non ordonnée (E)
*                               |ordonnée     (S)
*   . 'LISTE_FREQUENCES_REELLES'     = listreel des {wR} ordonnées (S)
*   . 'LISTE_FREQUENCES_IMAGINAIRES' = listreel des {wI} ordonnées (S)
*
* **Auteur**
*
* Benoit Prabel, 2021
*
************************************************************************


DEBP ORDOVIBC TbasC2*'TABLE' TbasC1/'TABLE';


************************************************************************
* RECUPERATION DES INPUT
************************************************************************

* BASE A ORDONNER
* ---------------
  TmodC2 = TbasC2 . 'MODES';
  NmodC2 = DIME TmodC2;
* Extraction des frequences
  prfR2 = PROG ;
  prfI2 = PROG ;
  REPE BmodC2 NmodC2 ;
    SI (NON (EXIS TmodC2 &BmodC2)); 
      NmodC2 = &BmodC2 - 1;
      TbasC2 . 'NOMBRE_MODES' = NmodC2;
      QUIT BmodC2;
    FINSI;
    prfR2 = prfR2 ET (TmodC2 . &BmodC2 .'FREQUENCE_REELLE') ;
    prfI2 = prfI2 ET (TmodC2 . &BmodC2 .'FREQUENCE_IMAGINAIRE') ;
  FIN BmodC2 ;
* liste  
  numodC2 = LECT 1 'PAS' 1 NmodC2;
  
* BASE DE REFERENCE (OPTIONNELLE)  
* -----------------
  IF_C1  = EXIS TbasC1;
  SI (IF_C1);
    TmodC1  = TbasC1 . 'MODES'; 
    NmodC1 = TbasC1 . 'NOMBRE_MODES';
    prfR1   = TbasC1 . 'LISTE_FREQUENCES_REELLES'    ;
    prfI1   = TbasC1 . 'LISTE_FREQUENCES_IMAGINAIRES';
    SI (NmodC1 NEG NmodC2); ERRE 'Nombre de modes incorrects'; FINSI;
    mocomp = MOTS 'ALFA';
  FINSI;

  
************************************************************************
* TRI
************************************************************************

* TRI SELON wR CROISSANT 
* ----------------------
SI (NON IF_C1);

  prfR2 prfI2 numodC2 = ORDO prfR2 prfI2 numodC2;
  
  
* TRI SELON TbasC1
* ----------------
SINON;

    prCout = prog;
*   boucle sur les modes du pas precedent --------------------
    REPE B1 NmodC1; 
       DEFR1 = TmodC1 . &B1 . 'DEFORMEE_MODALE_REELLE';
       DEFI1 = TmodC1 . &B1 . 'DEFORMEE_MODALE_IMAGINAIRE';
       frqR1 = TmodC1 . &B1 . 'FREQUENCE_REELLE';
       frqI1 = TmodC1 . &B1 . 'FREQUENCE_IMAGINAIRE';
*      boucle sur les modes du pas actuel ----------------    
       REPE B2 NmodC2; 
         DEFR2 = TmodC2 . &B2 . 'DEFORMEE_MODALE_REELLE';
         DEFI2 = TmodC2 . &B2 . 'DEFORMEE_MODALE_IMAGINAIRE';
         frqR2 = TmodC2 . &B2 . 'FREQUENCE_REELLE';
         frqI2 = TmodC2 . &B2 . 'FREQUENCE_IMAGINAIRE';
*        ecart en frequence^2
         dfrq12 = ((frqR2 - frqR1)**2) + ((frqI2 - frqI1)**2);
         ref12  =  ((frqR2**2) + (frqI2**2)) + ((frqR1**2) + (frqI1**2));
*        produit scalaire des vecteurs propres
         cos12 = (XTY DEFR2 DEFR1 mocomp mocomp)
               + (XTY DEFI2 DEFI1 mocomp mocomp); 
         sin12 = (XTY DEFI2 DEFR1 mocomp mocomp)
               - (XTY DEFR2 DEFI1 mocomp mocomp); 
         modul12 = (cos12**2) + (sin12**2);
         xCout12 = (abs (1. - modul12)) + (0.5*dfrq12 / ref12);
         prCout  = prCout et xCout12;
       FIN  B2;
*      fin de boucle sur les modes du pas actuel ---------
    FIN  B1;
*   fin de boucle sur les modes du pas precedent -------------   

*   recherche dela permutation qui minimise le cout (cad les distances)
    xCoutTot numodC2 prfR2 prfI2
    = ORDO numodC2 prfR2 prfI2 'COUT' prCout ;


FINSI;


************************************************************************
* ECRITURE DES RESULTATS
************************************************************************

* PERMUTATION
* -----------
  TmodC2o = COPI TmodC2;
  REPE BmodC2 NmodC2 ;
    TmodC2o . &BmodC2 = TmodC2 . (EXTR numodC2 &BmodC2);
  FIN BmodC2 ;
  
* STOCKAGE
* --------
  TbasC2 . 'MODES'                        = TmodC2o;
  TbasC2 . 'LISTE_FREQUENCES_REELLES'     = prfR2  ;
  TbasC2 . 'LISTE_FREQUENCES_IMAGINAIRES' = prfI2  ;
  

FINP;


 
