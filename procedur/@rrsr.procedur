$$$$ @RRSR
* @RRSR     PROCEDUR  CB215821  19/11/18    21:15:00     10383          
*----------------------------------------------------------------------
*      CETTE METHODE A ETE MISE GRACIEUSEMENT
*      A DISPOSITION DE  LA COMMUNAUTE CAST3M
*      PAR TAMASKOVICS N.
*     (Freiberg Institut für Geotechnik )
*----------------------------------------------------------------------
'DEBM'  @RRSR  V*'FLOTTANT'  N*'ENTIER'  DBG/'ENTIER' ;
*----------------------------------------------------------------------
* La methode @RRSR fait parti de l'objet @RSTH et est appelee avec
*    l'abbreviation %'RSR'.
*----------------------------------------------------------------------
 'SI' ('EXIS' DBG ) ;
  !DBG = DBG ;
 'SINO' ;
  !DBG = 0 ;
 'FINS' ;
*
 'SI' ( (N '>EG' 1) 'ET' (N '<EG' %'CX') ) ;
*
  !VN ='EXTR'  %'MIN'  %'SN' ;
  !VX ='EXTR'  %'MAX'  %'SN' ;
  'SI'( ((!VN 'EGA' 0.0) 'ET' (!VX 'EGA' 0.0)) 'OU'  (V '<' !VN) ) ;
   'REMP'  %'MIN'  %'SN'  V ;
  'FINS' ;
  'SI'( ((!VN 'EGA' 0.0) 'ET' (!VX 'EGA' 0.0)) 'OU'  (V '>' !VX) ) ;
   'REMP'  %'MAX'  %'SN'  V ;
  'FINS' ;
*
 'FINS' ;
*
 'SI' ( N 'EGA' %'CX' ) ;
*
  !TN       ='TABL' ;
  !TN.'MIN' = %'MIN' ;
  !TN.'CPB' = %'CPN' ;
  !TN       ='ORDO'  !TN  'MIN'  'CROI' ;
  %'MIN'    = !TN.'MIN' ;
  %'CPN'    = !TN.'CPB' ;
*
  %'MINS'   = %'SCV'  %'MIN' ;
  %'CPNS'   = %'SCS'  %'CPN' ;
*
  !TX       ='TABL' ;
  !TX.'MAX' = %'MAX' ;
  !TX.'CPB' = %'CPX' ;
  !TX       ='ORDO'  !TX  'MAX'  'CROI' ;
  %'MAX'    = !TX.'MAX' ;
  %'CPX'    = !TX.'CPB' ;
*
  %'MAXS'   = %'SCV'  %'MAX' ;
  %'CPXS'   = %'SCS'  %'CPX' ;
*
  !EN ='EVOL' 'BOUT' 'MANU'  'MIN'  %'MINS'  'CPB'  %'CPNS' ;
  !EX ='EVOL' 'BRIQ' 'MANU'  'MAX'  %'MAXS'  'CPB'  %'CPXS' ;
*
  %'RT'.'EN'  = !EN ;
  %'RT'.'EX'  = !EX ;
  %'RT'.'MIN' = %'MIN' ;
  %'RT'.'CPN' = %'CPN' ;
  %'RT'.'MAX' = %'MAX' ;
  %'RT'.'CPX' = %'CPX' ;
*
 'FINS' ;
*
'FINM' ;
