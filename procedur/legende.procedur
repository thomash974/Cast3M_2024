$$$$ LEGENDE
* LEGENDE   PROCEDUR  SP204843  22/12/19    21:15:05     11530          
debproc legende ;

* Quelle syntaxe ?
inuag1   = faux ;
ievol1   = faux ;
argu nua1/nuage ;
si (exis nua1) ;
  inuag1   = vrai ;
sino ;
  argu ev1*evolution ;
  ievol1   = vrai ;
fins ;  

* Table de sortie :
ttitr1   = table ;
tableg1  = table ;
tableg1 . titre = ttitr1 ;

*-------------------------------- NUAGE -------------------------------*

si inuag1 ;

ifmt1    = faux ;
argu mot1*mot mot2/mot ;
si (exis mot2) ;
  si (ega mot2 'FORMAT') ;
    ifmt1    = vrai ;
    argu mot3*mot ;
  fins ;
fins ;

* Liste de valeurs de la composante mot1
lval1    = extr nua1 mot1 ;

typ1     = type lval1 ;
Si (neg typ1 listreel) ;
  si (ega typ1 'FLOTTANT') ;
    si ifmt1 ;
      ttitr1 . 1 = chai mot1 ' =' 'FORMAT' mot3 lval1 ;
    sino ;
      ttitr1 . 1 = chai mot1 ' =' lval1 ;
    fins ;
    quit legende ;
  fins ;
  si (ega typ1 'ENTIER') ;
    si ifmt1 ;
      ttitr1 . 1 = chai mot1 ' =' 'FORMAT' mot3 lval1 ;
    sino ;
      ttitr1 . 1 = chai mot1 ' =' lval1 ;
    fins ;
    quit legende ;
  fins ;
  mess ' **** ERREUR ***** dans la procedure LEGENDE :' ;
  mess (chai ' La composante' ' ' mot1 ' du NUAGE ne contient pas de FLOTTANT ou d''' 'ENTIER') ;
  quit legende ;
fins ;

* Table des titres :
repe bval1 (dime lval1) ;
  vali1    = extr lval1 &bval1 ;
  si ifmt1 ;
    ttitr1 . &bval1 = chai mot1 ' =' 'FORMAT' mot3 vali1 ;
  sino ;
    ttitr1 . &bval1 = chai mot1 ' =' vali1 ;
  fins ;
fin bval1 ;

* finsi nuage :
fins ;

*------------------------------ EVOLUTION -----------------------------*

si ievol1 ;

repe bcourb1 (dime ev1) ;
  i1       = &bcourb1 ;
  ttitr1 . i1 = extr ev1 legy i1 ;
fin bcourb1 ;

* finsi evolution :
fins ;

*-------- ERREUR 5 si aucun cas prevu : ne doit jamais arriver --------*

si (non (inuag1 ou ievol1)) ;
  erre 5 ;
fins ;

finproc tableg1 ;
$$$$
 
 
