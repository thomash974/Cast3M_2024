$$$$ @POINTIR
* @POINTIR  PROCEDUR  FANDEUR   22/06/17    21:15:02     11378          
'DEBP' @POINTIR ;
*                                                                     *
*---------------------------------------------------------------------*
*                                                                     *
* PTS1 = @POINTIR | 'UNIF' N1                | (MAIL1) ('PINI' PTS2)  *
*                 | 'EXCL' N1 'SPHE' D1 (N2) |                        *
*                                                                     *
*    ... ('GERM' IGER1) ;                                             *
*                                                                     *
*---------------------------------------------------------------------*
*                                                                     *
* Acquisition des arguments :                                         *
'ARGU' DISTRI1*'MOT' NPTS1*'ENTIER' ;
*                                                                     *
* Dimension de travail (IDIM1) :
IDIM1    = 'VALE' 'DIME' ;
*                                                                     *
* Je cree le texte 'VOLU' 'SI' 'DIME' = 3 pour l'op. 'INCL' :         *
'SI' (IDIM1 'EGA' 3) ;
  TEXT1    = 'TEXT' ('MOT' 'VOLU') ;
'SINO' ;
  TEXT1    = 'TEXT' ('MOT' ' ') ;
'FINS' ;
*                                                                     *
* Precision pour l'operateur INCLus :                                 *
TOL1     = -1.E-5 ;
*                                                                     *
*---------------------------------------------------------------------*
*                                                                     *
* CAS 1 :                 DISTRIBUTION UNIFORME                       *
*                                                                     *
'SI' ('EGA' DISTRI1 'UNIF') ;
*                                                                     *
* Arguments optionnels :                                              *
*                                                                     *
  'ARGU' MAIL1/'MAILLAGE' ;
*                                                                     *
* Initialisation des donnees sur le domaine du tirage :               *
  IMAIL1   = 'EXISTE' MAIL1 ;
  TMOY1    = 'TABL' ;
  TECA1    = 'TABL' ;
  'SI' IMAIL1 ;
    RTIR1    = 1. ;
    'REPE' B0 IDIM1 ;
      chp_z  = 'COOR' &B0 MAIL1 ;
      MINI1  = 'MINI' chp_z ;
      MAXI1  = 'MAXI' chp_z ;
      RTIR1  = RTIR1 '*' (MAXI1 '-' MINI1) ;
      TMOY1. &B0 = 0.5 '*' (MAXI1 '+' MINI1) ;
      TECA1. &B0 = 0.5 '*' (MAXI1 '-' MINI1) ;
    'FIN' B0 ;
    RTIR1    = 1.2 * RTIR1 '/' ('MESU' MAIL1) ;
  'SINO' ;
    'REPE' B0 IDIM1 ;
      TMOY1. &B0 = 0.5 ;
      TECA1. &B0 = 0.5 ;
    'FIN' B0 ;
    RTIR1    = 1. ;
  'FINS' ;
*                                                                     *
* Initialisation du nombre de tirages : NTIR1                         *
  NTIR1    = 'ENTI' (('FLOT' NPTS1) '*' RTIR1) ;
*                                                                     *
* Valeur du germe :                                                   *
  IGER1    = 1 ;
  IAUTO1   = FAUX ;
  'ARGU' MOT1/'MOT' ;
  'SI' ('EXIS' MOT1) ;
    'SI' ('EGA' MOT1 'GERM') ;
      'ARGU' MOT1/'MOT' ;
      'SI' (('EXIS' MOT1) 'ET' ('EGA' MOT1 'AUTO')) ;
        IAUTO1   = VRAI ;
        'OPTI' 'ERRE' 'CONT' ;
        'OPTI' 'ACQU' 10 'ACQU' './germe' ;
        'ACQU' IGER2*'ENTIER' ;
        'OPTI' 'ERRE' 'NORM' ;
        'SI' ('EGA' ('TYPE' IGER2) 'ENTIER') ;
          IGER1    = 'ABS' IGER2 ;
        'FINS' ;
      'SINO' ;
        'ARGU' IGER1*'ENTIER' ;
      'FINS' ;
    'FINS' ;
  'FINS' ;
*                                                                     *
* Tirage des points :                                                 *
  NB1      = NTIR1  ;
  TVAR1    = 'TABL' ;
  'REPE' B0 IDIM1 ;
    TVAR1. &B0 = 'BRUI' 'BLAN' 'UNIF' (TMOY1. &B0) (TECA1. &B0) NB1 IGER1 ;
    IGER1      = 'ABS' ('ENTI' (1.E5 * ('EXTR' (TVAR1. &B0) 1))) ;
  'FIN' B0 ;
  'SI' (IDIM1 'EGA' 1) ;
    PTINCI1  = 'POIN' (TVAR1. 1) ;
  'FINSI' ;
  'SI' (IDIM1 'EGA' 2) ;
    PTINCI1  = 'POIN' (TVAR1. 1) (TVAR1. 2) ;
  'FINSI' ;
  'SI' (IDIM1 'EGA' 3) ;
    PTINCI1  = 'POIN' (TVAR1. 1) (TVAR1. 2) (TVAR1. 3) ;
  'FINSI' ;
  'OUBLIER' TVAR1 ;
* Presence d'un domaine de tirage :
  'SI' IMAIL1 ;
    PTINCI1  = PTINCI1 'INCL' MAIL1 TEXT1 'NOID' TOL1 ;
  'FINS' ;
  NPTSI1 = 'NBNO' PTINCI1 ;
  'SI' (NPTSI1 '>' NPTS1) ;
    PTINCI1 = 'ELEM' PTINCI1 'POI1' ('LECT' 1 'PAS' 1 NPTS1) ;
    NPTSI1 = NPTS1 ;
  'FINS' ;
  IP1 = NTIR1 ;

* Nouveau germe si germe auto :                                       *
  'SI' IAUTO1 ;
    VECH1    = 'VALE' 'ECHO' ;
    IMPR1    = 'VALE' 'IMPR' ;
    'OPTI' 'ECHO' 0 ;
    'OPTI' 'IMPR' 10 'IMPR' './germe' ;
    'MESS' ('ABS' IGER1) ;
    'OPTI' 'IMPR' IMPR1 ;
    'OPTI' 'ECHO' VECH1 ;
  'FINS' ;
*                                                                     *
'FINS' ;
*                                                                     *
*---------------------------------------------------------------------*
*                                                                     *
* CAS 2 :                PROCESSUS D'EXCLUSION                        *
*                                                                     *
* REPU = ancienne synthaxe pour le processus d'exclusion (repulsion)  *
'SI' (('EGA' DISTRI1 'EXCL') 'OU' ('EGA' DISTRI1 'REPU')) ;
*                                                                     *
* Arguments processus d'exclusion :                                   *
  'ARGU' ZREP1*'MOT' ;
  'SI'          ('EGA' ZREP1 'SPHE') ;
    'ARGU' DREP1*'FLOTTANT' ;
    DREP1 = 'ABS' DREP1 ;
    DREP2 = 1.E+99 '+' DREP1 ;
  'SINO' ; 'SI' ('EGA' ZREP1 'COUR') ;
    'ARGU' DREP1*'FLOTTANT' DREP2*'FLOTTANT' ;
    DREP1 = 'ABS' DREP1 ;
    DREP2 = 'ABS' DREP2 ;
    'SI' ('>EG' DREP1 DREP2) ;
      DREP1 DREP2 = DREP2 DREP1 ;
    'FINS' ;
  'SINO' ;
    'MESS' 'On attend le mot-cle SPHE ou COUR.' ;
    'QUIT' @POINTIR ;
  'FINS' ; 'FINS' ;
*                                                                     *
  'ARGU' NTIR1/'ENTIER' MAIL1/'MAILLAGE' ;
*                                                                     *
* Initialisation des donnees sur le domaine du tirage :               *
  IMAIL1   = 'EXISTE' MAIL1 ;
  TMOY1    = 'TABL' ;
  TECA1    = 'TABL' ;
  'SI' IMAIL1 ;
    RTIR1    = 1. ;
    'REPE' B0 IDIM1 ;
      chp_z    = 'COOR' &B0 MAIL1 ;
      MINI1    = 'MINI' chp_z ;
      MAXI1    = 'MAXI' chp_z ;
      RTIR1    = RTIR1 '*' (MAXI1 '-' MINI1) ;
      TMOY1. &B0 = 0.5 '*' (MAXI1 '+' MINI1) ;
      TECA1. &B0 = 0.5 '*' (MAXI1 '-' MINI1) ;
    'FIN' B0 ;
    RTIR1    = 1.2 * RTIR1 '/' ('MESU' MAIL1) ;
  'SINO' ;
    'REPE' B0 IDIM1 ;
      TMOY1. &B0 = 0.5 ;
      TECA1. &B0 = 0.5 ;
    'FIN' B0 ;
    RTIR1    = 1. ;
  'FINS' ;
*                                                                     *
* Initialisation du nombre de tirages : NTIR1                         *
  'SI' ('NON' ('EXIS' NTIR1)) ;
    NTIR1    = 25 '*' ('ENTI' (('FLOT' NPTS1) '*' RTIR1)) ;
  'FINS' ;
*                                                                     *
* Initialisation des points du tirage et du germe :                   *
  IPTS2    = FAUX ;
  IGER1    = 1 ;
  IAUTO1   = FAUX ;
  'REPE' XB0 3 ;
    'ARGU' MOT1/'MOT' ;
    'SI' ('NON' ('EXIS' MOT1)) ;
      'QUITTER' XB0 ;
    'FINS' ;
    'SI' ('EGA' MOT1 'PINI') ;
      'ARGU' PTS2*'MAILLAGE' ;
      IPTS2 = VRAI ;
      PTS2  = 'CHANGER' 'POI1' PTS2 ;
    'FINS' ;
    'SI' ('EGA' MOT1 'GERM') ;
      'ARGU' MOT1/'MOT' ;
      'SI' (('EXIS' MOT1) 'ET' ('EGA' MOT1 'AUTO')) ;
        IAUTO1   = VRAI ;
        'OPTI' 'ERRE' 'CONT' ;
        'OPTI' 'ACQU' 10 'ACQU' './germe' ;
        'ACQU' IGER2*'ENTIER' ;
        'OPTI' 'ERRE' 'NORM' ;
        'SI' ('EGA' ('TYPE' IGER2) 'ENTIER') ;
          IGER1    = 'ABS' IGER2 ;
        'FINS' ;
      'SINO' ;
        'ARGU' IGER1*'ENTIER' ;
      'FINS' ;
    'FINS' ;
  'FIN' XB0 ;
*                                                                     *
* Tirage des points :                                                 *
  NB1      = NTIR1 ;
  TVAR1    = 'TABL' ;
  'REPE' B0 IDIM1 ;
    TVAR1. &B0 = 'BRUI' 'BLAN' 'UNIF' (TMOY1. &B0) (TECA1. &B0) NB1 IGER1 ;
    IGER1      = 'ABS' ('ENTI' (1.E5 * ('EXTR' (TVAR1. &B0) 1))) ;
  'FIN' B0 ;
  'SI' (IDIM1 'EGA' 1) ;
    PTINCI1  = 'POIN' (TVAR1. 1) ;
  'FINSI' ;
  'SI' (IDIM1 'EGA' 2) ;
    PTINCI1  = 'POIN' (TVAR1. 1) (TVAR1. 2) ;
  'FINSI' ;
  'SI' (IDIM1 'EGA' 3) ;
    PTINCI1  = 'POIN' (TVAR1. 1) (TVAR1. 2) (TVAR1. 3) ;
  'FINSI' ;
  'OUBLIER' TVAR1 ;
* Presence d'un domaine de tirage :
  'SI' IMAIL1 ;
    PTINCI1  = PTINCI1 'INCL' MAIL1 TEXT1 'NOID' TOL1 ;
  'FINS' ;
* Creation d'un maillage vide si aucun point tire :                   *
  PTS1     = 'VIDE' 'MAILLAGE'/'POI1' ;
  NPTSI1   = 0 ;
*
  NB1 = 'NBNO' PTINCI1 ;
  'REPE' B1 NB1 ;
    IP1      = &B1 ;
    PTSI1    = 'POIN' PTINCI1 IP1 ;
    'SI' IPTS2 ;
      PTSI2    = (PTS1 'ET' PTS2) 'POIN' 'PROC' PTSI1 ;
      DI12     = 'DIST' PTSI1 PTSI2 ;
    'SINO' ;
      'SI' (NPTSI1 'EGA' 0) ;
        DI12     = DREP1 ;
      'SINO' ;
        PTSI2    = PTS1 'POIN' 'PROC' PTSI1 ;
        DI12     = 'DIST' PTSI1 PTSI2 ;
      'FINS' ;
    'FINS' ;
    'SI' ((DI12 '>EG' DREP1) 'ET' (DI12 '<EG' DREP2)) ;
      PTS1     = PTS1 'ET' PTSI1 ;
      NPTSI1   = NPTSI1 '+' 1 ;
      'SI' (NPTSI1 'EGA' NPTS1) ;
        'QUIT' B1 ;
      'FINS' ;
    'FINS' ;
  'FIN' B1 ;
*                                                                     *
* Nouveau germe si germe auto :                                       *
  'SI' IAUTO1 ;
    VECH1    = 'VALE' 'ECHO' ;
    IMPR1    = 'VALE' 'IMPR' ;
    'OPTI' 'ECHO' 0 ;
    'OPTI' 'IMPR' 10 'IMPR' './germe' ;
    'MESS' ('ABS' IGER1) ;
    'OPTI' 'IMPR' IMPR1 ;
    'OPTI' 'ECHO' VECH1 ;
  'FINS' ;
*                                                                     *
'FINS' ;
*                                                                     *
*---------------------------------------------------------------------*
*                                                                     *
* Message :                                                           *
'SAUT' 1 'LIGN' ;
'MESS' '*** Procedure @POINTIR :' ;
'MESS' '***' ' ' NPTSI1 ' /' ' ' NPTS1 ' points places pour' ' ' 
       IP1 ' tirages utilises /' ' ' NTIR1 ' tirages effectues.' ;
'SAUT' 1 'LIGN' ;
*                                                                     *
'RESP' PTS1 ;
'FINP' ;
$$$$

 
