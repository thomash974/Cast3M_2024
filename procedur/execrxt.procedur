* Initialisation du pas de temps
'SI' ('NON' ('EXIS' tic 'DT')) ;
  tic . 'DT' = rxt . 'DT0' ;
'FINS' ;

*
* Initialisation pour le bilan de masse en vapeur
'SI' TBT . 'VAPEUR' ;
  'SI' ('NON' ('EXIS' TIC 'Mcondm')) ;
    tic . 'Mcondm' = 'PROG' 0. ;
  'FINS' ;
  'SI' ('NON' ('EXIS' TIC 'Qcm')) ;    
     tic . 'Qcm' = 'PROG' 0. ;    
  'FINS' ;
  'SI' TBT . 'TPAROIF' ;
    'SI' ('NON' ('EXIS' TIC 'Mcondw')) ;
      tic . 'Mcondw' = 'PROG' 0. ;
    'FINS' ;
    'SI' ('NON' ('EXIS' TIC 'Qcw')) ;
      tic . 'Qcw' = 'PROG' 0. ;    
    'FINS' ;
  'FINS' ;
  'SI' TBT . 'TTIMP' ;
    NBTIMP = 'DIME' rxt . 'TIMP' ;
    itimp  = 'INDE' rxt . 'TIMP' ;
    'REPE' BBTIMP NBTIMP ;
       Btimp = rxt . 'TIMP' . (itimp . &BBTIMP) ;
       CQc1  = Btimp . 'Qc1' ;
       'SI' ('NON' ('EXIS' TIC CQc1)) ;
         tic . CQc1 = 'PROG' 0. ;
       'FINS'        ;
       CMcond1 = Btimp . 'Mcond1' ;
       'SI' ('NON' ('EXIS' tic CMcond1)) ;
         tic . CMcond1 = 'PROG' 0. ;
       'FINS' ;
    'FIN' BBTIMP ;
  'FINS' ;
  'SI' TBT . 'TECHANP' ;
    'SI' ('NON' ('EXIS' TIC 'Mcond0')) ;
      tic . 'Mcond0' = 'PROG' 0. ;
    'FINS' ;
    'SI' ('NON' ('EXIS' TIC 'Qc0')) ;    
      tic . 'Qc0' = 'PROG' 0. ;    
    'FINS' ;
  'FINS' ;
'FINS' ;

