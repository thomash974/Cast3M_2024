  tab2 . 'TITRE' . ID = tab1 . 'TITRE' . 1 ;
  tab3 . 'TITRE' . ID = 'MOT' 'Rho_co2' ;
  evMco2 = 'EVOL' 'ROSE' 'MANU'
  't(s)' ltps 'kg' (('EXTR' tic .'Rhomco2' ltpsc) '*' Vtotal) ;
  'DESS' evMco2 'MIMA' 'TITR' 'CO2 mass' 
