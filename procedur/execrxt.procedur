    'MESS' 'CO           (kg)' ' ' MCO0D ' ' MCOMD ' '
    (100. '*' (MCO0D '-' MCOMD) '/' MCO0D)  ;
  'FINS'        ;
  'SI' (TBT . 'TCO2' 'ET' ('NON' ('EGA' MCO20D 0.))) ;
