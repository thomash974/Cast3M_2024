$$$$ TOPORESO
* TOPORESO  PROCEDUR  FD218221  23/11/29    21:15:13     11799          
* TOPORESO  PROCEDUR  CB215821  21/04/22    14:10:01     9715

************************************************************************
** Procedure called by TOPOPTIM for solving the FE problem(s).
**
** Author:
** Guenhael Le Quilliec (LaMe - Polytech Tours)
**
** Version:
** 2.0 2021/04/22 Making the procedure compatible with Cast3M-2020
**                for linear resolution with thermo-mechanical loading
** 1.0 2021/04/15
************************************************************************

DEBP TOPORESO tab0*'TABLE' ;

* Input data
* **********

wtab0 = tab0.'WTABLE' ;
bool0 = wtab0.'BOOL' ;
mcn0 = bool0.'MECANISME' ;
mshA = wtab0.'MAILLAGE'.'A' ;
modA = VIDE 'MMODEL' ;
matA = VIDE 'MCHAML' ;
load0 = wtab0.'CHARGEMENT' ;
SI bool0.'MECANIQUE' ;
    modMA = wtab0.'MECANIQUE'.'MODELE'.'A' ;
    matMA = wtab0.'MECANIQUE'.'CARACTERISTIQUES'.'A' ;
    bcM0 = wtab0.'MECANIQUE'.'BLOCAGES' ;
    modA = modA ET modMA ;
    matA = matA ET matMA ;
    loadM0 = wtab0.'MECANIQUE'.'CHARGEMENT' ;
FINS ;
SI bool0.'THERMIQUE' ;
    modTA = wtab0.'THERMIQUE'.'MODELE'.'A' ;
    matTA = wtab0.'THERMIQUE'.'CARACTERISTIQUES'.'A' ;
    bcT0 = wtab0.'THERMIQUE'.'BLOCAGES' ;
    modA = modA ET modTA ;
    matA = matA ET matTA ;
    loadT0 = wtab0.'THERMIQUE'.'CHARGEMENT' ;
FINS ;
SI bool0.'CONTACT' ;
    modA = modA ET wtab0.'CONTACT'.'MODELE'.'A' ;
    matA = matA ET wtab0.'CONTACT'.'CARACTERISTIQUES'.'A' ;
FINS ;

* Solve FE problem(s)
* *******************

SI bool0.'CAS_MULTIPLES' ;
    SI (NON bool0.'PASAPAS') ;
        SAUT 1 'LIGN' ;
    FINS ;
    case_nb0 = wtab0.'NB_CAS' ;
    mdlA = TABL ;
    REPE loop0 case_nb0 ;
        mdlA.&loop0 = COPI wtab0.'RESOLUTION'.(0) ;
        SI bool0.'MECANIQUE' ;
            mdlA.&loop0.'BLOCAGES_MECANIQUES' = bcM0.&loop0 ;
        FINS ;
        SI bool0.'THERMIQUE' ;
            mdlA.&loop0.'BLOCAGES_THERMIQUES' = bcT0.&loop0 ;
        FINS ;
        mdlA.&loop0.'CHARGEMENT'              = load0.&loop0 ;
        mdlA.&loop0.'MODELE'                  = modA ;
        mdlA.&loop0.'CARACTERISTIQUES'        = matA ;
        SI mcn0 ;
            mdlA.&loop0.'MECANISME_ENTREE'    = TABL ;
            mdlA.&loop0.'MECANISME_SORTIE'    = TABL ;
        FINS ;
        MENA 'OBLI' ;
        SI bool0.'PASAPAS' ;
            mdlA.&loop0.'TEMPS_SAUVES' = wtab0.'TEMPS_SAUVES' ;
            SI mcn0 ;
                mdlA.&loop0.'MECANISME_ENTREE' = COPI mdlA.&loop0 ;
                mdlA.&loop0.'MECANISME_ENTREE'.'RIGIDITE_CONSTANTE' = wtab0.'RESSORTS'.&loop0 ;
                mdlA.&loop0.'MECANISME_SORTIE' = COPI mdlA.&loop0.'MECANISME_ENTREE' ;
                mdlA.&loop0.'MECANISME_SORTIE'.'CHARGEMENT' = wtab0.'MECANISME'.&loop0 ;
                SAUT 1 'LIGN' ;
                MESS '+--------------------------------------+' ;
                MESS '|                                      |' ;
                MESS '|        TOPOPTIM : Progression        |' ;
                MESS '|                                      |' ;
                MESS '|     Resolution Mecanisme Entree      |' ;
                MESS (CHAI '|' 'Cycle'*21 wtab0.'CYCLE'/23 '|'*40) ;
                MESS (CHAI '|' 'Cas de charge'*23 ' ' &loop0 ' /' ' ' case_nb0 '|'*40) ;
                MESS '|                                      |' ;
                MESS '+--------------------------------------+' ;
                SAUT 1 'LIGN' ;
                PASAPAS (mdlA.&loop0.'MECANISME_ENTREE') ;
                SAUT 1 'LIGN' ;
                MESS '+--------------------------------------+' ;
                MESS '|                                      |' ;
                MESS '|        TOPOPTIM : Progression        |' ;
                MESS '|                                      |' ;
                MESS '|     Resolution Mecanisme Sortie      |' ;
                MESS (CHAI '|' 'Cycle'*21 wtab0.'CYCLE'/23 '|'*40) ;
                MESS (CHAI '|' 'Cas de charge'*23 ' ' &loop0 ' /' ' ' case_nb0 '|'*40) ;
                MESS '|                                      |' ;
                MESS '+--------------------------------------+' ;
                SAUT 1 'LIGN' ;
                PASAPAS (mdlA.&loop0.'MECANISME_SORTIE') ;
            FINS ;
            SI (((NON mcn0) ET bool0.'MECANIQUE') OU
               (mcn0 ET (tab0.'MECANISME_ZERO_SPRING' OU
               ((ABS tab0.'POIDS_ENERGIE_DEFO') > tab0.'PRECISION')))) ;
                SAUT 1 'LIGN' ;
                MESS '+--------------------------------------+' ;
                MESS '|                                      |' ;
                MESS '|        TOPOPTIM : Progression        |' ;
                MESS '|                                      |' ;
                SI mcn0 ;
                  MESS '|       Resolution Sans Ressorts       |';
                FINS ;
                MESS (CHAI '|' 'Cycle'*21 wtab0.'CYCLE'/23 '|'*40) ;
                MESS (CHAI '|' 'Cas de charge'*23 ' ' &loop0 ' /' ' ' case_nb0 '|'*40) ;
                MESS '|                                      |' ;
                MESS '+--------------------------------------+' ;
                SAUT 1 'LIGN' ;
                PASAPAS (mdlA.&loop0) ;
            FINS ;
        SINO ;
            MESS (CHAI 'Resolution du cas de charge' ' ' &loop0 ' /' ' ' case_nb0) ;
            SI bool0.'MECANIQUE' ;
                tmp0 = (RIGI modMA matMA) ET bcM0.&loop0 ;
                SI mcn0 ;
                    tmp1 = tmp0 ET wtab0.'RESSORTS'.&loop0 ;
                    tmp2 = RESO tmp1 loadM0.&loop0 ;
                    mdlA.&loop0.'MECANISME_ENTREE'.'DEPLACEMENTS'= tmp2 ;
                    mdlA.&loop0.'MECANISME_ENTREE'.'CONTRAINTES' = SIGM 'LINE' modMA matMA tmp2 ;
                    mdlA.&loop0.'MECANISME_ENTREE'.'DEFORMATIONS'= EPSI 'LINE' modMA matMA tmp2 ;
                    tmp2 = RESO tmp1 wtab0.'MECANISME'.&loop0 ;
                    mdlA.&loop0.'MECANISME_SORTIE'.'DEPLACEMENTS'= tmp2 ;
                    mdlA.&loop0.'MECANISME_SORTIE'.'CONTRAINTES' = SIGM 'LINE' modMA matMA tmp2 ;
                    mdlA.&loop0.'MECANISME_SORTIE'.'DEFORMATIONS'= EPSI 'LINE' modMA matMA tmp2 ;
                FINS ;
                SI ((NON mcn0) OU (mcn0 ET (tab0.'MECANISME_ZERO_SPRING' OU 
                   ((ABS tab0.'POIDS_ENERGIE_DEFO') > tab0.'PRECISION')))) ;
                    tmp0 = RESO tmp0 loadM0.&loop0 ;
                    mdlA.&loop0.'DEPLACEMENTS' = tmp0 ;
                    mdlA.&loop0.'CONTRAINTES'  = SIGM 'LINE' modMA matMA tmp0 ;
                    mdlA.&loop0.'DEFORMATIONS' = EPSI 'LINE' modMA matMA tmp0 ;
                FINS ;
            FINS ;
            SI bool0.'THERMIQUE' ;
                mdlA.&loop0.'TEMPERATURES' = RESO ((COND modTA matTA) ET bcT0.&loop0)
                                                  loadT0.&loop0 ;
            FINS ;
        FINS ;
    FIN loop0 ;
    SI (NON bool0.'PASAPAS') ;
        SAUT 1 'LIGN' ;
    FINS ;
SINO ;
    mdlA = COPI wtab0.'RESOLUTION'.(0) ;
    mdlA.'MODELE'                  = modA ;
    mdlA.'CARACTERISTIQUES'        = matA ;
    SI mcn0 ;
        mdlA.'MECANISME_ENTREE'    = TABL ;
        mdlA.'MECANISME_SORTIE'    = TABL ;
    FINS ;
    MENA 'OBLI' ;
    SI bool0.'PASAPAS' ;
        mdlA.'TEMPS_SAUVES' = wtab0.'TEMPS_SAUVES' ;
        SI mcn0 ;
            mdlA.'MECANISME_ENTREE' = COPI mdlA ;
            mdlA.'MECANISME_ENTREE'.'RIGIDITE_CONSTANTE' = wtab0.'RESSORTS' ;
            mdlA.'MECANISME_SORTIE' = COPI mdlA.'MECANISME_ENTREE' ;
            mdlA.'MECANISME_SORTIE'.'CHARGEMENT' = wtab0.'MECANISME' ;
            SAUT 1 'LIGN' ;
            MESS '+--------------------------------------+' ;
            MESS '|                                      |' ;
            MESS '|        TOPOPTIM : Progression        |' ;
            MESS '|                                      |' ;
            MESS '|     Resolution Mecanisme Entree      |' ;
            MESS '|                                      |' ;
            MESS '+--------------------------------------+' ;
            SAUT 1 'LIGN' ;
            PASAPAS (mdlA.'MECANISME_ENTREE') ;
            SAUT 1 'LIGN' ;
            MESS '+--------------------------------------+' ;
            MESS '|                                      |' ;
            MESS '|        TOPOPTIM : Progression        |' ;
            MESS '|                                      |' ;
            MESS '|     Resolution Mecanisme Sortie      |' ;
            MESS '|                                      |' ;
            MESS '+--------------------------------------+' ;
            SAUT 1 'LIGN' ;
            PASAPAS (mdlA.'MECANISME_SORTIE') ;
        FINS ;
        SI (((NON mcn0) ET bool0.'MECANIQUE') OU
           (mcn0 ET (tab0.'MECANISME_ZERO_SPRING' OU
           ((ABS tab0.'POIDS_ENERGIE_DEFO') > tab0.'PRECISION')))) ;
            SI mcn0 ;
                SAUT 1 'LIGN' ;
                MESS '+--------------------------------------+' ;
                MESS '|                                      |' ;
                MESS '|        TOPOPTIM : Progression        |' ;
                MESS '|                                      |' ;
                MESS '|       Resolution Sans Ressorts       |' ;
                MESS '|                                      |' ;
                MESS '+--------------------------------------+' ;
                SAUT 1 'LIGN' ;
            FINS ;
            PASAPAS mdlA ;
        FINS ;
    SINO ;
        SI bool0.'MECANIQUE' ;
            tmp0 = (RIGI modMA matMA) ET bcM0 ;
            SI mcn0 ;
                tmp1 = tmp0 ET wtab0.'RESSORTS' ;
                tmp2 = RESO tmp1 loadM0 ;
                mdlA.'MECANISME_ENTREE'.'DEPLACEMENTS' = tmp2 ;
                mdlA.'MECANISME_ENTREE'.'CONTRAINTES'  = SIGM 'LINE' modMA matMA tmp2 ;
                mdlA.'MECANISME_ENTREE'.'DEFORMATIONS' = EPSI 'LINE' modMA matMA tmp2 ;
                tmp2 = RESO tmp1 wtab0.'MECANISME' ;
                mdlA.'MECANISME_SORTIE'.'DEPLACEMENTS' = tmp2 ;
                mdlA.'MECANISME_SORTIE'.'CONTRAINTES'  = SIGM 'LINE' modMA matMA tmp2 ;
                mdlA.'MECANISME_SORTIE'.'DEFORMATIONS' = EPSI 'LINE' modMA matMA tmp2 ;
            FINS ;
            SI ((NON mcn0) OU (mcn0 ET (tab0.'MECANISME_ZERO_SPRING' OU 
               ((ABS tab0.'POIDS_ENERGIE_DEFO') > tab0.'PRECISION')))) ;
                tmp0 = RESO tmp0 loadM0 ;
                mdlA.'DEPLACEMENTS' = tmp0 ;
                mdlA.'CONTRAINTES'  = SIGM 'LINE' modMA matMA tmp0 ;
                mdlA.'DEFORMATIONS' = EPSI 'LINE' modMA matMA tmp0 ;
            FINS ;
        FINS ;
        SI bool0.'THERMIQUE' ;
            mdlA.'TEMPERATURES' = RESO ((COND modTA matTA) ET bcT0) loadT0 ;
        FINS ;
    FINS ;
FINS ;

* Output data
* ***********

* Save the resolution table
wtab0.'RESOLUTION'.'A' = mdlA ;

FINP ;

$$$$
 
