C POSREE    SOURCE    CB215821  19/11/18    21:15:03     10383          
      subroutine posree(xxva,iplace)
      implicit integer (I-N)
      implicit real*8 (a-h,o-z)
-INC CCNOYAU

-INC PPARAM
-INC CCOPTIO
-INC CCASSIS
C
C LA VALEUR EXISTE-T-ELLE DEJA DANS LA PILE
*  Pour preserver le cpu, on ne recherche la valeurs que parmi les 256 dernieres
*  de toute facon menage et tasree limiteront les degats
C
        segact ipiloc
        IL=XIFLOT(/1)
        IF(IL.NE.0) THEN
          DO 55 J=max(1,LMNREE-256),LMNREE
            IF(XIFLOT(J).NE.XXVA) GOTO 55
C           LA VALEUR EXISTE DEJA  EN J IEME POSITION
            Iplace=J
            if(nbesc.ne.0) SEGDES,IPILOC
            RETURN
  55      CONTINUE
        ENDIF

C LA VALEUR N'EXISTE PAS
        segact ipiloc*mod
        LMNREE=LMNREE+1
        IF(LMNREE.GT.IL) THEN
          lmcc=ipchar(/1)
          lmmm=ichara(/1)
          lmll=iplogi(/1)
          LMxx=LMNREE + MAX(INT(REAL(LMNREE)*0.2D0),100)
          SEGADJ,IPILOC
        ENDIF

        XIFLOT(LMNREE)=XXVA
        IPLACE=LMNREE
        if(nbesc.ne.0) THEN
          SEGDES,IPILOC
        else
          SEGACT,IPILOC*NOMOD
        endif

        END

 
 
