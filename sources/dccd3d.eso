     #1 * s1 * t15 + 0.81D2 / 0.2D1 * t18 - 0.81D2 / 0.2D1 * t20 + 0.81D
     #2 / 0.2D1 * t22))
      dcc = -t26 * t25 * (t3 * (s1 + s2 + s3 + 0.3D1 * pt0) * (s1 + s2 +
     # s3 + 0.9D1 / 0.2D1 * pc0 - t8) + 0.9D1 * t13 + 0.9D1 * s1 * t15 +
     # 0.9D1 * t18 - 0.9D1 * t20 + 0.9D1 * t22) * t9 / t29 * t4 * t3 * t
     #1 * Hcc / 0.108D3





c      print*,'dcc3d:',pt0,pc0,Rt,Cdp0,M,Hcc,s1,s2,s3,dcc

