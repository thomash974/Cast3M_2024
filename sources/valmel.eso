C VALMEL    SOURCE    PV090527  23/04/06    21:15:04     11644          
      SUBROUTINE VALMEL (IPMELV,IPMINT,IPRES)
*______________________________________________________________________
*
*   CALCUL DES MELVALS AU SUPPORT DE IPMINT
*
*   IPMELV  POINTEUR SUR UN SEGMENT MELVAL A RECALCULER
*           (SUPPOSE ACTIF)
*
*   IPMINT  POINTEUR SUR LE SEGMENT D'INTEGRATION DU SUPPORT OU L'ON
*           SOUHAITE PROJETER LE MELVAL
*           (SUPPOSE ACTIF EN ENTREE ET EN SORTIE SANS CHANGMENT)
*
*   IPRES   POINTEUR SUR LE MELVAL RESULTAT
*
*   CAMPENON JM LE 02/91
*
*_____________________________________________________________________
*
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8(A-H,O-Z)


-INC PPARAM
-INC CCOPTIO
-INC SMCHAML
-INC SMINTE
*
      MELVAL=IPMELV
      N1PTEL=VELCHE(/1)
      N2PTEL=IELCHE(/1)
      IF(N2PTEL.NE.0)THEN
        IF(N2PTEL.EQ.1)THEN
          SEGINI,MELVA1=MELVAL
          IPRES=MELVA1
          RETURN
        ELSE
          MOTERR(1:8)=' '
          CALL ERREUR(124)
          IPRES=IPMELV
          RETURN
        ENDIF
      ELSE
*
        IF (N1PTEL.EQ.1) THEN
          SEGINI,MELVA1=MELVAL
          IPRES=MELVA1
          RETURN
        ELSE
*
*     ON RECUPERE LE NOMBRE DE POINT SUPPORT
*
         MINTE=IPMINT
C*       SEGACT MINTE                  <- ACTIF EN ENTREE
         NBPGAU=SHPTOT(/3)
         NBNO  =SHPTOT(/2)
***         if (velche(/1).gt.1) nbno=min(nbno,velche(/1))
         if (velche(/1).gt.1.and.velche(/1).ne.nbno) then
          interr(1)=nbno
          interr(2)=velche(/1)
          call erreur(1139)
         endif
*
         N1PTEL=NBPGAU
         N1EL=VELCHE(/2)
         N2PTEL=0
         N2EL  =0
         SEGINI MELVA1
         IPRES=MELVA1
         DO 1 IB=1,N1EL
            DO 2 IGAU=1,NBPGAU
               DO 3 INBNO=1,NBNO
                  IGMN=MIN(VELCHE(/1),INBNO)
                  MELVA1.VELCHE(IGAU,IB)=MELVA1.VELCHE(IGAU,IB)+
     &                      VELCHE(IGMN,IB)*SHPTOT(1,INBNO,IGAU)
 3             CONTINUE
 2          CONTINUE
 1       CONTINUE
        ENDIF
      ENDIF
*
      SEGDES MELVAL
C*    SEGDES MINTE                  <- ACTIF EN SORTIE (NON MODIFIE)

      RETURN
      END


 
