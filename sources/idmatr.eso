                     TABFAC(11)='RHOF'
                     TABFAC(12)='ALPF'
                  ELSEIF (IDIM.EQ.2) THEN
                     IF(IFOUR.EQ.-2)THEN
*                       CONTRAINTE PLANE
                        JGOBL=12
                        TABOBL(1)='YG1 '
                        TABOBL(2)='YG2 '
                        TABOBL(3)='NU12'
