         CALL MODELA(MOMODL,NMOD)
         CALL PLACE(MOMODL,NMOD,IPLAC,MATMOD(2))
         IF (IPLAC.NE.0) THEN
            INMAT=3
            IF (IPLAC.EQ.1) THEN
               INMAT=3
               GOTO 30
            ENDIF
            IF (IPLAC.EQ.2) THEN
