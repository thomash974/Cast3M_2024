C NEG       SOURCE    PV        22/04/27    21:15:08     11344          
      SUBROUTINE NEG
      IMPLICIT INTEGER(I-N)

-INC PPARAM
-INC CCOPTIO
      LOGICAL BOOL
      bool=.false.
      CALL EGA
      IF(IERR.NE.0) RETURN
      CALL LIRLOG(BOOL,1,IRETOU)
      BOOL=.NOT.BOOL
      CALL ECRLOG(BOOL)
      RETURN
      END

 
