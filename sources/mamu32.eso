C MAMU32    SOURCE    PV        20/02/22    21:15:11     10531          
      subroutine mamu32(long,val11,lpl1,val1,lpl,pt)
      implicit real*8 (a-h,o-z)
      real*8 val11(*),val1(*)
      real*8 pt(36)
           id12=lpl1
           id2=lpl
           id3=lpl+lpl+1
           pt1=pt(1)
           pt2=pt(2)
           pt4=pt(3)
           pt5=pt(4)
           pt7=pt(5)
           pt8=pt(6)
           do 110 i=1,long
              xval1=val1(i)
              xval11=val11(i)
              xval12=val11(i+id12)
              xval2=val1(i+id2)
              xval3=val1(i+id3)
              pt1=pt1+xval1*xval11
              pt2=pt2+xval1*xval12
              pt4=pt4+xval2*xval11
              pt5=pt5+xval2*xval12
              pt7=pt7+xval3*xval11
              pt8=pt8+xval3*xval12
 110       continue
           pt(1)=pt1
           pt(2)=pt2
           pt(3)=pt4
           pt(4)=pt5
           pt(5)=pt7
           pt(6)=pt8



           end

 
 
 
 
 
 
