C COMFIN    SOURCE    CB215821  19/08/20    21:15:59     10287          
      SUBROUTINE COMFIN(ipil,iwrk52,wrk522)

*-
*       supprime le segment pilnec
*       ferme les melval
*-
*----------------------------------------------------------------
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8(A-H,O-Z)
-INC PPARAM
-INC CCOPTIO
-INC SMCHAML
-INC DECHE

        liluc = ipil
        wrk52 = iwrk52

        do jp = 1, liluc(/1)
           pilnec=liluc(jp,2)
           segsup,pilnec
        enddo

        segsup liluc,wrk52,wrk522

        end

 
