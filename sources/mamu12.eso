C MAMU12    SOURCE    PV        20/02/22    21:15:01     10531          
      subroutine mamu12(long,val11,lpl1,val1    ,pt)
      implicit real*8 (a-h,o-z)
      real*8 val11(*),val1(*)
      real*8 pt(36)
           id12=lpl1
           pt1=pt(1)
           pt2=pt(2)
           do 110 i=1,long
              xval11=val11(i)
              xval12=val11(i+id12)
              xval1=val1(i)
              pt1=pt1+xval1*xval11
              pt2=pt2+xval1*xval12
 110       continue
           pt(1)=pt1
           pt(2)=pt2



           end

 
 
 
 
 
