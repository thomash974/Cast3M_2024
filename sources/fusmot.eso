C FUSMOT    SOURCE    CB215821  20/11/04    21:17:44     10766          
      SUBROUTINE FUSMOT(IP1,IP2,IRETOU)
C======================================================================
C   ENTREES
C     IP1 = POINTEUR SUR LE PREMIER   LMOTS
C     IP2 = POINTEUR SUR LE DEUXIEME  LMOTS
C  SORTIES
C     IRETOU = POINTEUR SUR LA CONCATENATION DES 2 LMOTS
C======================================================================
      IMPLICIT INTEGER(I-N)

-INC PPARAM
-INC CCOPTIO
-INC SMLMOTS
      IRETOU=0
      MLMOT1=IP1
      SEGACT MLMOT1
      JGN1=MLMOT1.MOTS(/1)
      JGM1=MLMOT1.MOTS(/2)
*
      MLMOT2=IP2
      SEGACT MLMOT2
      JGN2=MLMOT2.MOTS(/1)
      JGM2=MLMOT2.MOTS(/2)
*
      JGN =MAX(JGN1,JGN2)
      JGM =JGM1+JGM2
      SEGINI MLMOTS
      IRETOU=MLMOTS
      DO 100 IA=1,JGM1
      MOTS(IA)=MLMOT1.MOTS(IA)
 100  CONTINUE
      DO 200 IA=1,JGM2
      MOTS(IA+JGM1)=MLMOT2.MOTS(IA)
 200  CONTINUE
      RETURN
      END
 
