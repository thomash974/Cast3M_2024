C BBRE3D    SOURCE    FD218221  24/02/07    21:15:03     11834          
      subroutine bbre3d(NBRINC,NDIMG,NDIMA,ngf,BB,bg,
     # DEPST,DEPSC,DEPSL,JEA,frac,Gch,affiche)
      
c     calcul du syteme d equation pour le retour  avec une inclusion      

      implicit real*8 (a-h,o-z)
      implicit integer (i-n)
      
c     dimension du pb en base generalisee      
      integer NDIMG,NBRINC
      
c     second membre systeme lienaire      
      integer ngf
      real*8 bb(ngf)
c     coeff de fluage      
      real*8 JEA(NDIMG,NDIMA)
c     indicateur de diffusion produits chimiques dans fissure
      real*8 GCH(0:NBRINC)
c     def plastique
      real*8 DEPST(NDIMG),DEPSC(NDIMG),DEPSL(NDIMG)     
c     coeff de biot des gels
      real*8 bg(0:NBRINC,0:1)        
c     affichage
      logical affiche
c     fraction d inclusion      
      real*8 FRAC(0:NBRINC) 
c     affichage
      logical affiche_local      
     
      affiche_local=affiche
      
      if(ngf.lt.ndimg) then
        print*,'Redimensionner ngf>ndimg dans incl3d pour bbti3d'
      end if
      
      if(affiche_local) then
        print*,'On arrive dans bbre3d'
      end if
C       print*,NBRINC,NDIMG,NDIMA,ngf,BB,bg,
C      # DEPST,DEPSC,JEA,frac,Gch,affiche
     
      f=frac(1)
      
      t2 = 0.1D1 - f
      t3 = t2 * Gch(1)
      t4 = t3 * JEA(1,21) * bg(1,1)
      t7 = JEA(1,24) * bg(0,1)
      t10 = Gch(0) * (0.1D1 - 0.3D1 / 0.2D1 * f)
      t11 = t10 * t7
      t32 = 0.1D1 / t2 * f * Gch(0)
      t33 = t32 * t7
      t38 = DEPST(9) * (JEA(1,9) + t4) + DEPST(10) * (JEA(1,10) + t11) +
     # DEPST(11) * (JEA(1,11) + t11) + DEPST(12) * (JEA(1,12) + t11) + J
     #EA(1,1) * DEPSC(1) + JEA(1,2) * DEPSC(2) + JEA(1,3) * DEPSC(3) + J
     #EA(1,4) * DEPSC(4) + JEA(1,5) * DEPSC(5) + JEA(1,6) * DEPSC(6) + J
     #EA(1,7) * DEPSC(7) + JEA(1,8) * DEPSC(8) + JEA(1,9) * DEPSC(9) + J
     #EA(1,10) * DEPSC(10) + JEA(1,11) * DEPSC(11) + JEA(1,12) * DEPSC(1
     #2) + DEPSL(1) * (JEA(1,1) + t33) + DEPSL(2) * (JEA(1,2) + t33)
      t51 = Gch(1) * JEA(1,21) * bg(1,1)
      t65 = DEPSL(3) * (JEA(1,3) + t33) + JEA(1,4) * DEPSL(4) + JEA(1,5)
     # * DEPSL(5) + JEA(1,6) * DEPSL(6) + JEA(1,7) * DEPSL(7) + JEA(1,8)
     # * DEPSL(8) + JEA(1,9) * DEPSL(9) + JEA(1,10) * DEPSL(10) + JEA(1,
     #11) * DEPSL(11) + JEA(1,12) * DEPSL(12) + DEPST(1) * (t51 + JEA(1,
     #1)) + DEPST(2) * (t51 + JEA(1,2)) + DEPST(3) * (t51 + JEA(1,3)) + 
     #JEA(1,4) * DEPST(4) + JEA(1,5) * DEPST(5) + JEA(1,6) * DEPST(6) + 
     #DEPST(7) * (JEA(1,7) + t4) + DEPST(8) * (JEA(1,8) + t4)
      t68 = Gch(1) * JEA(2,21) * bg(1,1)
      t79 = t3 * JEA(2,21) * bg(1,1)
      t86 = JEA(2,24) * bg(0,1)
      t87 = t10 * t86
      t100 = DEPST(1) * (t68 + JEA(2,1)) + DEPST(2) * (t68 + JEA(2,2)) +
     # DEPST(3) * (t68 + JEA(2,3)) + JEA(2,4) * DEPST(4) + JEA(2,5) * DE
     #PST(5) + JEA(2,6) * DEPST(6) + DEPST(7) * (JEA(2,7) + t79) + DEPST
     #(8) * (JEA(2,8) + t79) + DEPST(9) * (JEA(2,9) + t79) + DEPST(10) *
     # (JEA(2,10) + t87) + DEPST(11) * (JEA(2,11) + t87) + DEPST(12) * (
     #JEA(2,12) + t87) + JEA(2,1) * DEPSC(1) + JEA(2,2) * DEPSC(2) + JEA
     #(2,3) * DEPSC(3) + JEA(2,4) * DEPSC(4) + JEA(2,5) * DEPSC(5) + JEA
     #(2,6) * DEPSC(6)
      t107 = t32 * t86
      t123 = JEA(2,7) * DEPSC(7) + JEA(2,8) * DEPSC(8) + JEA(2,9) * DEPS
     #C(9) + JEA(2,10) * DEPSC(10) + JEA(2,11) * DEPSC(11) + JEA(2,12) *
     # DEPSC(12) + DEPSL(1) * (JEA(2,1) + t107) + DEPSL(2) * (JEA(2,2) +
     # t107) + DEPSL(3) * (JEA(2,3) + t107) + JEA(2,4) * DEPSL(4) + JEA(
     #2,5) * DEPSL(5) + JEA(2,6) * DEPSL(6) + JEA(2,7) * DEPSL(7) + JEA(
     #2,8) * DEPSL(8) + JEA(2,9) * DEPSL(9) + JEA(2,10) * DEPSL(10) + JE
     #A(2,11) * DEPSL(11) + JEA(2,12) * DEPSL(12)
      t125 = JEA(3,24) * bg(0,1)
      t126 = t32 * t125
      t139 = Gch(1) * JEA(3,21) * bg(1,1)
      t150 = t3 * JEA(3,21) * bg(1,1)
      t155 = DEPSL(3) * (JEA(3,3) + t126) + JEA(3,4) * DEPSL(4) + JEA(3,
     #5) * DEPSL(5) + JEA(3,6) * DEPSL(6) + JEA(3,7) * DEPSL(7) + JEA(3,
     #8) * DEPSL(8) + JEA(3,9) * DEPSL(9) + JEA(3,10) * DEPSL(10) + JEA(
     #3,11) * DEPSL(11) + JEA(3,12) * DEPSL(12) + DEPST(1) * (t139 + JEA
     #(3,1)) + DEPST(2) * (t139 + JEA(3,2)) + DEPST(3) * (t139 + JEA(3,3
     #)) + JEA(3,4) * DEPST(4) + JEA(3,5) * DEPST(5) + JEA(3,6) * DEPST(
     #6) + DEPST(7) * (JEA(3,7) + t150) + DEPST(8) * (JEA(3,8) + t150)
      t158 = t10 * t125
      t181 = DEPST(9) * (JEA(3,9) + t150) + DEPST(10) * (JEA(3,10) + t15
     #8) + DEPST(11) * (JEA(3,11) + t158) + DEPST(12) * (JEA(3,12) + t15
     #8) + JEA(3,1) * DEPSC(1) + JEA(3,2) * DEPSC(2) + JEA(3,3) * DEPSC(
     #3) + JEA(3,4) * DEPSC(4) + JEA(3,5) * DEPSC(5) + JEA(3,6) * DEPSC(
     #6) + JEA(3,7) * DEPSC(7) + JEA(3,8) * DEPSC(8) + JEA(3,9) * DEPSC(
     #9) + JEA(3,10) * DEPSC(10) + JEA(3,11) * DEPSC(11) + JEA(3,12) * D
     #EPSC(12) + DEPSL(1) * (JEA(3,1) + t126) + DEPSL(2) * (JEA(3,2) + t
     #126)
      t183 = JEA(4,24) * bg(0,1)
      t184 = t10 * t183
      t203 = t32 * t183
      t210 = DEPST(10) * (JEA(4,10) + t184) + DEPST(11) * (JEA(4,11) + t
     #184) + DEPST(12) * (JEA(4,12) + t184) + JEA(4,1) * DEPSC(1) + JEA(
     #4,2) * DEPSC(2) + JEA(4,3) * DEPSC(3) + JEA(4,4) * DEPSC(4) + JEA(
     #4,5) * DEPSC(5) + JEA(4,6) * DEPSC(6) + JEA(4,7) * DEPSC(7) + JEA(
     #4,8) * DEPSC(8) + JEA(4,9) * DEPSC(9) + JEA(4,10) * DEPSC(10) + JE
     #A(4,11) * DEPSC(11) + JEA(4,12) * DEPSC(12) + DEPSL(1) * (JEA(4,1)
     # + t203) + DEPSL(2) * (JEA(4,2) + t203) + DEPSL(3) * (JEA(4,3) + t
     #203)
      t221 = Gch(1) * JEA(4,21) * bg(1,1)
      t232 = t3 * JEA(4,21) * bg(1,1)
      t239 = JEA(4,4) * DEPSL(4) + JEA(4,5) * DEPSL(5) + JEA(4,6) * DEPS
     #L(6) + JEA(4,7) * DEPSL(7) + JEA(4,8) * DEPSL(8) + JEA(4,9) * DEPS
     #L(9) + JEA(4,10) * DEPSL(10) + JEA(4,11) * DEPSL(11) + JEA(4,12) *
     # DEPSL(12) + DEPST(1) * (t221 + JEA(4,1)) + DEPST(2) * (t221 + JEA
     #(4,2)) + DEPST(3) * (t221 + JEA(4,3)) + JEA(4,4) * DEPST(4) + JEA(
     #4,5) * DEPST(5) + JEA(4,6) * DEPST(6) + DEPST(7) * (JEA(4,7) + t23
     #2) + DEPST(8) * (JEA(4,8) + t232) + DEPST(9) * (JEA(4,9) + t232)
      t250 = Gch(1) * JEA(5,21) * bg(1,1)
      t261 = t3 * JEA(5,21) * bg(1,1)
      t268 = JEA(5,24) * bg(0,1)
      t269 = t10 * t268
      t272 = JEA(5,5) * DEPSL(5) + JEA(5,6) * DEPSL(6) + JEA(5,7) * DEPS
     #L(7) + JEA(5,8) * DEPSL(8) + JEA(5,9) * DEPSL(9) + JEA(5,10) * DEP
     #SL(10) + JEA(5,11) * DEPSL(11) + JEA(5,12) * DEPSL(12) + DEPST(1) 
     #* (t250 + JEA(5,1)) + DEPST(2) * (t250 + JEA(5,2)) + DEPST(3) * (t
     #250 + JEA(5,3)) + JEA(5,4) * DEPST(4) + JEA(5,5) * DEPST(5) + JEA(
     #5,6) * DEPST(6) + DEPST(7) * (JEA(5,7) + t261) + DEPST(8) * (JEA(5
     #,8) + t261) + DEPST(9) * (JEA(5,9) + t261) + DEPST(10) * (JEA(5,10
     #) + t269)
      t289 = t32 * t268
      t297 = DEPST(11) * (JEA(5,11) + t269) + DEPST(12) * (JEA(5,12) + t
     #269) + JEA(5,1) * DEPSC(1) + JEA(5,2) * DEPSC(2) + JEA(5,3) * DEPS
     #C(3) + JEA(5,4) * DEPSC(4) + JEA(5,5) * DEPSC(5) + JEA(5,6) * DEPS
     #C(6) + JEA(5,7) * DEPSC(7) + JEA(5,8) * DEPSC(8) + JEA(5,9) * DEPS
     #C(9) + JEA(5,10) * DEPSC(10) + JEA(5,11) * DEPSC(11) + JEA(5,12) *
     # DEPSC(12) + DEPSL(1) * (JEA(5,1) + t289) + DEPSL(2) * (JEA(5,2) +
     # t289) + DEPSL(3) * (JEA(5,3) + t289) + JEA(5,4) * DEPSL(4)
      t300 = Gch(1) * JEA(6,21) * bg(1,1)
      t311 = t3 * JEA(6,21) * bg(1,1)
      t318 = JEA(6,24) * bg(0,1)
      t319 = t10 * t318
      t332 = DEPST(1) * (t300 + JEA(6,1)) + DEPST(2) * (t300 + JEA(6,2))
     # + DEPST(3) * (t300 + JEA(6,3)) + JEA(6,4) * DEPST(4) + JEA(6,5) *
     # DEPST(5) + JEA(6,6) * DEPST(6) + DEPST(7) * (JEA(6,7) + t311) + D
     #EPST(8) * (JEA(6,8) + t311) + DEPST(9) * (JEA(6,9) + t311) + DEPST
     #(10) * (JEA(6,10) + t319) + DEPST(11) * (JEA(6,11) + t319) + DEPST
     #(12) * (JEA(6,12) + t319) + JEA(6,1) * DEPSC(1) + JEA(6,2) * DEPSC
     #(2) + JEA(6,3) * DEPSC(3) + JEA(6,4) * DEPSC(4) + JEA(6,5) * DEPSC
     #(5) + JEA(6,6) * DEPSC(6)
      t339 = t32 * t318
      t355 = JEA(6,7) * DEPSC(7) + JEA(6,8) * DEPSC(8) + JEA(6,9) * DEPS
     #C(9) + JEA(6,10) * DEPSC(10) + JEA(6,11) * DEPSC(11) + JEA(6,12) *
     # DEPSC(12) + DEPSL(1) * (JEA(6,1) + t339) + DEPSL(2) * (JEA(6,2) +
     # t339) + DEPSL(3) * (JEA(6,3) + t339) + JEA(6,4) * DEPSL(4) + JEA(
     #6,5) * DEPSL(5) + JEA(6,6) * DEPSL(6) + JEA(6,7) * DEPSL(7) + JEA(
     #6,8) * DEPSL(8) + JEA(6,9) * DEPSL(9) + JEA(6,10) * DEPSL(10) + JE
     #A(6,11) * DEPSL(11) + JEA(6,12) * DEPSL(12)
      t361 = t3 * JEA(7,21) * bg(1,1)
      t368 = JEA(7,24) * bg(0,1)
      t369 = t10 * t368
      t385 = JEA(7,4) * DEPST(4) + JEA(7,5) * DEPST(5) + JEA(7,6) * DEPS
     #T(6) + DEPST(7) * (JEA(7,7) + t361) + DEPST(8) * (JEA(7,8) + t361)
     # + DEPST(9) * (JEA(7,9) + t361) + DEPST(10) * (JEA(7,10) + t369) +
     # DEPST(11) * (JEA(7,11) + t369) + DEPST(12) * (JEA(7,12) + t369) +
     # JEA(7,1) * DEPSC(1) + JEA(7,2) * DEPSC(2) + JEA(7,3) * DEPSC(3) +
     # JEA(7,4) * DEPSC(4) + JEA(7,5) * DEPSC(5) + JEA(7,6) * DEPSC(6) +
     # JEA(7,7) * DEPSC(7) + JEA(7,8) * DEPSC(8) + JEA(7,9) * DEPSC(9)
      t389 = t32 * t368
      t406 = Gch(1) * JEA(7,21) * bg(1,1)
      t413 = JEA(7,10) * DEPSC(10) + JEA(7,11) * DEPSC(11) + JEA(7,12) *
     # DEPSC(12) + DEPSL(1) * (JEA(7,1) + t389) + DEPSL(2) * (JEA(7,2) +
     # t389) + DEPSL(3) * (JEA(7,3) + t389) + JEA(7,4) * DEPSL(4) + JEA(
     #7,5) * DEPSL(5) + JEA(7,6) * DEPSL(6) + JEA(7,7) * DEPSL(7) + JEA(
     #7,8) * DEPSL(8) + JEA(7,9) * DEPSL(9) + JEA(7,10) * DEPSL(10) + JE
     #A(7,11) * DEPSL(11) + JEA(7,12) * DEPSL(12) + DEPST(1) * (t406 + J
     #EA(7,1)) + DEPST(2) * (t406 + JEA(7,2)) + DEPST(3) * (t406 + JEA(7
     #,3))
      t416 = Gch(1) * JEA(8,21) * bg(1,1)
      t427 = t3 * JEA(8,21) * bg(1,1)
      t434 = JEA(8,24) * bg(0,1)
      t435 = t10 * t434
      t448 = DEPST(1) * (t416 + JEA(8,1)) + DEPST(2) * (t416 + JEA(8,2))
     # + DEPST(3) * (t416 + JEA(8,3)) + JEA(8,4) * DEPST(4) + JEA(8,5) *
     # DEPST(5) + JEA(8,6) * DEPST(6) + DEPST(7) * (JEA(8,7) + t427) + D
     #EPST(8) * (JEA(8,8) + t427) + DEPST(9) * (JEA(8,9) + t427) + DEPST
     #(10) * (JEA(8,10) + t435) + DEPST(11) * (JEA(8,11) + t435) + DEPST
     #(12) * (JEA(8,12) + t435) + JEA(8,1) * DEPSC(1) + JEA(8,2) * DEPSC
     #(2) + JEA(8,3) * DEPSC(3) + JEA(8,4) * DEPSC(4) + JEA(8,5) * DEPSC
     #(5) + JEA(8,6) * DEPSC(6)
      t455 = t32 * t434
      t471 = JEA(8,7) * DEPSC(7) + JEA(8,8) * DEPSC(8) + JEA(8,9) * DEPS
     #C(9) + JEA(8,10) * DEPSC(10) + JEA(8,11) * DEPSC(11) + JEA(8,12) *
     # DEPSC(12) + DEPSL(1) * (JEA(8,1) + t455) + DEPSL(2) * (JEA(8,2) +
     # t455) + DEPSL(3) * (JEA(8,3) + t455) + JEA(8,4) * DEPSL(4) + JEA(
     #8,5) * DEPSL(5) + JEA(8,6) * DEPSL(6) + JEA(8,7) * DEPSL(7) + JEA(
     #8,8) * DEPSL(8) + JEA(8,9) * DEPSL(9) + JEA(8,10) * DEPSL(10) + JE
     #A(8,11) * DEPSL(11) + JEA(8,12) * DEPSL(12)
      t473 = JEA(9,24) * bg(0,1)
      t474 = t32 * t473
      t491 = Gch(1) * JEA(9,21) * bg(1,1)
      t501 = DEPSL(1) * (JEA(9,1) + t474) + DEPSL(2) * (JEA(9,2) + t474)
     # + DEPSL(3) * (JEA(9,3) + t474) + JEA(9,4) * DEPSL(4) + JEA(9,5) *
     # DEPSL(5) + JEA(9,6) * DEPSL(6) + JEA(9,7) * DEPSL(7) + JEA(9,8) *
     # DEPSL(8) + JEA(9,9) * DEPSL(9) + JEA(9,10) * DEPSL(10) + JEA(9,11
     #) * DEPSL(11) + JEA(9,12) * DEPSL(12) + DEPST(1) * (t491 + JEA(9,1
     #)) + DEPST(2) * (t491 + JEA(9,2)) + DEPST(3) * (t491 + JEA(9,3)) +
     # JEA(9,4) * DEPST(4) + JEA(9,5) * DEPST(5) + JEA(9,6) * DEPST(6)
      t503 = t3 * JEA(9,21) * bg(1,1)
      t510 = t10 * t473
      t529 = DEPST(7) * (JEA(9,7) + t503) + DEPST(8) * (JEA(9,8) + t503)
     # + DEPST(9) * (JEA(9,9) + t503) + DEPST(10) * (JEA(9,10) + t510) +
     # DEPST(11) * (JEA(9,11) + t510) + DEPST(12) * (JEA(9,12) + t510) +
     # JEA(9,1) * DEPSC(1) + JEA(9,2) * DEPSC(2) + JEA(9,3) * DEPSC(3) +
     # JEA(9,4) * DEPSC(4) + JEA(9,5) * DEPSC(5) + JEA(9,6) * DEPSC(6) +
     # JEA(9,7) * DEPSC(7) + JEA(9,8) * DEPSC(8) + JEA(9,9) * DEPSC(9) +
     # JEA(9,10) * DEPSC(10) + JEA(9,11) * DEPSC(11) + JEA(9,12) * DEPSC
     #(12)
      t532 = Gch(1) * JEA(10,21) * bg(1,1)
      t543 = t3 * JEA(10,21) * bg(1,1)
      t550 = JEA(10,24) * bg(0,1)
      t551 = t10 * t550
      t564 = DEPST(1) * (t532 + JEA(10,1)) + DEPST(2) * (t532 + JEA(10,2
     #)) + DEPST(3) * (t532 + JEA(10,3)) + JEA(10,4) * DEPST(4) + JEA(10
     #,5) * DEPST(5) + JEA(10,6) * DEPST(6) + DEPST(7) * (JEA(10,7) + t5
     #43) + DEPST(8) * (JEA(10,8) + t543) + DEPST(9) * (JEA(10,9) + t543
     #) + DEPST(10) * (JEA(10,10) + t551) + DEPST(11) * (JEA(10,11) + t5
     #51) + DEPST(12) * (JEA(10,12) + t551) + JEA(10,1) * DEPSC(1) + JEA
     #(10,2) * DEPSC(2) + JEA(10,3) * DEPSC(3) + JEA(10,4) * DEPSC(4) + 
     #JEA(10,5) * DEPSC(5) + JEA(10,6) * DEPSC(6)
      t571 = t32 * t550
      t587 = JEA(10,7) * DEPSC(7) + JEA(10,8) * DEPSC(8) + JEA(10,9) * D
     #EPSC(9) + JEA(10,10) * DEPSC(10) + JEA(10,11) * DEPSC(11) + JEA(10
     #,12) * DEPSC(12) + DEPSL(1) * (JEA(10,1) + t571) + DEPSL(2) * (JEA
     #(10,2) + t571) + DEPSL(3) * (JEA(10,3) + t571) + JEA(10,4) * DEPSL
     #(4) + JEA(10,5) * DEPSL(5) + JEA(10,6) * DEPSL(6) + JEA(10,7) * DE
     #PSL(7) + JEA(10,8) * DEPSL(8) + JEA(10,9) * DEPSL(9) + JEA(10,10) 
     #* DEPSL(10) + JEA(10,11) * DEPSL(11) + JEA(10,12) * DEPSL(12)
      t589 = JEA(11,24) * bg(0,1)
      t590 = t32 * t589
      t607 = Gch(1) * JEA(11,21) * bg(1,1)
