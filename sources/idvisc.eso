      ELSE IF (IPLAC.EQ.18) THEN
        JGM0=JGOBL
        JGOBL=JGM0+32
        TABOBL(JGM0+ 1)='R   '
        TABOBL(JGM0+ 2)='DG  '
        TABOBL(JGM0+ 3)='K1  '
        TABOBL(JGM0+ 4)='M1  '
        TABOBL(JGM0+ 5)='Q1  '
        TABOBL(JGM0+ 6)='N1  '
        TABOBL(JGM0+ 7)='K2  '
        TABOBL(JGM0+ 8)='M2  '
        TABOBL(JGM0+ 9)='Q2  '
        TABOBL(JGM0+10)='N2  '
        TABOBL(JGM0+11)='OMEG'
        TABOBL(JGM0+12)='Q   '
        TABOBL(JGM0+13)='H   '
        TABOBL(JGM0+14)='BETA'
        TABOBL(JGM0+15)='K   '
