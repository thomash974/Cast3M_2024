        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+53)='W33' 
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+54)='W34'
