        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+44)='FP4'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+45)='FP5' 
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+46)='FP6'
