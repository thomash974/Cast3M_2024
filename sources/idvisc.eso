        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+48)='FP8'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+49)='FP9'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+50)='FP10'        
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+51)='W31'
