        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+58)='W38'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+59)='W39'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+60)='W310'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+61)='WF1'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+62)='WF2'   
