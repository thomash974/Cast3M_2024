        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+41)='FP1'
        TABOBL(JGM0+NB_PARA_FLUENDO3D+NB_PARA_FIBRE_U+42)='FP2'   
