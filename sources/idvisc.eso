            TABOBL(JGM0+38)='PZZ '
            TABOBL(JGM0+39)='PRZ '
          ENDIF
          JGM0=JGFAC
          JGFAC=JGM0+28
          TABFAC(JGM0+ 1)='GFTR'
          TABFAC(JGM0+ 2)='LTR '
          TABFAC(JGM0+ 3)='GS  '
          TABFAC(JGM0+ 4)='BTR '
          TABFAC(JGM0+ 5)='WRUP'
