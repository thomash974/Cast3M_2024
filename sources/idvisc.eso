        TABFAC(JGM0+ 2)='COMP'
        TABFAC(JGM0+ 3)='DYN '
        TABFAC(JGM0+ 4)='DYN1'
        TABFAC(JGM0+ 5)='DYN2'
        TABFAC(JGM0+ 6)='DYN3'
        RETURN
C ====
C  19 -  Modele UO2 = OTTOSEN + GATT_MONERIE
C ====
      ELSE IF (IPLAC.EQ.19) THEN
C= 19.1 - Modes de calcul PLAN DEFO, PLAN GENE, Axisymetrie, Fourier
        IF (IFOUR.EQ.-3.OR.IFOUR.EQ.-1.OR.
     .      IFOUR.EQ.0.OR.IFOUR.EQ.1) THEN
          JGM0=JGOBL
          JGOBL=JGM0+39
          TABOBL(JGM0+ 1)='R   '
          TABOBL(JGM0+ 2)='DG  '
          TABOBL(JGM0+ 3)='K1  '
          TABOBL(JGM0+ 4)='M1  '
          TABOBL(JGM0+ 5)='Q1  '
          TABOBL(JGM0+ 6)='N1  '
          TABOBL(JGM0+ 7)='K2  '
          TABOBL(JGM0+ 8)='M2  '
          TABOBL(JGM0+ 9)='Q2  '
          TABOBL(JGM0+10)='N2  '
          TABOBL(JGM0+11)='OMEG'
          TABOBL(JGM0+12)='Q   '
          TABOBL(JGM0+13)='H   '
