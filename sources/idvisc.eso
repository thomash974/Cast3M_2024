          TABOBL(JGM0+28)='CR  '
          TABOBL(JGM0+29)='KP  '
          TABOBL(JGM0+30)='AP  '
          TABOBL(JGM0+31)='BP  '
          TABOBL(JGM0+32)='QP  '
          IF (IFOUR.EQ.-3.OR.IFOUR.EQ.-1) THEN
            TABOBL(JGM0+33)='LXX '
            TABOBL(JGM0+34)='LYY '
            TABOBL(JGM0+35)='LXY '
            TABOBL(JGM0+36)='LZZ '
            TABOBL(JGM0+37)='PXX '
            TABOBL(JGM0+38)='PYY '
            TABOBL(JGM0+39)='PXY '
