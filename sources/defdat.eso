C DEFDAT    SOURCE    PV        88/03/23    15:52:44                            
C  DATE   NE PAS MODIFIER SVP CE SOUS PROGRAMMME                                
C                                                                               
      SUBROUTINE DEFDAT(icp)
-INC PPARAM
-INC CCOPTIO                                                                    
-INC CQALITE
      iqexe=MODIFIEE
      DATVER=' jeu.  21  déc.  2023'
      if(icp.eq.0) WRITE (IOIMP,10) DATVER(1:50)
  10  FORMAT (/,' ****** PPP CAST3M ******  VERSION MODIFIEE DU',A50,/)
      if(icp.ne.0) WRITE (IOIMP,20) icp,DATVER(1:50)
  20  FORMAT (/,' *** PPP CAST3M *** ',i2,
     >              ' CPU *** VERSION MODIFIEE DU',A50,/)
      CALL VERDAT(1703189706  )
      END                                                                       
