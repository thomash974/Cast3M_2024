C GRACO5I   SOURCE    PV090527  23/12/20    21:15:07     11813          
      subroutine graco5i(ithr)
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8 (A-H,O-Z)
-INC SMMATRI
-INC CCHOLE
*tmp segment immt(nblig)
*     write (6,*) ' ith dans chole3i ',ith
      do  100 jbib=il2,il1,-nbthr
      jbi=jbib-ithr+1
      if (jbi.gt.il2) goto 100
      if (jbi.lt.il1) goto 100
*tmp  if (immt(jbi).gt.ider) goto 100
      LIGN=ILIGN(JBI)
      if (lign.le.0) return
      IM=immm(1)
      DO JH=2,IMMM(/1)
      IM=MIN(IM,IMMM(JH))
      ENDDO
      do 10 ip=max(im,iper),ider
      lig1=ilign(ip)
      incomp=1
      if (jbi-ip.lt.1) incomp=0
      nc=0
      CALL graco5(IPREL,IDERL,IPPVV(1),lig1.iprel,lig1.iderl,IVPO(1),
     > LIG1.IPPVV(1),VAL(1),LIG1.VAL(1),LIG1.IVPO(1),
     > imasq(1),ittr(1),incomp,nc)
  10  continue
 100  continue
      end


















 
 
 
 
 
 
 
 
 
 
