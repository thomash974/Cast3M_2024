C PRXTMX    SOURCE    CB215821  19/07/31    21:17:13     10277          
      SUBROUTINE PRXTMX
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8 (A-H,O-Z)
C
C  ****  FAIT LA LECTURE DES ENTREES DE L'OPERATEUR XTMX
C

-INC PPARAM
-INC CCOPTIO
      REAL*8 RESTOT
      ICOND=1
      CALL LIROBJ('CHPOINT ',IRE1,ICOND,IRETOU)
      CALL ACTOBJ('CHPOINT ',IRE1,1)
      IF(IERR.NE.0) RETURN
      CALL LIROBJ('RIGIDITE',IRE2,ICOND,IRETOU)
      IF(IERR.NE.0) RETURN
      CALL XTMX(IRE1,IRE2,RESTOT)
      IF(IERR.NE.0) RETURN
      CALL ECRREE(RESTOT)
      END

 
