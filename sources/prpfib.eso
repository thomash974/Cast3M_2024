          do n=1,nwlis
             do l=n0longfi,nlongfi
             if (l.eq.n0longfi) then
             somFL=ffo2(n,j+1,n0longfi)
             else 
             somFL=ffo2(n,j+1,l)+somFL
             endif
             end do 
