          if(n.eq.1) then            
          FmoyL(1,j+1)=0.d0 
          else
          FmoyL(n,j+1)=somFL/(nlongfi-n0longfi+1) 
          end if
          Fmoylis(n)=FmoyL(n,j+1)
          
