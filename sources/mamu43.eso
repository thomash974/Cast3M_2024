C MAMU43    SOURCE    PV        20/02/22    21:15:15     10531          
      subroutine mamu43(long,val11,lpl1,val1,lpl,pt)
      implicit real*8 (a-h,o-z)
      real*8 val11(*),val1(*)
      real*8 pt(36)
           id12=lpl1
           id13=lpl1+ lpl1+1
           id2=lpl
           id3=lpl+ lpl+1
           id4=lpl+ lpl+1 +lpl+2
           pt1=pt(1)
           pt2=pt(2)
           pt3=pt(3)
           pt7=pt(4)
           pt8=pt(5)
           pt9=pt(6)
           pt13=pt(7)
           pt14=pt(8)
           pt15=pt(9)
           pt19=pt(10)
           pt20=pt(11)
           pt21=pt(12)
           do 110 i=1,long
              xval1=val1(i)
              xval2=val1(i+id2)
              xval3=val1(i+id3)
              xval4=val1(i+id4)
              xval11=val11(i)
              xval12=val11(i+id12)
              xval13=val11(i+id13)
              pt1=pt1+xval1*xval11
              pt2=pt2+xval1*xval12
              pt3=pt3+xval1*xval13
              pt7=pt7+xval2*xval11
              pt8=pt8+xval2*xval12
              pt9=pt9+xval2*xval13
              pt13=pt13+xval3*xval11
              pt14=pt14+xval3*xval12
              pt15=pt15+xval3*xval13
              pt19=pt19+xval4*xval11
              pt20=pt20+xval4*xval12
              pt21=pt21+xval4*xval13
 110       continue
           pt(1)=pt1
           pt(2)=pt2
           pt(3)=pt3
           pt(4)=pt7
           pt(5)=pt8
           pt(6)=pt9
           pt(7)=pt13
           pt(8)=pt14
           pt(9)=pt15
           pt(10)=pt19
           pt(11)=pt20
           pt(12)=pt21

           end

 
 
 
 
 
 
