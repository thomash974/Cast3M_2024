      real*8 bb(ngf)
c     donnes poro-mechaniques (eau, gel, dechrage)      
      real*8 dbwPw(0:NBRINC),dbgVg(0:NBRINC)
      
      if((ngf.lt.12).or.(NDIMG.ne.12)) then
        print*,'Redimensionner ngf>12 dans incl3d pour bbti3d'
        err1=1
        return
      end if        
      t8 = JEA(1,1) + JEA(1,2) + JEA(1,3)
      t11 = JEA(1,13) + JEA(1,14) + JEA(1,15)
      t26 = JEA(1,18) * deh(3) + JEA(1,19) * dbwPw(1) + JEA(1,20) * dbgV
