C BBTI3D    SOURCE    PV090527  23/01/27    21:15:09     11574          
      subroutine bbti3d(NBRINC,NDIMG,ak,bk,am,dethi,dephi,
     #dethm,dephm,ek0,ee0,deh,dbwPw,dbgVg,JEA,NGF,BB,ERR1,AFFICHE)
      
c     calcul du 2nd membre du syteme d equations pour le tir visco THM 
c     lineaire avec une inclusion      

      implicit real*8 (a-h,o-z)
      implicit integer (i-n)
      
      integer NDIMG,ERR1
c     Jacobienne dVe/dVA
      real*8 JEA(NDIMG,NDIMG+12)
c     coeff de fluage      
c     coeff de fluage      
      integer NBRINC
      logical affiche
c     fluage
      real*8 ak(NDIMG),bk(NDIMG),am(NDIMG)
      real*8 ek0(NDIMG),ee0(NDIMG)        
      real*8 dethi,dechi,dephi,dethm,dechm,dephm,deh(3)
