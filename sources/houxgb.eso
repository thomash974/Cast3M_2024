C HOUXGB    SOURCE    PV        21/12/18    07:15:06     11240          
C HOUXGB    SOUINCA   COMBESCU  01/04/06    03:00:01
      FUNCTION HOUXGB (XX,N)
      IMPLICIT REAL*8(A-H,O-Z)
      IMPLICIT INTEGER (I-N)
*
*      IMPLICIT NONE
*
*      REAL *8  XX(24)
*      INTEGER  N
*      REAL *8  HOUXGB
      Dimension XX(24)
*
*
*
      IF(N.EQ.1) THEN
               HOUXGB =   XX(1)  +  XX(4)  -  XX(7)  -   XX(10)
     &                  - XX(13) -  XX(16) +  XX(19) +   XX(22)
       ELSEIF(N.EQ.2) THEN
               HOUXGB =   XX(1)  -  XX(4)  -  XX(7)  +   XX(10)
     &                  - XX(13) +  XX(16) +  XX(19) -   XX(22)
       ELSEIF(N.EQ.3) THEN
               HOUXGB =   XX(1)  -  XX(4)  +  XX(7)  -   XX(10)
     &                 +  XX(13) -  XX(16) +  XX(19) -   XX(22)
       ELSEIF(N.EQ.4) THEN
               HOUXGB = - XX(1)  +  XX(4)  -  XX(7)  +   XX(10)
     &                 +  XX(13) -  XX(16) +  XX(19) -   XX(22)
       ELSE
              write(6,*) ' erreur dans houxgb'
              CALL ERREUR(5)
               houxgb=0
*               STOP 'HOUXGB'
      ENDIF
*
      END


 
