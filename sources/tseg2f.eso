C TSEG2F    SOURCE    OF166741  23/12/04    21:15:19     11800          

C=======================================================================
C=                            T S E G 2 F                              =
C=                            -----------                              =
C=                                                                     =
C=  Fonction :                                                         =
C=  ----------                                                         =
C=   Acquisition des caracteristiques d'integration aux noeuds, aux    =
C=   points d'integration (Gauss) ou au centre de gravite pour         =
C=   l'element thermique support SEG2.                                 =
C=                                                                     =
C=  Parametres :  (E)=Entree  (S)=Sortie                               =
C=  ------------                                                       =
C=   ISUPTH  (E)   Indique le support d'integration demande            =
C=   IPINTE  (S)   Pointeur sur le segment MINTE associe (ACTIF en S)  =
C=======================================================================

      SUBROUTINE TSEG2F (ISUPTH,IPINTE)

      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8 (A-H,O-Z)

-INC SMINTE

      PARAMETER ( XZero = 0.D0 , O2=2.D0 , O1=1.D0 , O5=0.5D0 )
      PARAMETER ( O577=0.577350269189625764509148780501957D0 )

      NBNO = 2
      IF      (ISUPTH.EQ.1) THEN
        NBPGAU = 2
      ELSE IF (ISUPTH.EQ.2) THEN
        NBPGAU = 2
      ELSE IF (ISUPTH.EQ.3) THEN
        NBPGAU = 1
      ELSE
        CALL ERREUR(5)
        RETURN
      ENDIF
      SEGINI,MINTE

C COORDONNEES ET POIDS DES 2 NOEUDS
      IF (ISUPTH.EQ.1) THEN
        QSIGAU(1) = -O1
        QSIGAU(2) = +O1
        POIGAU(1) =  O1
        POIGAU(2) =  O1

C COORDONNEES ET POIDS DES 2 POINTS DE GAUSS
      ELSE IF (ISUPTH.EQ.2) THEN
        QSIGAU(1) = -O577
        QSIGAU(2) = +O577
        POIGAU(1) =  O1
        POIGAU(2) =  O1

C COORDONNEES ET POIDS DU CENTRE DE GRAVITE
      ELSE IF (ISUPTH.EQ.3) THEN
        QSIGAU(1) = XZero
        POIGAU(1) = O2
      ENDIF

* FONCTIONS DE FORME ET LEURS DERIVEES AU(X) NBPGAU POINT(S)
      DO I = 1, NBPGAU
        XI = QSIGAU(I)
        SHPTOT(1,1,I) = (O1-XI)*O5
        SHPTOT(1,2,I) = (O1+XI)*O5

        SHPTOT(2,1,I) = -O5
        SHPTOT(2,2,I) =  O5
      ENDDO

      IPINTE = MINTE

c      RETURN
      END

 
