C COTRAC    SOURCE    PASCAL    21/05/06    21:15:08     10998          
      SUBROUTINE COTRAC(WRK0,WRK2,NCOURB,KERRE)
C-----------------------------------------------------------------------
C
C     CETTE SUBROUTINE RENVOIE LA RELATION CONTRAINTE-DEFORMATION
C     DANS LE SEGMENT WRK2 A PARTIR DE LA COURBE D'ECROUISSAGE,
C     I.E. LA COURBE CONTRAINTE VS DEFORMATION PLASTIQUE.
C
C     LE PREMIER POINT DE LA COURBE FOURNIT SIGY,
C     LA DEFORMATION PLASTIQUE ASSOCIEE EST NULLE.
C
C-----------------------------------------------------------------------
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8(A-H,O-Z)
-INC SMEVOLL
-INC SMLREEL
-INC CCREEL

-INC PPARAM
-INC CCOPTIO
      SEGMENT/WRK0/(XMAT(NCOMAT)*D)
      SEGMENT/WRK2/(TRAC(LTRAC)*D)
      DATA NCOMAX/130/
      KERRE=0
      MEVOLL=nint(XMAT(5))

      IF(MEVOLL.EQ.0) THEN
        KERRE=37
        RETURN
      ENDIF

      SEGACT MEVOLL
      KEVOLL=IEVOLL(1)
      SEGACT KEVOLL
      MLREEL=IPROGX
      MLREE1=IPROGY

      SEGACT MLREEL,MLREE1
      NBPOIX=PROG(/1)
      NBPOIY=MLREE1.PROG(/1)
      IF(NBPOIX.GT.NCOMAX+1) KERRE=31
      IF(KERRE.NE.0) RETURN
      IF(NBPOIX.LT.2) THEN
        CALL ERREUR(1100) 
        RETURN
      ENDIF 
C
C   VERIFICATION DU MODULE DE YOUNG
C
      YUNG=XMAT(1)
      IF(YUNG.LE.0.D0) THEN
        REAERR(1)=YUNG
        CALL ERREUR(1090)
        KERRE=34
        RETURN
      ENDIF
C
C  VERIF DE LA LIMITE ELASTIQUE NON NULLE
C
      PSIG =MLREE1.PROG(1)
      IF(PSIG.LT.0.D0) THEN
        REAERR(1)=PSIG
        CALL ERREUR(1091)
        KERRE=30
        RETURN
      ENDIF
      PEPS=PROG(1)
      IF(ABS(PEPS).GT.XZPREC) THEN
        REAERR(1)=PEPS
        CALL ERREUR(1099)
        KERRE=35
        RETURN
      ENDIF
C
C  VERIF DE LA PENTE
C
      DO 100 I=2,NBPOIX
        I1=I-1
        DEPS=PROG(I)-PROG(I1)
        IF(DEPS.LE.0.D0) THEN
          CALL ERREUR(1101)
          KERRE=33
          RETURN
        ENDIF
        PENTE=(MLREE1.PROG(I)-MLREE1.PROG(I1))/DEPS
        IF(ABS(PENTE-YUNG).LT.(1.D-3*YUNG)) THEN
*          REAERR(1)=PENTE
*          REAERR(2)=YUNG
          CALL ERREUR(1102)
          KERRE=33
          RETURN
        ENDIF
 100  CONTINUE
C
C  DONNEE DE LA COURBE SOUS FORME D'UNE LISTE 
C
      NCOURB = 1
      TRAC(1)= MLREE1.PROG(1)
      TRAC(2)= 0.D0
      DO 695 I=2,NBPOIX
        PEPS = PROG(I)
        PSIG = MLREE1.PROG(I)
        NCOURB = NCOURB+1
        TRAC(2*NCOURB-1) = PSIG
        TRAC(2*NCOURB) = PEPS
  695 CONTINUE

      END
 
 
 
 
