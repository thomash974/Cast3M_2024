      SUBROUTINE YIELDDJ2 (SIG,NDIMS,VAR,NDIMV,VALOR)
      IMPLICIT INTEGER(I-N)
      integer ndims,ndimv
      real*8  sig(ndims),var(ndimv),valor,siginv(3)
      call InvariantesIJJ(sig,ndims,siginv)
      call yieldvm (siginv,var(1),valor)
      return
      end



 
