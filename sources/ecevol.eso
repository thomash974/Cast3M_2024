C ECEVOL    SOURCE    FANDEUR   21/04/20    21:15:01     10973          

      SUBROUTINE ECEVOL(MEVOLL,jentet)
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8(A-H,O-Z)
C
C  ====================================================================
C  =  ECRITURE DE L'OBJET EVOLUTION                                   =
C  =  CREATION    : 01/10/86                                          =
C  =  PROGRAMMEUR : GUILBAUD                                          =
C  ====================================================================
C
-INC PPARAM
-INC CCOPTIO
-INC CCGEOME

-INC SMLREEL
-INC SMEVOLL
-INC SMLENTI
-INC SMLMOTS

      SEGACT MEVOLL
      WRITE (IOIMP,100) IEVTEX
 100  FORMAT (2X,A72)
      N=IEVOLL(/1)
      INTERR(1)=MEVOLL
      INTERR(2)=N
      MOTERR(1:8)=ITYEVO
      CALL ERREUR(-116)
C
      DO 1 I=1,N
      KEVOLL=IEVOLL(I)
      SEGACT KEVOLL
      INTERR(1)=I
      MOTERR(1:4)=NCOUL(NUMEVX)
      CALL ERREUR(-117)
      WRITE (IOIMP,100) KEVTEX
      MOTERR(1:12)= NOMEVX
      CALL ERREUR(-118)
      MOTERR(1:4)=NUMEVY
      MOTERR(5:16)=NOMEVY
      CALL ERREUR(-119)

      IF(TYPX.EQ.'LISTREEL')THEN
         MLREEL=IPROGX
         SEGACT MLREEL
         NPAS=PROG(/1)
         npi=npas
         if(jentet.eq.1) npi=min(npi,10)
         INTERR(1)=NPAS
         CALL ERREUR(-120)

         IF(TYPY.EQ.'LISTREEL') THEN
            MLREE2=IPROGY
            SEGACT,MLREE2
            WRITE(IOIMP,101)(J,PROG(J),MLREE2.PROG(J),J=1,NPi)
C 101        FORMAT(/4(1X,I5,1X,1PE12.5,1X,1PE12.5,1X))
 101        FORMAT(/(3X,I5,3X,1PE12.5,3X,1PE12.5))
            SEGDES,MLREE2

          ELSEIF(TYPY.EQ.'LISTMOTS') THEN
            MLMOT2=IPROGY
            SEGACT,MLMOT2
            WRITE(IOIMP,102)(J,PROG(J),MLMOT2.MOTS(J),J=1,NPi)
C 102        FORMAT(/4(1X,I5,1X,1PE12.5,1X,A8,1X))
 102        FORMAT(/(3X,I5,3X,1PE12.5,3X,A24))
            SEGDES,MLMOT2

          ELSEIF(TYPY.EQ.'LISTENTI') THEN
            MLENT2=IPROGY
            SEGACT,MLENT2
            WRITE(IOIMP,103)(J,PROG(J),MLENT2.LECT(J),J=1,NPi)
C 103        FORMAT(/4(1X,I5,1X,1PE12.5,1X,A8,1X))
 103        FORMAT(/(3X,I5,3X,1PE12.5,3X,I8))
            SEGDES,MLENT2
          ENDIF
          SEGDES,MLREEL

      ELSEIF(TYPX.EQ.'LISTMOTS') THEN
         MLMOTS=IPROGX
         SEGACT MLMOTS
         NPAS=MOTS(/2)
         npi=npas
         if(jentet.eq.1) npi=min(npi,10)
         INTERR(1)=NPAS
         CALL ERREUR(-120)

         IF(TYPY.EQ.'LISTREEL') THEN
            MLREE2=IPROGY
            SEGACT,MLREE2
            WRITE(IOIMP,111)(J,MOTS(J),MLREE2.PROG(J),J=1,NPi)
C 111        FORMAT(/4(1X,I5,1X,A8,1X,1PE12.5,1X))
 111        FORMAT(/(3X,I5,3X,A24,3X,1PE12.5))
            SEGDES,MLREE2

          ELSEIF(TYPY.EQ.'LISTMOTS') THEN
            MLMOT2=IPROGY
            SEGACT,MLMOT2
            WRITE(IOIMP,112)(J,MOTS(J),MLMOT2.MOTS(J),J=1,NPi)
C 112         FORMAT(/4(1X,I5,1X,A8,1X,A8,1X))
 112         FORMAT(/(3X,I5,3X,A24,3X,A24))
            SEGDES,MLMOT2

          ELSEIF(TYPY.EQ.'LISTENTI') THEN
            MLENT2=IPROGY
            SEGACT,MLENT2
            WRITE(IOIMP,113)(J,MOTS(J),MLENT2.LECT(J),J=1,NPi)
C 113         FORMAT(/4(1X,I5,1X,A8,1X,A8,1X))
 113         FORMAT(/(3X,I5,3X,A24,3X,I8))
            SEGDES,MLENT2
          ENDIF
          SEGDES,MLMOTS

      ELSEIF(TYPX.EQ.'LISTENTI') THEN
         MLENTI=IPROGX
         SEGACT MLENTI
         NPAS=LECT(/1)
         npi=npas
         if(jentet.eq.1) npi=min(npi,10)
         INTERR(1)=NPAS
         CALL ERREUR(-120)

         IF(TYPY.EQ.'LISTREEL') THEN
            MLREE2=IPROGY
            SEGACT,MLREE2
            WRITE(IOIMP,121)(J,LECT(J),MLREE2.PROG(J),J=1,NPi)
C 121        FORMAT(/4(1X,I5,1X,A8,1X,1PE12.5,1X))
 121        FORMAT(/(3X,I5,3X,I8,3X,1PE12.5))
            SEGDES,MLREE2

          ELSEIF(TYPY.EQ.'LISTMOTS') THEN
            MLMOT2=IPROGY
            SEGACT MLMOT2
            WRITE(IOIMP,122)(J,LECT(J),MLMOT2.MOTS(J),J=1,NPi)
C 122         FORMAT(/4(1X,I5,1X,A8,1X,A8,1X))
 122         FORMAT(/(3X,I5,3X,I8,3X,A24))
            SEGDES,MLMOT2

          ELSEIF(TYPY.EQ.'LISTENTI') THEN
            MLENT2=IPROGY
            SEGACT,MLENT2
            WRITE(IOIMP,123)(J,LECT(J),MLENT2.LECT(J),J=1,NPi)
C 123         FORMAT(/4(1X,I5,1X,A8,1X,A8,1X))
 123         FORMAT(/(3X,I5,3X,I8,3X,I8))
            SEGDES,MLENT2
          ENDIF
          SEGDES,MLENTI
      ENDIF
      SEGDES KEVOLL
   1  CONTINUE
      SEGDES MEVOLL

C      RETURN
      END

 
