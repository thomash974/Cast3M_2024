'OPTION' 'DIME' 2 'ELEM' 'QUA4' ;
'OPTION' 'TRAC' 'PSC' 'EPTR' 8 ;

RPAST = 4.10E-3 ;
JEUPG = 0.10E-3 ;
EGAIN = 0.57E-3 ;
HZ    = 0.20E-3 ;

RCI = 0. ;
RCE = RCI '+' RPAST ;
RGI = RCE '+' JEUPG ;
RGE = RGI '+' EGAIN ;

JEU0 = JEUPG ;

NELRC = 10 ; NELRG = 3 ; NELH = 1 ;

P0  = 'POINT' 0. 0. ;  PH  = 'POINT' 0. HZ ; 
PCI = 'POINT' RCI 0. ; PCE = 'POINT' RCE 0. ;
PGI = 'POINT' RGI 0. ; PGE = 'POINT' RGE 0. ;

SBasC = 'DROITE' NELRC PCI PCE ; SBasC = SBasC 'COUL' 'ROUG' ;
MFuel = SBasC 'TRANS' NELH PH ;
SExtC = 'COTE' 2 MFuel ;
SHauC = 'INVERSE' ('COTE' 3 MFuel) ;
SIntC = 'INVERSE' ('COTE' 4 MFuel) ;
CoFuel = 'CONTOUR' MFuel ;

SBasG = 'DROITE' NELRG PGI PGE ; SBasG = SBasG 'COUL' 'BLEU' ;
MClad = SBasG 'TRANS' NELH PH ;
SExtG = 'COTE' 2 MClad ;
SHauG = 'INVERSE' ('COTE' 3 MClad) ;
SIntG = 'INVERSE' ('COTE' 4 MClad) ;
CoClad = 'CONTOUR' MClad ;

*TRAC (SbasC et SbasG) ;
*TRAC (MFuel et MClad) 'FACE' ;

ModlC = 'MODELE' MFuel 'MECANIQUE' 'ELASTIQUE' 'ISOTROPE'
                       'HHO_2_1'
                       'CONS' 'FUEL' ;
MateC = 'MATERIAU' ModlC 'YOUN' 190.E+9 'NU' 0.3 'ALPH' 10.E-6 
                         'STAB' (190.E+9 / (1. + 0.3)) ;

ModlG = 'MODELE' MClad 'MECANIQUE' 'ELASTIQUE' 'ISOTROPE'
                       'CONS' 'CLAD' ; 
MateG = 'MATERIAU' ModlG 'YOUN'  78.E+9 'NU' 0.3 'ALPH'  6.E-6 ;

Modl_tot = ModlC 'ET' ModlG ;
Mate_tot = MateC 'ET' MateG ;

HHO_C_F = ('EXTRAIRE' ModlC 'HHO_PFAC') 'COUL' 'ORAN' ;
SIntC_F = 'POINT' HHO_C_F 'DROITE' PCI (PCI 'PLUS' PH) 1.E-9 ;              SIntC_F = SIntC_F 'COUL' 'OLIV' ;
SExtC_F = 'POINT' HHO_C_F 'DROITE' PCE (PCE 'PLUS' PH) 1.E-9 ;              SExtC_F = SExtC_F 'COUL' 'VERT' ;
SBasC_F = 'POINT' HHO_C_F 'DROITE' PCI PCE 1.E-9 ;                          SBasC_F = SBasC_F 'COUL' 'ORAN' ;
SHauC_F = 'POINT' HHO_C_F 'DROITE' (PCI 'PLUS' PH) (PCE 'PLUS' PH) 1.E-9 ;  SHauC_F = SHauC_F 'COUL' 'VIOL' ;

'TRAC' ((MFuel et MClad) et (SIntC_F et SExtC_F et SBasC_F et SHauC_F)) ;

Bloq_CI_R  = 'BLOQUE' SIntC_F 'UXF0' 'UXF1' ;
*Rela_CE_R0 = 'RELA' 'ENSE' SExtC_F 'UXF0' ;
Bloq_CE_R1 = 'BLOQUE' SExtC_F 'UXF1' ;
Bloq_CB_Z  = 'BLOQUE' SBasC_F 'UYF0' 'UYF1' ;
Rela_CH_Z0 = 'RELA' 'ENSE' SHauC_F 'UYF0' ;
Bloq_CH_Z1 = 'BLOQUE' SHauC_F 'UYF1' ;

Bloq_GB_Z = 'BLOQUE' SBasG 'UY  ' ;
Rela_GH_Z = 'RELA' 'ENSE' SHauG 'UY' ;

Cont_CG = 'RELA' 'MAXI' 'UXF0' SExtC_F '-' 'UX' SIntG ;
list Cont_CG ;
D_JEUP = 'DEPIMP' Cont_CG JEU0 ;
list D_JEUP ;

Bloq_tot = Bloq_CI_R 'ET' Bloq_CE_R1 'ET' Bloq_CB_Z 'ET' Rela_CH_Z0 'ET' Bloq_CH_Z1 'ET' 
           Bloq_GB_Z 'ET' Rela_GH_Z ;

BL_UIMP = 'BLOQUE' SExtG 'UX' ;

CaL_tot = Bloq_tot 'ET' BL_UIMP ;

D_UIMP = 'DEPIMP' BL_UIMP (-3. * JEU0) ;

Rigi_tot = 'RIGIDITE' Modl_tot Mate_tot ;

Sol_1 = 'RESO' (Rigi_tot 'ET' Bloq_tot 'ET' BL_Uimp 'ET' Cont_CG) (D_UIMP 'ET' D_JEUP);

Chm_Eps_CG = 'EPSI' 'LINE' Modl_tot Mate_tot Sol_1 ;
Chm_Sig_CG = 'SIGM' 'LINE' Modl_tot Mate_tot Sol_1 ;
Chm_VMi_CG = 'VMIS' Modl_tot Chm_Sig_CG ;

chp_U_G = 'REDU' Sol_1 Coclad ;

valR = 'EXTRAIRE' Sol_1 'UXF0' (POIN SExtC_F 1) ; list valR ;
chp_ur_C = 'MANU' 'CHPO' SExtC 1 'UX' valR 'NATURE' 'DIFFUS' ;
valR = 'EXTRAIRE' Sol_1 'UYF0' (POIN SHauC_F 1) ; list valR ;
chp_uz_C = 'MANU' 'CHPO' SHauC 1 'UY' valR 'NATURE' 'DIFFUS' ;

chp_u_tot = (chp_ur_C et chp_uz_C) et chp_U_G ;

TRAC (CoFuel 'ET' CoClad) ;
Md0 = MFuel 'ET' MClad ;
Mdd = (Md0 'PLUS' chp_u_tot) 'PLUS' ('POINT' 0. (-4. * HZ)) ;
TRAC (Md0 et Mdd) 'FACE' ;

**Chm_I1E_CG Chm_I2E_CG Chm_I3E_CG = 'INVARIANT' Chm_Eps_CG Modl_tot Mate_tot ;
Chm_trE_CG = chm_I1E_CG ;

Chm_I1S_CG Chm_I2S_CG Chm_I3S_CG = 'INVARIANT' Chm_Sig_CG Modl_tot Mate_tot ;
Chm_Phy_CG = (1. '/' 3.) '*' chm_I1S_CG ;
fin;
