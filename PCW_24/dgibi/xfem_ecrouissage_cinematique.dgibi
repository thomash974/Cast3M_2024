* Section : Mecanique Rupture
************************************************************************
*      Cas-test de fonctionnement du comportement elastoplastique      *
*    avec ecrouissage isotrope en combinaison avec des elements XQ4R   *
*                                                                      *
* Verification dans un cas trivial : solicitation parallele a la       *
* fissure => fissure non sollicitee donc on doit retrouver la meme     *
* chose avec des elements standards                                    *
************************************************************************

* OPTIONS ET BOOLEEN POUR LES TRACERS
OPTI 'DIME' 2 'ELEM' 'QUA4' 'MODE' 'PLANCONT';
BTRAC = FAUX;

* MAILLAGE
NEL = 2;

P1 = 0. 0.;
P2 = 1. 0.;
D1 = DROI NEL P1 P2;

P5 = 0. 1.;
P6 = 1. 1.;
D2 = DROI NEL P5 P6;

S1 = D1 REGL NEL D2;
SI BTRAC;
    TRAC S1;
FINSI;

* MODELE ET MATERIAU AVEC XQ4R
MOD1 = MODE S1 'MECANIQUE' 'ELASTIQUE' 'PLASTIQUE' 'CINEMATIQUE' 'XQ4R';
P3 = 0.5 0.;
P4 = 0.5 0.5;
D3 = DROI 1 P3 P4;
PSI PHI = PSIPHI S1 D3 'DEUX' P4;
TRIE MOD1 PSI PHI 'SAUT';
MAT1 = MATE MOD1 'YOUN' 200.E9 'NU' 0.3 'SIGY' 120.E6 'H' 120.E8;

* MODELE ET MATERIAU AVEC ELEMENTS STANDARDS
MOD2 = MODE S1 'MECANIQUE' 'ELASTIQUE' 'PLASTIQUE' 'CINEMATIQUE';
MAT2 = MATE MOD2 'YOUN' 200.E9 'NU' 0.3 'SIGY' 120.E6 'H' 120.E8;

* CL EN DEPLACEMENTS
RIG1 = BLOQ 'UY' D2;
PDROI = (CONT S1) POIN 'DROI' P1 P5 1.E-5;
RIG2 = BLOQ 'UX' PDROI;
RIG3 = BLOQ 'UY' D1;
UIMP = DEPI RIG1 1.5E-3;
UDET = EVOL 'MANU' 'TEMPS' (PROG 0. 1. 2.) (PROG 0. 1. 0.);

* CALCUL AVEC XQ4R
CALC1 = TABL;
CALC1.'BLOCAGES_MECANIQUES' = RIG1 ET RIG2 ET RIG3 ET (RELA MOD1);
CALC1.'CHARGEMENT' = CHAR 'DIMP' UIMP UDET;
CALC1.'TEMPS_CALCULES' = (PROG 0. PAS 0.4 2.);
CALC1.'MODELE' = MOD1;
CALC1.'CARACTERISTIQUES' = MAT1;
PASAPAS CALC1;
* COURBE CONTRAINTE - DEPLACEMENT
XSYY = EVOL 'TEMP' CALC1 'CONTRAINTES' 'SMYY' 1 1 1;
XU = EVOL 'TEMP' CALC1 'DEPLACEMENTS' 'UY' P5;
XS_DE_U = EVOL 'MANU' 'U' (EXTR XU 'ORDO') 'SIGM' (EXTR XSYY 'ORDO');

* CALCUL AVEC ELEMENTS STANDARDS
CALC2 = TABL;
CALC2.'BLOCAGES_MECANIQUES' = RIG1 ET RIG2 ET RIG3;
CALC2.'CHARGEMENT' = CALC1.'CHARGEMENT';
CALC2.'TEMPS_CALCULES' = CALC1.'TEMPS_CALCULES';
CALC2.'MODELE' = MOD2;
CALC2.'CARACTERISTIQUES' = MAT2;
PASAPAS CALC2;
* COURBE CONTRAINTE - DEPLACEMENT
SYY = EVOL 'TEMP' CALC2 'CONTRAINTES' 'SMYY' 1 1 1;
U = EVOL 'TEMP' CALC2 'DEPLACEMENTS' 'UY' P5;
S_DE_U = EVOL 'MANU' 'U' (EXTR U 'ORDO') 'SIGM' (EXTR SYY 'ORDO');

* COMPARAISON
SI BTRAC;
    DESS (XS_DE_U ET S_DE_U);
FINSI;
ERR1 = (INTG (XSYY - SYY)**2)**0.5;
SEUIL = ((INTG SYY**2)**0.5) / 100.;
SI (ERR1 >EG SEUIL);
    MESS 'ECART A LA REFERENCE :' ERR1;
    MESS 'SEUIL ACCEPTE :' SEUIL;
    ERRE 'ERREUR SUPERIEURE AU SEUIL ACCEPTE';
FINSI;

FIN;
 

