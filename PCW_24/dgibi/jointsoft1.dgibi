* fichier : jointsoft1.dgibi
* section : mecanique statique non lineaire
*----------------------------------------------------------------------*
*                    J O I N T S O F T 1 . D G I B I                   *
*----------------------------------------------------------------------*
* Objet :                                                              
* -------
*
* Cas-test de validation du modele de joint "JOINT_SOFT" (JOI2).
*
* Le modele est valide en :
* - compression simple
* - traction simple
* - cisaillement simple
*
* Son fonctionnement pour un cas de chargement mixte compression-cisail-
* -lement est egalement teste mais sans validation a un resultat de
* reference.
*
* Description :
* -------------
*
* Type de calcul : Mecanique Statique NON LINEAIRE
* Mode de calcul : 2D PLAN
* Type d'element : JOI2
* Chargement     : deplacements imposes
*
*----------------------------------------------------------------------*
opti dime 2 mode plan defo elem qua4 ;

* Pour traces, mettre IG1 a vrai :
ig1      = faux ;

*----------------------------------------------------------------------*
*                         DEFINITION DU MODELE                         *
*----------------------------------------------------------------------*

*------------------------------ Maillage ------------------------------*

l1       = (0 0) droi 1 (1 0) ;
l2       = l1 plus (0 1) ;
* Sens parcours lignes impose l2 en 1er (voir RACC) :
jt1      = racc l2 l1 1.1 ;
l1       = l1 coul roug ;
l2       = l2 coul vert ;

si ig1 ;
  trac (jt1 et l1 et l2) qual titr ' Maillage du joint JT1. CL : L1 bloquee, L2 mobile ' ;
fins ;

*--------------------- Modele / Caracteristiques ----------------------*

* Courbes de comportement en compression, traction, cisaillement :
luc1     = prog 0. +0.1 +1.0 ;
lfc1     = prog 0. +0.2 +0.3 ;
comp1    = evol bleu manu luc1 sjcb lfc1 ;
lut1     = prog 0. +0.1 +0.2   +1.0 ;
lft1     = prog 0. +0.2 +1.e-5 +1.e-5 ;
trac1    = evol roug manu lut1 sjtb lft1 ;
lus1     = prog 0. +0.1 +1.0 ;
lfs1     = prog 0. +0.1 +0.1 ;
cisa1    = evol vert manu lus1 sjsb lfs1 ;

si ig1 ;
  tleg0    = table ;
  tleg0 . 2 = mot 'TIRR MARQ ROND' ;
  tleg0 . 3 = mot 'TIRR' ;
  dess (comp1 et trac1 et cisa1) lege tleg0
    titr ' Courbes compression (bleue), traction (rouge) et cisaillement' ;
fins ;

* Defimition du modele et materiau :
mo1      = mode jt1 mecanique elastique plastique joint_soft joi2 ;
ma1      = mate mo1 'KS' 1.      'KN' 2.      'PNOR' -0.5 'CPLG' 0. 'BETA' 1. 
                    'SJCB' comp1 'SJTB' trac1 'SJSB' cisa1 ;

* Blocages :
cl1      = bloq depl l1 ;
cl2      = bloq ux   l2 ;
cl3      = bloq uy   l2 ;

*----------------------------------------------------------------------*
*                   VALIDATION EN COMPRESSION SIMPLE                   *
*----------------------------------------------------------------------*

* Compression simple :
dcl3     = depi cl3 -0.5 ;
dcl0     = dcl3 ;
ev1      = evol manu temp (prog 0. 1.) (prog 0. 1.) ;
cgu1     = char dimp dcl0 ev1 ;

* Resolution avec PASAPAS :
tab1                      = table ;
tab1. modele              = mo1 ;
tab1. caracteristiques    = ma1 ;
tab1. blocages_mecaniques = cl1 et cl2 et cl3 ;
tab1. chargement          = cgu1 ;
tab1. temps_calcules      = prog 0. pas 0.1 1. ;

pasapas tab1 ;

* Validation solution :
evf1     = evol temp tab1 reactions 'FY' (l2 poin 1) ;
evf2     = evol temp tab1 reactions 'FY' (l2 poin 2) ;
evf1     = evf1 + evf2 ;
evu1     = evol temp tab1 deplacements 'UY' (l2 poin 1) ;
lu1      = extr evu1 ordo ;
lf1      = extr evf1 ordo ;
evfu1    = evol manu uy (abs lu1) fy (abs lf1) ;

si ig1 ;
  tleg1    = table ;
  tleg1. 2 = mot 'MARQ TRIA TIRC' ;
  tleg1. titre = table ;
  tleg1. titre . 1 = 'Reference' ;
  tleg1. titre . 2 = 'Calcul' ;
  dess (comp1 et evfu1) lege tleg1 titr ' Comparaison calcul / reference compression simple ' ;
fins ;

* Test validation :
err1     = ((abs lf1) - (ipol comp1 (abs lu1))) maxi abs ;
err1     = err1 / (maxi abs lf1) ;

si (err1 > 1.e-8) ;
  comm erre 5 ;
fins ;

*----------------------------------------------------------------------*
*                     VALIDATION EN TRACTION SIMPLE                    *
*----------------------------------------------------------------------*

* Compression simple :
dcl3     = depi cl3 +0.5 ;
dcl0     = dcl3 ;
cgu1     = char dimp dcl0 ev1 ;

* Resolution avec PASAPAS :
tab2                      = table ;
tab2. modele              = mo1 ;
tab2. caracteristiques    = ma1 ;
tab2. blocages_mecaniques = cl1 et cl2 et cl3 ;
tab2. chargement          = cgu1 ;
tab2. temps_calcules      = prog 0. pas 0.2 1. ;

pasapas tab2 ;

* Validation solution :
evf1     = evol temp tab2 reactions 'FY' (l2 poin 1) ;
evf2     = evol temp tab2 reactions 'FY' (l2 poin 2) ;
evf2     = evf1 + evf2 ;
evu2     = evol temp tab2 deplacements 'UY' (l2 poin 1) ;
lu2      = extr evu2 ordo ;
lf2      = extr evf2 ordo ;
evfu2    = evol manu uy (abs lu2) fy (abs lf2) ;

si ig1 ;
  tleg2    = table ;
  tleg2. 2 = mot 'MARQ TRIA TIRC' ;
  tleg2. titre = table ;
  tleg2. titre . 1 = 'Reference' ;
  tleg2. titre . 2 = 'Calcul' ;
  dess (trac1 et evfu2) lege tleg2 ybor 0. 0.25
    titr ' Comparaison calcul / reference traction simple ' ;
fins ;

* Test validation :
err1     = ((abs lf2) - (ipol trac1 (abs lu2))) maxi abs ;
err1     = err1 / (maxi abs lf2) ;

si (err1 > 1.e-8) ;
  comm erre 5 ;
fins ;

*----------------------------------------------------------------------*
*                      VALIDATION EN CISAILLEMENT                      *
*----------------------------------------------------------------------*

* Compression simple :
dcl2     = depi cl2 +0.5 ;
dcl0     = dcl2 ;
ev1      = evol manu temp (prog 0. 1.) (prog 0. 1.) ;
cgu1     = char dimp dcl0 ev1 ;

* Resolution avec PASAPAS :
tab3                      = table ;
tab3. modele              = mo1 ;
tab3. caracteristiques    = ma1 ;
tab3. blocages_mecaniques = cl1 et cl2 et cl3 ;
tab3. chargement          = cgu1 ;
tab3. temps_calcules      = prog 0. pas 0.1 1. ;

pasapas tab3 ;

* Validation solution :
evf1     = evol temp tab3 reactions 'FX' (l2 poin 1) ;
evf2     = evol temp tab3 reactions 'FX' (l2 poin 2) ;
evf3     = evf1 + evf2 ;
evu3     = evol temp tab3 deplacements 'UX' (l2 poin 1) ;
lu3      = extr evu3 ordo ;
lf3      = extr evf3 ordo ;
evfu3    = evol manu UX (abs lu3) FX (abs lf3) ;

si ig1 ;
  tleg3    = table ;
  tleg3. 2 = mot 'MARQ TRIA TIRC' ;
  tleg3. titre = table ;
  tleg3. titre . 1 = 'Reference' ;
  tleg3. titre . 2 = 'Calcul' ;
  dess (cisa1 et evfu3) lege tleg3 ybor 0. 0.12
   titr ' Comparaison calcul / reference cisaillement simple ' ;
fins ;

* Test validation :
err1     = ((abs lf3) - (ipol cisa1 (abs lu3))) maxi abs ;
err1     = err1 / (maxi abs lf3) ;

si (err1 > 1.e-8) ;
  comm erre 5 ;
fins ;

*----------------------------------------------------------------------*
*                      TEST FONCTIONNEMENT MIXTE                       *
*----------------------------------------------------------------------*

* Activation du coefficient de couplage pour test fonctionnement :
ma1      = mate mo1 'KS' 1.      'KN' 2.      'PNOR' -0.5 'CPLG' 1. 'BETA' 1. 
                    'SJCB' comp1 'SJTB' trac1 'SJSB' cisa1 ;

* Compression simple :
dcl2     = depi cl2 +0.3 ;
dcl3     = depi cl3 -0.5 ;
dcl0     = dcl2 et dcl3 ;
ev1      = evol manu temp (prog 0. 1.) (prog 0. 1.) ;
cgu1     = char dimp dcl0 ev1 ;

* Resolution avec PASAPAS :
tab4                      = table ;
tab4. modele              = mo1 ;
tab4. caracteristiques    = ma1 ;
tab4. blocages_mecaniques = cl1 et cl2 et cl3 ;
tab4. chargement          = cgu1 ;
tab4. temps_calcules      = prog 0. pas 0.1 1. ;

pasapas tab4 ;

* Validation solution :
evf1     = evol temp tab4 reactions 'FX' (l2 poin 1) ;
evf2     = evol temp tab4 reactions 'FX' (l2 poin 2) ;
evf4     = evf1 + evf2 ;
evu4     = evol temp tab4 deplacements 'UX' (l2 poin 1) ;
lu4      = extr evu4 ordo ;
lf4      = extr evf4 ordo ;
evfux4   = evol manu UX (abs lu4) FX (abs lf4) ;
evf1     = evol temp tab4 reactions 'FY' (l2 poin 1) ;
evf2     = evol temp tab4 reactions 'FY' (l2 poin 2) ;
evf4     = evf1 + evf2 ;
evu4     = evol temp tab4 deplacements 'UY' (l2 poin 1) ;
lu4      = extr evu4 ordo ;
lf4      = extr evf4 ordo ;
evfuy4   = evol manu UY (abs lu4) FY (abs lf4) ;

si ig1 ;
  tleg4    = table ;
  tleg4. 3 = mot 'MARQ TRIA TIRC' ;
  tleg4. 4 = mot 'MARQ ROND TIRC' ;
  tleg4. titre = table ;
  tleg4. titre . 1 = 'Ref. compression' ;
  tleg4. titre . 2 = 'Ref. cisaillement' ;
  tleg4. titre . 3 = 'Calcul Fx(Ux)' ;
  tleg4. titre . 4 = 'Calcul Fy(Uy)' ;
  dess (comp1 et cisa1 et evfux4 et evfuy4) lege tleg4
    titr ' Comparaison calcul / references chargement compression + cisaillement' ;
fins ;

*-------------- F I N   J O I N T S O F T 1 . D G I B I ---------------*
fin ;
 

 

 

