*  fichier: rela_non_associee.dgibi
*  test d'utilisation d'une relation non associee
*
*  on veut controler le deplacement d'un point intermediaire d'une barre en appliquant
*  une force a l'extremite
*  juste pour le fun on le traite en probleme unilateral et on teste la reaction
*
optio dime 2 elem qua4; dens 1;

*   maillage
gau = (0 0)        ;
pc = (1 0);
droi = (3 0);
e1 = gau d 1 pc;
e2 = pc d 1 droi;

*   comportement
mo = model (e1 et e2) mecanique elastique barr;
ma = mater mo young 1 nu 1 sect 1;

*   raideur mecanique du systeme
ri = rigi mo ma;
bl0= (bloq ux    gau)                                  ;
bl1= (bloq    uy gau)                                  ;
bl2=                     (bloq uy pc)                  ;
bl3=                                     (bloq uy droi);
rit = ri et bl0 et bl1 et bl2 et bl3;

*   force de controle
fo = force (-1 0) droi;
fo = fo exco fx fx;

*   relation a imposer
cp = manu chpo pc 1 ux 1;
re = rela maxi cp dual fo ;
list re;

*   second membre
imp = (depi re 1) et (fo * -2) ;

*   resolution
dep = resou imp (rit et re);

*  verif deplacement au noeud droi;
*  on doit trouver 3

d3 = extr dep droi 'UX';
si (((d3 - 3) abs) > 1d-10);
  mess 'deplacement incorrect ' (d3 - 3);
  erreur 5;
finsi;
pmult = extrai re maillage  mult ;
l9 = (dep extrai valeur pmult 'LX') extrai 1;
si (((l9 - 1) abs) > 1d-10);
  mess 'reaction incorrecte ' (l9 - 1);
  erreur 5;
finsi;
fin;

 

 

