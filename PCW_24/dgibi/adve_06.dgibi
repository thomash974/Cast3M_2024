* fichier : adve_06.dgibi
************************************************************************
* Section : Diffusion Advection
************************************************************************
* Cas-test de l'operateur ADVEction dans la formulation DIFFUSION      *
*                                                                      *
* On resout : v.gradC = 4,                                             *
*                                                                      *
* Avec : vx=1, vy=1                                                    *
* on a : dC/dx + dC/dy = 4                                             *
*                                                                      *
* De + : C(1,0)=0, C(0,1)=0                                            *
* Sur 1 element QUA4 de geometrie carree et de cote 1.                 *
*                                                                      *
* La solution analytique est : C(x,y) = 2(x+y-1)                       *
* Soit : C(0,0)=C(P1)=-2 et C(1,1)=C(P3)=2                             *
*                                                                      *
***************************************************
** TESTING FILE FOR THE OPERATOR ADVE BUILDING A  *
** NON-SYMMETRIC STIFFNESS MATRIX                 *
***************************************************

OPTI DIME 2 ELEM qua4 MODE PLAN CONT ;
p1     = 0. 0. ;
p2     = 1. 0. ;
p3     = 1. 1. ;
p4     = 0. 1. ;
LI1    = droite 1 p1 p2 ;
LI2    = droite 1 p2 p3 ;
LI3    = droite 1 p3 p4 ;
LI4    = droite 1 p1 p4 ;

SU     = DALL LI1 LI2 LI3 LI4 ;
MOD1   = MODE SU DIFFUSION ISOTROPE ADVECTION ;
jj     = MATE MOD1 'VITX' 1. 'VITY' 1. ;
matno1 = ADVE mod1 JJ ;
list matno1;

* Matrice elementaire numero   : 1 ( ligne1,ligne2,ligne3...)
* -0.33333E+00  0.83333E-01  0.16667E+00  0.83333E-01 ;
* -0.25000E+00  0.00000E+00  0.25000E+00  0.00000E+00 ;
* -0.16667E+00 -0.83333E-01  0.33333E+00 -0.83333E-01 ;
* -0.25000E+00  0.00000E+00  0.25000E+00  0.00000E+00 ;

* Le flux surfacique :
vec1 ='SOUR' MOD1 SU 4. ;

* Les concentrations imposees :
BL2  = BLOQ 'CO' P2 ;
BL4  = BLOQ 'CO' P4 ;

*A linear system is solved with a non-symmetric matrix
SOL7 = RESO (matno1 et (bl2 et bl4)) vec1 ;

* Verification :
CP1  = -2. ;
CP3  = +2. ;
ERR1 = ABS((EXTRAIRE SOL7 'CO' P1) - CP1) ;
ERR2 = ABS((EXTRAIRE SOL7 'CO' P3) - CP3) ;
SI ((ERR1+ERR2) > 1.E-10);
  ERRE 5 ;
* MESS '###### TEST NOT PASSED ######';
SINON ;
  ERRE 0 ;
* MESS '###### TEST PASSED ######';
FINSI ;

*****************************************
matno1 = ADVE mod1 JJ 'SYMM';
list matno1;

* Matrice elementaire numero   : 1 ( ligne1,ligne2,ligne3...)
* -0.33333E+00 -0.83333E-01 0.00000E+00 -0.83333E-01
* -0.83333E-01  0.00000E+00 0.83333E-01  0.00000E+00
*  0.00000E+00  0.83333E-01 0.33333E+00  0.83333E-01
* -0.83333E-01  0.00000E+00 0.83333E-01  0.00000E+00

FIN;
 

