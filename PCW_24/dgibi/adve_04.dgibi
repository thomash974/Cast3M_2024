* fichier : adve_04.dgibi
************************************************************************
* Section : Diffusion Advection
************************************************************************
* Cas-test de l'operateur ADVEction dans la formulation DIFFUSION      *
*                                                                      *
* Comparaison a une solution analytique.                               *
*                                                                      *
* On calcule la concentration d'un fluide qui s'ecoule dans un tuyau   *
* chauffe sur toute sa longueur.                                       *
* On verifie la concentration du fluide en sortie du tuyau.            *
*                                                                      *
* Le flux lineique est de         : 500 mol/m-3/m-1                    *
* La concentration en entree est de : 20mol.m-3                        *
* La vitesse d'ecoulement est de  : 25 cm/s                            *
* La section du tuyau est de      : 5.e-5 m2, diametre ~ 8 mm          *
* La longueur du tuyau est de     : 5 m                                *
*                                                                      *
* La concentration attendue en sortie est de : 70mol.m-3               *
*                                                                      *
* On utilise les elements lineaires et quadratiques (TUY2,TUY3)        *
*                                                                      *
*----------------------------------------------------------------------*
'OPTI' 'DIME' 3 'ELEM' 'SEG2' ;
*                                                                      *
* Commentez cette ligne pour voir les traces :                         *
'OPTI' 'TRAC' 'PSC' ;
*                                                                      *
O1       = 0 0 0 ;
X1       = 1 0 0 ;
P1       = 2.5 * X1 ;
P2       = 5.0 * X1 ;
Y1       = 0 1 0 ;
Z1       = 0 0 1 ;
*                                                                      *
L1       = O1 'DROI' 5 P1 'COUL' 'VERT' ;
L2       = P1 'DROI' 10 P2 ;
L2       = 'CHAN' 'QUAD' L2 'COUL' 'BLEU' ;
'TITR' ' Maillage du tuyau, longueur = 5 m (Vert=SEG2,Bleu=SEG3) ' ;
'TRAC' 'QUAL' (L1 'ET' L2) ;
*                                                                      *
mo1      ='MODE' L1 diffusion advection 'TUY2' ;
mo2      ='MODE' L2 diffusion advection 'TUY3' ;
mo1      = mo1 'ET' mo2 ;
*                                                                      *
L0       = L1 'ET' L2 ;
*
* Le flux advectee dans un tuyau est J = Cdif.Sect.V :                 *
ma1      = 'MATE' mo1 'CDIF' 4.e6 'VITE' 0.25 'SECT' 5.e-5 ;
*                                                                      *
sq1      = 'SOUR' mo1 ma1 L0 (5.e2 / 5.e-5) ;
list (MAXI (resu sq1));
'TITR' ' Terme source le long du tuyau ' ;
'DESS' ('EVOL' 'VERT' 'CHPO' sq1 L0 'QCO') 'YBOR' 0. 300. ;
*                                                                      *
KA1      = 'ADVE' mo1 ma1 ;
*                                                                      *
cl1      = 'BLOQ' 'CO' O1 ;
dcl1     = 'DEPI' cl1 20. ;
*                                                                      *
chC2     = 'RESO' (ka1 'ET' cl1) (sq1 'ET' dcl1);
*                                                                      *
'TITR' ' Evolution de la concentration le long du tuyau ' ;
'DESS' ('EVOL' 'VERT' 'CHPO' chC2 L0 'CO') ;
*                                                                      *
* Test :
cref1    = 70. ;
Cp1      = 'EXTR' chC2 'CO' P2 ;
err1     = 'ABS' (cREF1 - Cp1) / Cp1 ;
*                                                                      *
'OPTI' 'ECHO' 0 ;
'MESS' ;
mot1     = 'CHAI' ' > concentration calculee en  sortie = '
  'FORMAT' '(F3.0)' Cp1 'mol.m-3 pour 70mol.m-3 attendu ' ;
'MESS' mot1 ;
'MESS' ' > Erreur relative = ' err1 ;
'MESS' ;
'OPTI' 'ECHO' 1 ;
*                                                                      *
'SI' (err1 > 1.e-5) ;
  'ERRE' 5 ;
'SINO' ;
  'OPTI' 'ECHO' 0 ;
  'MESS' ;
  'MESS' ' > Test reussi ' ;
  'MESS' ;
'FINS' ;
*                                                                      *
'FIN' ;
 

