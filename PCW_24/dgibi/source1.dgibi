list err1 ;
si (err1 > 1.e-12) ;
  ERRE ' Probleme MODE SOURCE' ;
fins ;

* Coques :
* --------
*
mo1      = mode l2 thermique coq2 ;
ma1      = mate mo1 k 1 epai 0.01 ;

moq1     = mode l2 thermique source coq2 ;
maq1     = mate moq1 'QVOL' 1. 'QINF' 1. 'QSUP' 1. epai 0.01 ;

sq1      = sour moq1 maq1 ;
sqref1   = sour mo1 l2 1. ma1 ;

err1     = (maxi abs (sq1 - sqref1)) / (maxi abs sqref1) ;
list err1 ;
si (err1 > 1.e-12) ;
  ERRE ' Probleme MODE SOURCE' ;
fins ;

