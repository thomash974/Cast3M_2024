*------------------------ 3D ELEMENTS LINEAIRES -----------------------*
*
opti dime 3 elem cub8 ;
s0       = s0 chan line ;
l2       = l2 chan line ;

v0       = s0 volu tran 5 (0 0 ep1) ;
x1       = v0 coor 1 ;
v3       = v0 elem appu stri (x1 poin supe (1.5 * lo1)) ;
v0       = v0 diff v3 ;
v0       = v0 et (v3 chan tet4) ;

el1      = (v0 elem cub8) elem 1 ;
py1      = (el1 chan quaf) chan pyr5 ;
v0       = (v0 diff el1) et py1 ;

* Massifs :
*----------
*
mo1      = mode v0 thermique ;
ma1      = mate mo1 k 25. ;

moq1     = mode v0 thermique source ;
maq1     = mate moq1 'QVOL' 1. ;

sq1      = sour moq1 maq1 ;
sqref1   = sour mo1 v0 1. ;

err1     = (maxi abs (sq1 - sqref1)) / (maxi abs sqref1) ;
list err1 ;
si (err1 > 1.e-12) ;
  ERRE ' Probleme MODE SOURCE' ;
fins ;

