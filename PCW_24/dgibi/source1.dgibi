*------------------------ 2D ELEMENTS LINEAIRES -----------------------*
*
opti dime 2 elem qua4 ;

ep1      = 10.e-3 ;
l1       = (0 0) droi 10 (0 ep1) ;
s1       = l1    tran 50 (lo1 0) ;
l2       = s1 cote 3 ;
s2       = l2    tran 50 (lo1 ep1) ;
s2       = s2 chan tri3 ;
s0       = s1 et s2 ;

*trac s0 titr ' Maillage test' ;

opti mode plan ;
*
* Massifs :
* ---------
*
mo1      = mode s0 thermique ;
ma1      = mate mo1 k 25. ;

moq1     = mode s0 thermique source ;
maq1     = mate moq1 'QVOL' 1. ;

sq1      = sour moq1 maq1 ;
sqref1   = sour mo1 s0 1. ;

err1     = (maxi abs (sq1 - sqref1)) / (maxi abs sqref1) ;
list err1 ;
si (err1 > 1.e-12) ;
  ERRE ' Probleme MODE SOURCE' ;
fins ;

* Barres :
* --------
*
mo1      = mode l2 thermique barr ;
ma1      = mate mo1 k 1 sect 0.01 ;

moq1     = mode l2 thermique source barr ;
maq1     = mate moq1 'QVOL' 1. sect 0.01 ;

sq1      = sour moq1 maq1 ;
sqref1   = sour mo1 l2 1. ma1 ;

err1     = (maxi abs (sq1 - sqref1)) / (maxi abs sqref1) ;
list err1 ;
si (err1 > 1.e-12) ;
  ERRE ' Probleme MODE SOURCE' ;
  ERRE ' Probleme MODE SOURCE' ;
  ERRE ' Probleme MODE SOURCE' ;
fins ;

* Tuyaux :
* --------
*
mo1      = mode l2 thermique tuy2 ;
ma1      = mate mo1 k 1 sect 0.01 ;

moq1     = mode l2 thermique source tuy2 ;
maq1     = mate moq1 'QVOL' 1. sect 0.01 ;


sq1      = sour moq1 maq1 ;
sqref1   = sour mo1 l2 1. ma1 ;

