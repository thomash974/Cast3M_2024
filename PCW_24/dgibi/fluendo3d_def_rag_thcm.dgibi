*-----------------------------------------------------------------------
lt0=prog;

tabn2=table;
tabn2.1='EPS1';
tabn2.2='EPS2';
tabn2.3='EPS3';
tabn2.4='EPS4';
tabn2.5='EPS5';
tabn2.6='EPS6';

tabl2=table;
tabl2.1=prog;
tabl2.2=prog;
tabl2.3=prog;
tabl2.4=prog;
tabl2.5=prog;
tabl2.6=prog;

tabe5=table;
tabe5.1=bleu;
tabe5.2=roug;
tabe5.3=rose;
tabe5.4=ROUG;
tabe5.5=CYAN;
tabe5.6=VERT;
tabe6=table;
tabe6.TITRE=table;
tabe6.TITRE.1='EPS1';
tabe6.TITRE.2='EPS2';
tabe6.TITRE.3='EPS3';
tabe6.TITRE.4='EPS4';
