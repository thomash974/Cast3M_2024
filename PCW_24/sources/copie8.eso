C COPIE8    SOURCE    CB215821  19/07/30    21:15:42     10273          

      SUBROUTINE COPIE8 (IPOIN1,IPOIN2)

************************************************************************
*
*                             C O P I E 8
*                             -----------
*
* FONCTION:
* ---------
*
*     CREER UNE COPIE D'UN OBJET DE TYPE "MCHAML".
*
* MODE D'APPEL:
* -------------
*
*     CALL COPIE8 (IPOIN1,IPOIN2)
*
* PARAMETRES:  (E)=ENTREE   (S)=SORTIE
* -----------
*
*     IPOIN1  ENTIER    (E)  POINTEUR DE L'OBJET A COPIER.
*     IPOIN2  ENTIER    (S)  POINTEUR DE LA COPIE.
*
* LANGAGE:
* --------
*
*     ESOPE + FORTRAN77
*
************************************************************************
*
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8(A-H,O-Z)

-INC SMCHAML

      MCHEL1 = IPOIN1
      SEGINI,MCHELM=MCHEL1
      IPOIN2 = MCHELM
      NSOUS  = IMACHE(/1)

      DO 100 IA=1,NSOUS
         MCHAM1=ICHAML(IA)
         SEGINI,MCHAML=MCHAM1
         ICHAML(IA)=MCHAML
         DO 110 ICOMP=1,IELVAL(/1)
            MELVA1 = IELVAL(ICOMP)
            SEGINI,MELVAL=MELVA1
            IELVAL(ICOMP) = MELVAL
  110    CONTINUE
  100 CONTINUE

      END

 
