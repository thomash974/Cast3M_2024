C MAMU23    SOURCE    PV090527  24/01/03    21:15:09     10699          
      subroutine mamu23(long,val11,lpl1,val1,lpl,pt)
      implicit real*8 (a-h,o-z)
      real*8 val11(*),val1(*)
      real*8 pt(36)
           id12=lpl1
           id13=lpl1+lpl1+1
           id2=lpl
           pt1=pt(1)
           pt2=pt(2)
           pt3=pt(3)
           pt4=pt(4)
           pt5=pt(5)
           pt6=pt(6)
           do 110 i=1,long
              xval1=val1(i)
              xval11=val11(i)
              pt1=pt1+xval1*xval11
              xval12=val11(i+id12)
              pt2=pt2+xval1*xval12
              xval13=val11(i+id13)
              pt3=pt3+xval1*xval13
              xval2=val1(i+id2)
              pt4=pt4+xval2*xval11
              pt5=pt5+xval2*xval12
              pt6=pt6+xval2*xval13
 110       continue
           pt(1)=pt1
           pt(2)=pt2
           pt(3)=pt3
           pt(4)=pt4
           pt(5)=pt5
           pt(6)=pt6



           end

 
 
 
 
 
 
 
