             SUBROUTINE MODCLI(MOMODL,NMOD)
*----------------------------------------------------------------------
*     -  CAS DE LA FORMULATION 'CONTRAINTE'
*            DEFINITION Du comportement global
*----------------------------------------------------------------------
      IMPLICIT INTEGER(I-N)

-INC PPARAM
-INC CCOPTIO
*
      CHARACTER*16 MOMODL(*)
*
*     Noms des modeles
*
      NMOD=3
      MOMODL(1)='ROTATION'
      MOMODL(2)='DEPLACEMENT'
      MOMODL(3)='RELATION'
      RETURN
      END



 
