C MADJAC    SOURCE    PV        20/03/30    21:20:55     10567          
      SUBROUTINE MADJAC(MEL1,MEL2,LOG1)
C
C     Cette routine permet de tester si les maillages elmentaires
C     pointes par MEL1 et MEL2 sont adjacents
C
C     Les segments MEL1 et MEL2 doivent etre actifs et
C     sont rendus actifs
C
C     C. La Borderie Juin 1992.
C
C
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8(A-H,O-Z)

-INC PPARAM
-INC CCOPTIO
-INC SMELEME
-INC SMCOORD
      SEGMENT SLCPR
         LOGICAL LCPR (NN1)
      END SEGMENT
      INTEGER NBELE,NBNOEU,IELE,JNOEU,NUMIJ
      LOGICAL LOG1
C
C
      NN1= nbpts
      SEGINI SLCPR
C
C
      MELEME=MEL1
      NBELE=NUM(/2)
      NBNOE=NUM(/1)
      DO IELE=1,NBELE
         DO JNOEU=1,NBNOE
             NUMIJ=NUM(JNOEU,IELE)
             LCPR(NUMIJ)=.TRUE.
         END DO
      END DO
C
C
      MELEME=MEL2
      NBELE=NUM(/2)
      NBNOE=NUM(/1)
      LOG1=.FALSE.
      IELE=0
      DO WHILE ((.NOT. LOG1) .AND. (IELE .LT. NBELE))
         IELE=IELE+1
         DO JNOEU=1,NBNOE
             NUMIJ=NUM(JNOEU,IELE)
             LOG1=LOG1 .OR. LCPR(NUMIJ)
         END DO
      END DO
      SEGSUP SLCPR
      RETURN
      END






 
