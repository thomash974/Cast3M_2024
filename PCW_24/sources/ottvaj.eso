C OTTVAJ    SOURCE    FD218221  21/06/10    21:15:53     11030          
      SUBROUTINE OTTVAJ(FIL,XVAL,VF1,TAIL,P,KFH,IERUT)
*
      IMPLICIT INTEGER (I-N)
      IMPLICIT REAL*8 (A-H,O-Z)
      PARAMETER (XZER=0.D0,UN=1.D0,DEUX=2.D0)
      PARAMETER (XPI = 3.1415926535897931D0)
      DIMENSION FIL(*),XVAL(*),VF1(*),TAIL(*),P(*)
*
      IERUT=0
      YOUN  = XVAL(1)
      XNU   = XVAL(2)
      XLTR  = XVAL(3)
      GFTR  = XVAL(4)
      WO1=TAIL(1)*VF1(1)*VF1(1)+TAIL(2)*VF1(2)*VF1(2)
      WO1=WO1+TAIL(3)*VF1(3)*VF1(3)+DEUX*TAIL(4)*VF1(2)*VF1(1)
      WO1=WO1+DEUX*TAIL(5)*VF1(1)*VF1(3)
      WO1=WO1+DEUX*TAIL(6)*VF1(2)*VF1(3)
      WO2=P(1)*VF1(1)*VF1(1)+P(2)*VF1(2)*VF1(2)+P(3)*VF1(3)*VF1(3)
      WO2=WO2+DEUX*P(4)*VF1(2)*VF1(1)+DEUX*P(5)*VF1(1)*VF1(3)
      WO2=WO2+DEUX*P(6)*VF1(2)*VF1(3)
      IF (WO1.NE.XZER) THEN
         FIL(KFH)=ABS(WO2/WO1)
         IF (FIL(KFH).LE
     &         .((UN+XNU)*XLTR*XLTR/(DEUX*GFTR*YOUN))) THEN
            IERUT=2
            RETURN
         ENDIF
      ELSE
         FIL(KFH)=UN
      ENDIF
      RETURN
      END
 
