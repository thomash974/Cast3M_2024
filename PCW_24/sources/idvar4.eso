              SEGINI,NOMID
              LESOBL( 1)='X1N1'
              LESOBL( 2)='X1N2'
              LESOBL( 3)='X1N3'
              LESOBL( 4)='X1M1'
              LESOBL( 5)='X1M2'
              LESOBL( 6)='X1M3'
              LESOBL( 7)='X2N1'
              LESOBL( 8)='X2N2'
              LESOBL( 9)='X2N3'
              LESOBL(10)='X2M1'
              LESOBL(11)='X2M2'
              LESOBL(12)='X2M3'
              LESOBL(13)='GPN1'
              LESOBL(14)='GPN2'
              LESOBL(15)='GPN3'
              LESOBL(16)='GPM1'
              LESOBL(17)='GPM2'
              LESOBL(18)='GPM3'
              LESOBL(19)='EPN1'
