          LESOBL(15)='QQQ '
          LESOBL(16)='QQ  '
C =====
C  1.7 - Formulation UNIAXIALE
C =====
        ELSE IF (MFR.EQ.27) THEN
          NBROBL=8
          SEGINI,NOMID
          LESOBL(1)='X1FX'
