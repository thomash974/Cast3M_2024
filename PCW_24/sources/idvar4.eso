            LESOBL( 2)='X1TT'
            LESOBL( 3)='X1NN'
            LESOBL( 4)='X1ST'
            LESOBL( 5)='X1SN'
            LESOBL( 6)='X1TN'
            LESOBL( 7)='X2SS'
            LESOBL( 8)='X2TT'
            LESOBL( 9)='X2NN'
            LESOBL(10)='X2ST'
            LESOBL(11)='X2SN'
            LESOBL(12)='X2TN'
            LESOBL(13)='GPSS'
            LESOBL(14)='GPTT'
            LESOBL(15)='GPNN'
            LESOBL(16)='GPST'
