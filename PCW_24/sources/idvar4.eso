            LESOBL(27)='QQQ '
            LESOBL(28)='QQ  '
          ENDIF
C =====
C  1.5 - Element COQUE CISAILLEMENT TRANSVERSE
C =====
        ELSE IF (MFR.EQ.9) THEN
C= Mode de calcul TRIDIMENSIONNEL
          IF (NPINT.EQ.0) THEN
            IF (IFOUR.EQ.2) THEN
              NBROBL=36
              SEGINI,NOMID
              LESOBL( 1)='X1N1'
              LESOBL( 2)='X1N2'
              LESOBL( 3)='X1N3'
              LESOBL( 4)='X1M1'
              LESOBL( 5)='X1M2'
              LESOBL( 6)='X1M3'
              LESOBL( 7)='X1V1'
              LESOBL( 8)='X1V2'
              LESOBL( 9)='X2N1'
              LESOBL(10)='X2N2'
              LESOBL(11)='X2N3'
              LESOBL(12)='X2M1'
