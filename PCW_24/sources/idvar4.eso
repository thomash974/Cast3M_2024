            LESOBL(25)='EPSE'
            LESOBL(26)='RR  '
            LESOBL(27)='QQQ '
            LESOBL(28)='QQ  '
C= 1.1.4 - Cas TRIDIMENSIONNEL
          ELSE IF (IFOUR.EQ.2) THEN
            NBROBL=28
            SEGINI,NOMID
            LESOBL( 1)='X1XX'
            LESOBL( 2)='X1YY'
            LESOBL( 3)='X1ZZ'
            LESOBL( 4)='X1XY'
            LESOBL( 5)='X1YZ'
            LESOBL( 6)='X1ZX'
            LESOBL( 7)='X2XX'
            LESOBL( 8)='X2YY'
            LESOBL( 9)='X2ZZ'
            LESOBL(10)='X2XY'
            LESOBL(11)='X2YZ'
            LESOBL(12)='X2ZX'
            LESOBL(13)='GPXX'
            LESOBL(14)='GPYY'
            LESOBL(15)='GPZZ'
            LESOBL(16)='GPXY'
            LESOBL(17)='GPYZ'
            LESOBL(18)='GPZX'
