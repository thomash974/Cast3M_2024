              LESOBL(17)='EPSE'
              LESOBL(18)='RR  '
              LESOBL(19)='QQQ '
              LESOBL(20)='QQ  '
            ENDIF
          ENDIF
C =====
C  1.3 - Element COQUE EPAISSE
C =====
        ELSE IF (MFR.EQ.5) THEN
C= Mode de calcul TRIDIMENSIONNEL
          IF (IFOUR.EQ.2) THEN
            NBROBL=28
            SEGINI,NOMID
