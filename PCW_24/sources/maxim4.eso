C MAXIM4    SOURCE    CB215821  20/11/25    13:34:09     10792          
      SUBROUTINE MAXIM4 (MCHPOI,COEFP,COEFPI)
* ---------------------------------------------------------------------
*   enleve sur un chpoint la normalisation des composantes p et pi
*   farvacque. juin 1986
*   les valeurs du chpoint sont modifiees
*
*----------------------------------------------------------------------
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8 (a-h,o-z)

-INC PPARAM
-INC CCOPTIO
-INC SMCHPOI
      REAL*8 COEFP,COEFPI
*
      CHARACTER*(LOCOMP) ICOMP
*
      SEGACT MCHPOI
      DO 100 IB100=1,IPCHP(/1)
          MSOUPO = IPCHP(IB100)
          SEGACT,MSOUPO
          NC = NOCOMP(/2)
          MPOVAL = IPOVAL
          SEGACT,MPOVAL*MOD
          N = VPOCHA(/1)
          DO 120 IB120=1,NC
              ICOMP=NOCOMP(IB120)
              IF(ICOMP.EQ.'P   ') THEN
                  COEF= COEFP
              ELSE IF (ICOMP.EQ.'PI  ') THEN
                  COEF= COEFPI
              ELSE
                  GOTO 120
              ENDIF
              DO 130 IB130=1,N
                  VPOCHA(IB130,IB120)=VPOCHA(IB130,IB120)*COEF
  130         CONTINUE
  120     CONTINUE
  100 CONTINUE
      RETURN
      END
 
