C X12X6     SOURCE    FD218221  24/02/07    21:15:31     11834          
        subroutine x12x6(E3,V33,E6)

c       reconstruction d une tenseur en base fixe a partir
c       des valeurs principales et des vecteurs principaux

c       declarations externes
        implicit integer(i-n)
        implicit real*8(a-h,o-z)

        real*8 E3(3),V33(3,3),E6(6)
        
        integer i,j,k
        real*8 E33(3,3),D33(3,3,3)

c       passage de E en base fixe
        do j=1,3
             do k=1,3
                 E33(j,k)=0.d0
             end do
        end do
        call orie3d(V33,D33)
        do i=1,3
            do j=1,3
                do k=1,3
                    E33(j,k)=E33(j,k)+E3(i)*D33(i,j,k)
                end do
            end do    
        end do
c       ecriture des deformations en pseudo vecteur
        call x33x6(E33,E6)
        return
        end 
