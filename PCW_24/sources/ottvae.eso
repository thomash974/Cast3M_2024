C OTTVAE    SOURCE    FD218221  21/06/10    21:15:48     11030          
      SUBROUTINE OTTVAE(X,EET,XVAL,NDEF,SS,IERUT)
*
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8 (A-H,O-Z)
      DIMENSION EET(*),XVAL(*)
      DIMENSION EE(6),SS(6),DD(6,6)
*
      YOUN  = XVAL(1)
      XNU   = XVAL(2)
      DO I=1,NDEF
         EE(I)=X*EET(I)
      ENDDO
      CALL ZERO(DD,6,6)
      GKK = YOUN/3.D0/(1.D0-2.D0*XNU)
      GMU = YOUN/2.D0/(1.D0+XNU)
      DD(1,1) = GKK + 4.D0*GMU/3.D0
      DD(2,2) = DD(1,1)
      DD(3,3) = DD(1,1)
      DD(1,2) = GKK - 2.D0*GMU/3.D0
      DD(1,3) = DD(1,2)
      DD(2,3) = DD(1,2)
      DD(2,1) = DD(1,2)
      DD(3,1) = DD(1,2)
      DD(3,2) = DD(1,2)
      DD(4,4) = GMU
      IF(NDEF.GT.4) THEN
        DD(5,5) = GMU
        DD(6,6) = GMU
      ENDIF
      DO I=1,NDEF 
        SS(I)=0.D0
        DO J=1,NDEF
          SS(I)=SS(I)+DD(I,J)*EE(J)
        ENDDO
      ENDDO
      RETURN
      END

 
