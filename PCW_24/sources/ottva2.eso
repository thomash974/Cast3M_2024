C OTTVA2    SOURCE    FD218221  21/06/10    21:15:44     11030          
      SUBROUTINE OTTVA2(DEPSTT,NDEF,SIGI,
     &     VARI1,NVARI1,SIGF,VARF1,VARI2,VARF2,NVARI2,
     &     XVAL,NVAL,IERUT)
*
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8 (A-H,O-Z)
*
      DIMENSION DEPSTT(*),SIGI(*),SIGF(*),VARI1(*),VARI2(*)
      DIMENSION VARF1(*),VARF2(*),XVAL(*)
      DIMENSION SIG0(6),DEPST(6),VAR01(7),VAR02(15) 
*
      DO I=1,NDEF
        SIG0(I) =SIGI(I)
        DEPST(I)=DEPSTT(I)
      ENDDO
      DO I=1,NVARI1
        VAR01(I)=VARI1(I)
      ENDDO
      DO I=1,NVARI2
        VAR02(I)=VARI2(I)
      ENDDO
      DO I=1,3
        I2=2*I
        VAR01(I2-1)=VAR01(I2-1)*VAR02(I+12)
        VAR01(I2)=VAR01(I2)*VAR02(I+12)
      ENDDO
      CALL OTTVAL(SIG0,VAR01,NVARI1,DEPST,NDEF,
     &     SIGF,VARF1,XVAL,NVAL,VAR02,VARF2,NVARI2,IERUT)
      IF(IERUT.NE.0) RETURN
      DO I=1,3
        IF(VARF2(I+12).NE.0.D0) THEN
          I2=2*I
          VARF1(I2-1)=VARF1(I2-1)/VARF2(I+12)
          VARF1(I2)=VARF1(I2)/VARF2(I+12)
        ENDIF
      ENDDO
      RETURN
      END

 
