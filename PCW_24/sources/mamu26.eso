C MAMU26    SOURCE    PV        20/02/22    21:15:09     10531          
      subroutine mamu26(long,val11,lpl1,val1,lpl,pt)
      implicit real*8 (a-h,o-z)
      real*8 val11(*),val1(*)
      real*8 pt(36)
           id12=lpl1
           id13=lpl1+ lpl1+1
           id14=lpl1+ lpl1+1+ lpl1+2
           id15=lpl1+ lpl1+1+ lpl1+2+ lpl1+3
           id16=lpl1+ lpl1+1+ lpl1+2+ lpl1+3 +lpl1+4
           id2=lpl
           pt1=pt(1)
           pt2=pt(2)
           pt3=pt(3)
           pt4=pt(4)
           pt5=pt(5)
           pt6=pt(6)
           pt7=pt(7)
           pt8=pt(8)
           pt9=pt(9)
           pt10=pt(10)
           pt11=pt(11)
           pt12=pt(12)
           do 110 i=1,long
              xval1=val1(i)
              xval2=val1(i+id2)
              xval11=val11(i)
              xval12=val11(i+id12)
              xval13=val11(i+id13)
              xval14=val11(i+id14)
              xval15=val11(i+id15)
              xval16=val11(i+id16)
              pt1=pt1+xval1*xval11
              pt2=pt2+xval1*xval12
              pt3=pt3+xval1*xval13
              pt4=pt4+xval1*xval14
              pt5=pt5+xval1*xval15
              pt6=pt6+xval1*xval16
              pt7=pt7+xval2*xval11
              pt8=pt8+xval2*xval12
              pt9=pt9+xval2*xval13
              pt10=pt10+xval2*xval14
              pt11=pt11+xval2*xval15
              pt12=pt12+xval2*xval16
 110       continue
           pt(1)=pt1
           pt(2)=pt2
           pt(3)=pt3
           pt(4)=pt4
           pt(5)=pt5
           pt(6)=pt6
           pt(7)=pt7
           pt(8)=pt8
           pt(9)=pt9
           pt(10)=pt10
           pt(11)=pt11
           pt(12)=pt12

           end

 
 
 
 
 
 
