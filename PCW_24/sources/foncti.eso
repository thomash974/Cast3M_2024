C FONCTI    SOURCE    PV090527  23/11/10    21:15:02     11782          
      SUBROUTINE FONCTI
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8 (A-H,O-Z)
CC
CC    SOUS-PROGRAMME ASSOCIE  A L'OPERATEUR FONC
CC
CC    PR2 = FONC | 'FRESNEL'  | 'CX' | PR1
CC               |            | 'SX' |
CC
CC   PR1   OBJET DE TYPE LISTREEL
CC   PR2   OBJET DE TYPE LISTREEL
CC
CC
CC    OPERATEUR DESTINE AU CALCUL DE FONCTIONS DIVERSES
CC
CA    E. DE LANGRE
C
      CHARACTER*(7) CHA1
C

-INC PPARAM
-INC CCOPTIO
C
C
      CALL LIRCHA(CHA1,1,IRETOU)
      IF (IERR.NE.0) RETURN
      IF     ( CHA1(1:6).EQ.'BESSEL')  THEN
C       Cet operateur n'est plus disponible.
        WRITE(*,*) 'Voir operateur BESS'
        CALL ERREUR(598)

      ELSEIF ( CHA1(1:5).EQ.'GAMMA')  THEN
C       Cet operateur n'est plus disponible.
        WRITE(*,*) 'Voir operateur GAMM'
        CALL ERREUR(598)

      ELSEIF ( CHA1(1:7).EQ.'FRESNEL')  THEN
        CALL FOFREN

      ELSE
        CALL ERREUR(21)
      ENDIF
C
      RETURN
      END


 
 
