C MAMU13    SOURCE    PV        20/02/22    21:15:03     10531          
      subroutine mamu13(long,val11,lpl1,val1    ,pt)
      implicit real*8 (a-h,o-z)
      real*8 val11(*),val1(*)
      real*8 pt(36)
           id12=lpl1
           id13=lpl1+lpl1+1
           pt1=pt(1)
           pt2=pt(2)
           pt3=pt(3)
           do 110 i=1,long
              xval1=val1(i)
              xval11=val11(i)
              xval12=val11(i+id12)
              xval13=val11(i+id13)
              pt1=pt1+xval1*xval11
              pt2=pt2+xval1*xval12
              pt3=pt3+xval1*xval13
 110       continue
           pt(1)=pt1
           pt(2)=pt2
           pt(3)=pt3



           end

 
 
 
 
 
 
