************************************************************************
      subroutine zero3d(x,n,m)
c     mise a zero d une matrice quelconque      
      real*8 x(n,m)
      integer m,n,i,j
      do i=1,n
        do j=1,m
             x(i,j)=0.d0
        end do
      end do
      return
      end
      
 
