C GRACO14   SOURCE    PV        19/01/30    21:15:07     10089          
      SUBROUTINE GRACO14(ilideb,posm,valm,vect1,nbinc)
*  remontee de la resolution
      IMPLICIT INTEGER(I-N)
      IMPLICIT REAL*8(A-H,O-Z)
      integer ilideb(*),posm(*)
      real*8 valm(*),vect1(*)
      DO 2 idli=nbinc,1,-1
**     p=0.d0
**     do 5 i=ilideb(idli+1)-1,ilideb(idli)+1,-1
**      inc=posm(i)
**      p=p+valm(i)*vect1(inc)
** 5   continue
**     vect1(idli)=vect1(idli)-p
       id=ilideb(idli)+1
       if=ilideb(idli+1)-1
       lon=if-id+1
       if (lon.gt.0)
     >  vect1(idli)=vect1(idli)-ddotip(-lon,valm(id),posm(id),vect1(1))
   2  continue
      RETURN
      END



 
