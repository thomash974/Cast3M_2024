*     'FBB2'                                       INATU = 128       *
*     'KELVIN'                                     INATU = 174       *
*                                                                    *
*  VISCOPLASTIQUE                                                    *
*     'GUIONNET'                                   INATU = 17        *
*     'ONERA'                                      INATU = 25        *
*     'VISCODOMMAGE'                               INATU = 29        *
*     'PARFAIT'                                    INATU = 43        *
*     'POUDRE_A'                                   INATU = 44        *
