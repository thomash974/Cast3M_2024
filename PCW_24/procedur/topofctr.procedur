$$$$ TOPOFCTR
* TOPOFCTR  PROCEDUR  FD218221  23/11/29    21:15:08     11799          
* TOPOFCTR  PROCEDUR  CB215821  21/04/15    14:10:01     9715

************************************************************************
** Procedure called by TOPOPTIM for updating factor values.
**
** Author:
** Guenhael Le Quilliec (LaMe - Polytech Tours)
**
** Version:
** 1.0 2021/04/15
************************************************************************

DEBP TOPOFCTR tab0*'TABLE' ;

* Input data
* **********

wtab0 = tab0.'WTABLE' ;
bool0 = wtab0.'BOOL' ;

* Update factors
* **************

* Update D factor (Damping)
SI bool0.'FACTEUR_D_EVOL' ;
    wtab0.'FACTEUR_D' = IPOL (FLOT wtab0.'CYCLE') tab0.'FACTEUR_D' ;
FINS ;

* Update P factor
SI bool0.'FACTEUR_P_EVOL' ;
    wtab0.'FACTEUR_P' = IPOL (FLOT wtab0.'CYCLE') tab0.'FACTEUR_P' ;
FINS ;

* Update Q factor (or Gray Scale Factor)
SI bool0.'FACTEUR_Q_EVOL' ;
    wtab0.'FACTEUR_Q' = IPOL (FLOT wtab0.'CYCLE') tab0.'FACTEUR_Q' ;
FINS ;

FINP ;

$$$$
 
