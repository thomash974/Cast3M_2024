$$$$ USPOST
* USPOST    PROCEDUR  MB234859  24/02/06    21:15:04     11833          
************************************************************************
*                         PROCEDURE USPOST
*
* Procedure de post-traitement specifique aux calculs d'usure.
*
* Entrees :
*   T1    : Table de PASAPAS
*   ID_BU : Entier donnant le numero de la BOITE D'USURE a considerer
*
* Appelee par USEXPL ou USIMPL
*
************************************************************************
'DEBP' USPOST T1*'TABLE' ID_BU*'ENTIER'; 
*
  BOITE_US = T1.'BOITES_USURE' ; 
  CycActu  = BOITE_US.'INFOS'.'INDICE_CYCLE_ACTUEL' ;
  NbCycRe  = BOITE_US.'INFOS'.'NB_CYCLES_RESTANTS' ;
  SUR_APPL = BOITE_US. ID_BU .'SURFACE_APPLICATION' ;
*-----------------------------------------------------------------------
* - CYCLE CALCULE ET CYCLE REEL (VALEURS COMMUNES)
*-----------------------------------------------------------------------
  'SI' ('EGA' ID_BU 1) ;
    BOITE_US.'POST'.'CYCLES_CALCULES' = 
       BOITE_US.'POST'.'CYCLES_CALCULES' 'ET' CycActu ;
*
    NCycle = BOITE_US.'DONNEES'.'NB_CYCLES' ;
    BOITE_US.'POST'.'CYCLES_REELS' = 
       BOITE_US.'POST'.'CYCLES_REELS' 'ET' (NCycle '-' NbCycRe) ; 
  'FINSI' ;  
*-----------------------------------------------------------------------
* - PRESSION ET CISAILLEMENT MOYENS/MAX ET PROFONDEUR MAX
*-----------------------------------------------------------------------
  PresCum = 'ETG' BOITE_US. &BU .'PRESSION_CONTACT' ;
  PresMoy = BOITE_US.'INFOS'.'UNSURT' '*' PresCum ; 
  BOITE_US. ID_BU .'PRESSION_MOYENNE_CYCLE'. CycActu = PresMoy ;
*  
  BOITE_US. ID_BU .'PRESSION_MAX_CYCLE' =
    BOITE_US. ID_BU .'PRESSION_MAX_CYCLE' 'ET' 
     ('MAXI' BOITE_US. ID_BU .'PRESSION_MAX_INC') ;
*
  CisaCum = 'ETG' BOITE_US. &BU .'CISAILLEMENT' ;
  CisaMoy = BOITE_US.'INFOS'.'UNSURT' '*' CisaCum ;
  BOITE_US. ID_BU .'CISAILLEMENT_MOYEN_CYCLE'. CycActu = CisaMoy ;
*
  BOITE_US. ID_BU .'CISAILLEMENT_MAX_CYCLE' = 
    BOITE_US. ID_BU .'CISAILLEMENT_MAX_CYCLE' 'ET'
     ('MAXI' BOITE_US. ID_BU .'CISAILLEMENT_MAX_INC') ;
*
  GlissCum = 'ETG' BOITE_US. &BU .'GLISSEMENT' ;
  BOITE_US. &BU .'GLISSEMENT_CYCLE'. CycActu = GlissCum ; 
*
  Uscycle = BOITE_US. ID_BU .'INC_USURE'. CycActu ;
  ProfMax = 'MAXI' Uscycle 'ABS' ;
  BOITE_US. ID_BU .'PROF_USEE_MAX_CYCLE' =
     BOITE_US. ID_BU .'PROF_USEE_MAX_CYCLE' 'ET' ProfMax ; 
*
  Utotale = BOITE_US. ID_BU .'USURE_TOT'. CycActu ;
  ProfMax = 'MAXI' Utotale 'ABS' ;
  BOITE_US. ID_BU .'PROF_USEE_MAX_TOTALE' =
       BOITE_US. ID_BU .'PROF_USEE_MAX_TOTALE' 'ET' ProfMax ; 
*-----------------------------------------------------------------------
* - CALCUL DE DELTA_G ET DELTA_T
*-----------------------------------------------------------------------
  CyclFret = BOITE_US. ID_BU .'CYCLE_DE_FRETTING'. CycActu ; 
*
  F_N_CyFr = 'EXTR' CyclFret 'ORDO';
  Ampl_F_N = ('MAXI' F_N_CyFr) '-' ('MINI' F_N_CyFr) ; 
  ECycFret = 'ABS' ('INTG' CyclFret) ;
  DltG_Est = ECycFret / 2. / Ampl_F_N ;
  BOITE_US. ID_BU .'DELTA_G' = 
     BOITE_US. ID_BU .'DELTA_G' 'ET' DltG_Est ;
*
  Dlt_CyFr = 'EXTR' CyclFret 'ABSC';
  Ampl_Dlt = ('MAXI' Dlt_CyFr) '-' ('MINI' Dlt_CyFr) ; 
  DltT_Est = (Ampl_Dlt / 2.) - DltG_Est ;  
  LDltTPre = BOITE_US. ID_BU .'DELTA_T' ;
  BOITE_US. ID_BU .'DELTA_T' = LDltTPre 'ET' DltT_Est ;
*-----------------------------------------------------------------------
* - ENERGIE DISSIPEE ET VOLUME USE PAR CYCLE ET TOTAL
*-----------------------------------------------------------------------
  ChamDEDC = 'CHAN' 'CHAM' (BOITE_US. ID_BU .'DENS_ENER_DISS_CYCLE') 
     SUR_APPL ;
  EdCycle  = 'INTG' BOITE_US. ID_BU .'MODINTG' ChamDEDC ;
  BOITE_US. ID_BU .'ENERGIE_DISSIPEE_CYCLE' = 
     BOITE_US. ID_BU .'ENERGIE_DISSIPEE_CYCLE' 'ET' EdCycle ;
*
  DensEnDT = BOITE_US. ID_BU .'DENS_ENER_DISS_TOTALE' ;
  ChamDEDT = 'CHAN' 'CHAM' DensEnDT  SUR_APPL ;
  EdTotale = 'INTG' BOITE_US. ID_BU .'MODINTG' ChamDEDT ;
  BOITE_US. ID_BU .'ENERGIE_DISSIPEE_TOTALE' = 
     BOITE_US. ID_BU .'ENERGIE_DISSIPEE_TOTALE' 'ET' EdTotale ;
*
  ChamUsuc = 'CHAN' 'CHAM' Uscycle SUR_APPL ;
  VolUsCyc = 'INTG' BOITE_US. ID_BU .'MODINTG' ChamUsuc ;
  BOITE_US. ID_BU .'VOLUME_USE_CYCLE' = 
     BOITE_US. ID_BU .'VOLUME_USE_CYCLE' 'ET' VolUsCyc ;
*
  ChamUsut = 'CHAN' 'CHAM' Utotale SUR_APPL ;
  VolusTot = 'INTG' BOITE_US. ID_BU .'MODINTG' ChamUsut ;
  BOITE_US. ID_BU .'VOLUME_USE_TOTAL' = 
     BOITE_US. ID_BU .'VOLUME_USE_TOTAL' 'ET' VolUsTot ;
*-----------------------------------------------------------------------
* - LARGEUR DE LA ZONE DE CONTACT
*-----------------------------------------------------------------------
  ChpCont = 'MASQ' DensEnDT 'SUPE' 0.D0 ;
  ChmCont = 'CHAN' 'CHAM' ChpCont SUR_APPL ;
  SurCont = 'INTG' BOITE_US. ID_BU .'MODINTG' ChmCont ;
  BOITE_US. ID_BU .'LARGEUR_CONTACT_CYCLE' = 
    BOITE_US. ID_BU .'LARGEUR_CONTACT_CYCLE' 'ET' SurCont ;
*-----------------------------------------------------------------------
* - CONSTRUCTION D'EVOLUTIONS AVANT DE QUITTER PASAPAS
*-----------------------------------------------------------------------
  'SI' ('EGA' BOITE_US.'INFOS'.'NB_CYCLES_RESTANTS' 0);
*    
*   Pression et cisaillement max en fonction du cycle calcule
    PmCycle = 'EVOL' 'VERT' 'MANU' 
            'Cycle_calcule' BOITE_US.'POST'.'CYCLES_CALCULES'
            'Pression_Max'  BOITE_US. ID_BU .'PRESSION_MAX_CYCLE' ; 
    CmCycle = 'EVOL' 'ROUG' 'MANU' 
            'Cycle_calcule' BOITE_US.'POST'.'CYCLES_CALCULES'
            'Cisaille_Max'  BOITE_US. ID_BU .'CISAILLEMENT_MAX_CYCLE' ;
*
*   Delta_g et Delta_t en fonction du cycle calcule
    DgCycle = 'EVOL' 'BLEU' 'MANU' 
           'Cycle_reel'  BOITE_US.'POST'.'CYCLES_REELS'
           'Delta_G'     BOITE_US. ID_BU .'DELTA_G' ;
    DtCycle = 'EVOL' 'ROUG' 'MANU' 
           'Cycle_reel'  BOITE_US.'POST'.'CYCLES_REELS'
           'Delta_T'     BOITE_US. ID_BU .'DELTA_T' ;
*    
*   Energie dissipee par cycle et totale en fonction du cycle calcule 
    EdcCycle = 'EVOL' 'MANU' 
       'Cycle_calcule'   BOITE_US.'POST'.'CYCLES_CALCULES'
       'Ener_diss_cycle' BOITE_US. ID_BU .'ENERGIE_DISSIPEE_CYCLE' ; 
    EdtCycle = 'EVOL' 'MANU' 
       'Cycle_calcule'    (0 'ET' BOITE_US.'POST'.'CYCLES_CALCULES')
       'Ener_diss_totale' BOITE_US. ID_BU .'ENERGIE_DISSIPEE_TOTALE' ;
*
*   Volume use en fonction du cycle reel et de l'energie dissipee
    VuCycle = 'EVOL' 'MANU' 
       'Cycle_reel'       (0 'ET' BOITE_US.'POST'.'CYCLES_REELS')
       'Volume_use_total' BOITE_US. ID_BU .'VOLUME_USE_TOTAL' ;
    VuEdt = 'EVOL' 'MANU' 
       'Ener_diss_totale' BOITE_US. ID_BU .'ENERGIE_DISSIPEE_TOTALE'
       'Volume_use_total' BOITE_US. ID_BU .'VOLUME_USE_TOTAL' ;
*
    BOITE_US. ID_BU .'PRESMAX_VS_CYCLES'   = PmCycle ;
    BOITE_US. ID_BU .'CISAMAX_VS_CYCLES'   = CmCycle ;
    BOITE_US. ID_BU .'DELTA_G_VS_CYCLES'   = DgCycle ; 
    BOITE_US. ID_BU .'DELTA_T_VS_CYCLES'   = DtCycle ; 
    BOITE_US. ID_BU .'ED_CYCLE_VS_CYCLES'  = EdcCycle ; 
    BOITE_US. ID_BU .'ED_TOT_VS_CYCLES'    = EdtCycle ; 
    BOITE_US. ID_BU .'V_USE_TOT_VS_CYCLES' = VuCycle ; 
    BOITE_US. ID_BU .'V_USE_TOT_VS_ED_TOT' = VuEdt ; 
*  
  'FINSI' ;
*-----------------------------------------------------------------------
'FINP' ;
 
