$$$$ BIBLIO
* BIBLIO    PROCEDUR  PASCAL    22/12/07    21:15:02     11514          
DEBP BIBLIO mot1*'MOT' mot2/'MOT' ;

*------------------------- Lecture arguments -------------------------*

* Lecture indice reference biblio associee a mot1 :
si (exis mot2) ;
  si (ega mot2 'REFE') ;
    argu ent1*'ENTIER' ;
  sino ;
    erre '***** ERREUR : le 2e argument doit etre le mot-cle REFE' ;
    quit biblio ;
  fins ;
sino ;
  argu mot2/'ENTIER' ;
  si (exis mot2) ;
    erre '***** ERREUR : le 2e argument doit etre le mot-cle REFE' ;
    quit biblio ;
  fins ;
  ent1     = 0 ;
fins ;

* imot1  : indice du mot dans la base biblio, 0 si pas dans la base.
imot1    = 0 ;

*----------------------------------------------------------------------*
*                            MOT-CLE : 316L                            *
*----------------------------------------------------------------------*

si (ega mot1 '316L') ;
  imot1    = 1 ;

* Initialisation table de sortie :
  TBIB1    = table ;

*------------------------------ 316L [1] ------------------------------*

* Proprietes thermomecaniques du 316L :
* Lionel Depradeux.
* "Simulation numerique du soudage - Acier 316L : validation sur cas
* tests de complexite croissante".
* These de doctorat.
* Institut National des Sciences Appliquees de Lyon.
* 2004.

* Reference par defaut :
  si (ent1 ega 0) ; ent1 = 1 ; fins ;

  si (ent1 ega 1) ;

*---- THERMIQUE ---- :

*   K1     : Conductivite thermique (W/m/K) :
    lt1      = prog 20. 100. pas 100. 1000. 1200. 1500. ;
    lk1      = prog 14. 15.2 16.6 17.9 19. 20.6 21.8 23.1 24.3 26. 27.3 29.9 60. ;
    K1       = evol manu 'T' lt1 'K' lk1 ;
    TBIB1 . 'K' = K1 ;

*   Rho1   : Masse volumique (kg/m^3)
    lt1      = prog 20. 100. pas 100. 1000. 1200. 1500. ;
    lrho1    = prog 8000. 7970. 7940. 7890. 7850. 7800. 7750. 7700. 7660. 7610. 7570. 7450. 7200. ;
    Rho1     = evol manu 'T' lt1 'RHO' lrho1 ;
    TBIB1 . 'RHO' = Rho1 ;

*   Cp1    : Capacite calorifique massique (J/K/kg)
    lt1      = prog 20. 100. pas 100. 1000. 1200. ;
    lcp1     = prog 450. 490. 525. 545. 560. 570. 580. 595. 625. 650. 660. 677. ;
    Cp1      = evol manu 'T' lt1 'C' lcp1 ;
    TBIB1 . 'C' = Cp1 ;
    
*   Tfus1  : Temperaure de fusion (degC) :
    Tfus1    = 1450. ;
    TBIB1 . 'TFUS' = Tfus1 ;

*   Qlat1  : Chaleur latente massique de fusion (J/kg)
    Qlat1    = 2.5e5 ;
    TBIB1 . 'QLAT' = Qlat1 ;

*---- MECANIQUE ---- :

*   Nu1    : coefficient de Poisson
    TBIB1 . 'NU' = 0.3 ;

*   Ym1    : module de Young (Pa) :
    lt1      = prog 20. 100. pas 100. 1200. ;
    lym1     = prog 197000. 191500. 184000. 176500. 168000. 160000. 151500. 142500. 130000. 108000. 81500. 32000. 7400. ;
    lym1     = 1.e6 * lym1 ;
    ym1      = evol manu T lt1 youn lym1 ;
    TBIB1 . 'YOUN' = ym1 ;

*   Alph1  : dilatation thermique (/K)
    lt1      = prog 20. 100. 300. 400. 600. 700. 800. 1000. 1400. ;
    lalph1   = prog 15.5 16.0 17.1 17.5 18.4 18.7 19.0 19.4 19.6 ;
    lalph1   = 1.e-6 * lalph1 ;
    alph1    = evol manu T lt1 ALPH lalph1 ;
    TBIB1 . 'ALPH' = alph1 ;

*   Sy1    : limite d'elasticite (Pa)
    lt1      = prog 20. 100. pas 100. 1400. ;
    lsy1     = prog 287. 237. 198. 172. 157. 151. 145. 136. 127. 115. 79. 38. 24. 18. 2. ;
    lsy1     = 1.e6 * lsy1 ;
    sy1      = evol manu T lt1 SIGY lsy1 ;
    TBIB1 . 'SIGY' = sy1 ;

*   Trac1  : Courbes de traction (Pa)
*   Ecro1  : Courbes d'ecrouissage (Pa)
    Trac1    = vide nuage ;
    Ecro1    = vide nuage ;
*   A 20 degC :
    T1       = 20. ;
    lept1    = prog 0.3459 1.1599 5.2129 20.2847 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 287.33 314.94 419.42 560.97 ;
    lsig1    = 1.e6 * lsig1 ;
    trac20   = (evol manu 'EPST' lept1 'SIG' lsig1) coul 1 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac20) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro20   = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 1 ;
    Ecro20   = prol line Ecro20 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro20) ;
*   A 200 degC :
    T1       = 200. ;
    lept1    = prog 0.3077 1.1257 5.1816 20.2556 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 198.16 231.36 334.1 470.24 ;
    lsig1    = 1.e6 * lsig1 ;
    trac200  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 2 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac200) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro200  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 2 ;
    Ecro200  = prol line Ecro200 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro200) ;
*   A 300 degC :
    T1       = 300. ;
    lept1    = prog 0.2977 1.1137 5.1740 20.2558 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 172.47 200.62 307.12 451.42 ;
    lsig1    = 1.e6 * lsig1 ;
    trac300  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 3 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac300) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro300  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 3 ;
    Ecro300  = prol line Ecro300 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro300) ;
*   A 400 degC :
    T1       = 400. ;
    lept1    = prog 0.2939 1.1115 5.1755 20.2593 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 157.83 187.32 294.89 435.66 ;
    lsig1    = 1.e6 * lsig1 ;
    trac400  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 4 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac400) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro400  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 4 ;
    Ecro400  = prol line Ecro400 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro400) ;
*   A 500 degC :
    T1       = 500. ;
    lept1    = prog 0.2948 1.1120 5.1765 20.2620 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 151.65 179.12 282.34 419.14 ;
    lsig1    = 1.e6 * lsig1 ;
    trac500  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 5 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac500) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro500  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 5 ;
    Ecro500  = prol line Ecro500 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro500) ;
*   A 600 degC :
    T1       = 600. ;
    lept1    = prog 0.2960 1.1121 5.1730 20.2556 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 145.47 169.87 262.17 387.23 ;
    lsig1    = 1.e6 * lsig1 ;
    trac600  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 6 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac600) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro600  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 6 ;
    Ecro600  = prol line Ecro600 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro600) ;
*   A 700 degC :
    T1       = 700. ;
    lept1    = prog 0.2956 1.1128 5.1485 20.2389 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 136.2 160.7 211.65 340.49 ;
    lsig1    = 1.e6 * lsig1 ;
    trac700  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 7 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac700) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro700  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 7 ;
    Ecro700  = prol line Ecro700 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro700) ;
*   A 800 degC :
    T1       = 800. ;
    lept1    = prog 0.2980 1.1167 5.1529 20.2260 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 127. 151.75 198.75 293.75 ;
    lsig1    = 1.e6 * lsig1 ;
    trac800  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 8 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac800) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro800  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 8 ;
    Ecro800  = prol line Ecro800 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro800) ;
*   A 900 degC :
    T1       = 900. ;
    lept1    = prog 0.3068 1.1273 5.1493 20.1566 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 115.37 137.5 161.25 169.12 ;
    lsig1    = 1.e6 * lsig1 ;
    trac900  = (evol manu 'EPST' lept1 'SIG' lsig1) coul 11 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac900) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro900  = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 11 ;
    Ecro900  = prol line Ecro900 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro900) ;
*   A 1000 degC :
    T1       = 1000. ;
    lept1    = prog 0.2966 1.1009 5.1184 20.1227 ;
    lept1    = 1.e-2 * lept1 ;
    lsig1    = prog 78.75 82.25 96.5 100. ;
    lsig1    = 1.e6 * lsig1 ;
    trac1000 = (evol manu 'EPST' lept1 'SIG' lsig1) coul 10 ;
    Trac1    = Trac1 et (nuag comp 'T' T1 comp 'TRAC' trac1000) ;
    ymT1     = ipol ym1 T1 ;
    lepp2    = lept1 - (lsig1 / ymT1) ;
    Ecro1000 = (evol manu 'EPSP' lepp2 'SIG' lsig1) coul 10 ;
    Ecro1000 = prol line Ecro1000 0. ;
    Ecro1    = Ecro1 et (nuag comp 'T' T1 comp 'ECRO' Ecro1000) ;
    TBIB1 . 'TRAC' = Trac1 ;
    TBIB1 . 'ECRO' = Ecro1 ;

*trac0 = trac20 et trac200 et trac300 et trac400 et trac500 et trac600 et trac700 et trac800 et trac900 et trac1000 ;
*ecro0 = ecro20 et ecro200 et ecro300 et ecro400 et ecro500 et ecro600 et ecro700 et ecro800 et ecro900 et ecro1000 ;
*dess (trac0 et ecro0) ;
    TBIB1 . 'CREATEUR' = mot 'BIBLIO' ;
    TBIB1 . 'REFERENCE' = chai mot1 '_' ent1 ;

    resp TBIB1 ;
    quit biblio ;

  fins ;
* Fin [1], "316L" 

*------------------------------ 316L [2] ------------------------------*

* Proprietes thermomecaniques du 316L :
* Camille Cambon, Issam Bendaoud, Sebastien Rouquette, Fabien Soulie.
* "Influence of the first weld bead on strain and stress states in wire+arc additive manufacturing”.
* The 12th International Seminar ”Numerical Analysis of Weldability",
* Institute for Materials Science, Joining and Forming (IMAT),Sep 2018, Seggau, Austria.
* hal-01954354 https://hal.archives-ouvertes.fr/hal-01954354

  si (ent1 ega 2) ;

*---- THERMIQUE ---- :

*   K1     : Conductivite thermique (W/m/K) :
    lt1      = prog 20. 100. pas 100. 1000. 1200. 1400. ;
    lk1      = prog 14. 15.2 16.6 17.9 19. 20.6 21.8 23.1 24.3 26. 27.3 29.9 60. ;
    K1       = evol manu 'T' lt1 'K' lk1 ;
    TBIB1 . 'K' = K1 ;

*   Enth1  : Enthalpie volumique (J/m^3)
    lt1      = prog 0. pas 100. 1500. ;
    lenth1   = prog 0.983 1.36 1.76 2.19 2.62 3.06 3.51 3.96 4.43 4.92 5.42 5.92 6.44 6.97 9.51 10.1 ;
    lenth1   = 1.e9 * lenth1 ;
    Enth1    = evol manu 'T' lt1 'ENTH' lenth1 ;
    TBIB1 . 'ENTH' = Enth1 ;
    
*   Tfus1  : Temperature de fusion (degC) :
    Tfus1    = 1450. ;
    TBIB1 . 'TFUS' = Tfus1 ;

*   Qlat1  : Chaleur latente volumique de fusion (J/m^3)
    Qlat1    = 2.e9 ;
    TBIB1 . 'QLAT' = Qlat1 ;

*---- MECANIQUE ---- :

*   Ym1    : module de Young (Pa) :
    lt1      = prog 20. 100. pas 100. 1200. ;
    lym1     = prog 197000. 191500. 184000. 176500. 168000. 160000. 151500. 142500. 130000. 108000. 81500. 32000. 7400. ;
    lym1     = 1.e6 * lym1 ;
    ym1      = evol manu T lt1 youn lym1 ;
    TBIB1 . 'YOUN' = ym1 ;

*   Sy1    : limite d'elasticite (Pa)
    lt1      = prog 20. 100. pas 100. 1400. ;
    lsy1     = prog 287. 237. 198. 172. 157. 151. 145. 136. 127. 115. 79. 38. 24. 18. 2. ;
    lsy1     = 1.e6 * lsy1 ;
    sy1      = evol manu T lt1 SIGY lsy1 ;
    TBIB1 . 'SIGY' = sy1 ;
    ltsy1    = lt1 ;

*   Alph1  : dilatation thermique (/K)
    lt1      = prog 20. 100. 300. 400. 600. 700. 800. 1000. 1400. ;
    lalph1   = prog 15.5 16.0 17.1 17.5 18.4 18.7 19.0 19.4 19.6 ;
    lalph1   = 1.e-6 * lalph1 ;
    alph1    = evol manu T lt1 ALPH lalph1 ;
    TBIB1 . 'ALPH' = alph1 ;

*   H1     : module tangent d'elasticite (Pa)
    lt1      = prog 20. 700. pas 100. 1300. ;
    lh1      = prog 2400. 2400. 2350. 1500. 800. 725. 150. 10. ;
    lh1      = 1.e6 * lh1 ;
    H1       = evol manu T lt1 H lh1 ;
    TBIB1 . 'H' = H1 ;

*   Ecro1  : Courbes d'ecrouissage :
    lt1      = ((lt1 et ltsy1) uniq) ordo ;
    nb1      = dime lt1 ;
    lep1     = prog 0. 1. ;
    ecro1    = vide nuage ;
    ic1      = 0 ;
    repe b1 nb1 ;
      ic1      = ic1 + 1 ;
      si (ic1 ega 9) ; ic1 = ic1 + 1 ; fins ;
      ti1      = extr lt1 &b1 ;
      syi1     = ipol sy1 ti1 ;
      hi1      = ipol H1  ti1 ;
      lmsi1    = prog syi1 (syi1+hi1) ;
      ecroi1   = evol manu epeq lep1 smeq lmsi1 ;
      ecroi1   = ecroi1 coul ic1 ;
      ecro1    = ecro1 et (nuag comp T ti1 comp ECRO ecroi1) ;
    fin b1 ;
    TBIB1 . 'ECRO' = ecro1 ;

    TBIB1 . 'CREATEUR' = mot 'BIBLIO' ;
    TBIB1 . 'REFERENCE' = chai mot1 '_' ent1 ;

    resp TBIB1 ;
    quit biblio ;

  fins ;
* Fin [2], "316L"

*------------------------------ 316L [4] ------------------------------*

  si (ent1 ega 4) ;

*--- Conductivite thermique  [w/mm.K] :
  LT1      = prog 20 100 200 300 400 500 600 700 800 900 1000 1100 1200 1300 1400 ;
  LK1      = prog 0.0141 0.0152 0.0167 0.0181 0.0195 0.0209 0.0224 0.0238 0.0252 0.0267 0.0281 0.0295 0.0309 0.0324 0.0338 ;
  EVK1     = EVOL MANU 'T' LT1 'K' LK1 ;
  comm /!\  conversion [w/mm.K] -> [w/m.K] ;
  K_316L   = 1.e3 * EVK1 ;
  TBIB1 . 'K' = K_316L ;



*--- Capacite calorifique massique [J/Kg.K] :
  LT1      = prog 20 100 200 300 400 500 600 700 800 900 1000 1100 ;
  LCP1     = prog 492 502 514 526 538 550 562 575 587 599 611 623  ;
  EVCP1    = evol manu 'T' LT1 'C' LCP1 ;
  C_316L   = EVCP1 ;
  TBIB1 . 'C' = C_316L ;



*--- Module d'Young (GPa) :
  LT1      = prog 20 100 200 300 400 500 600 700 800 900 1000 1100 1200 1300 1400 4000 ;
  LYM1     = prog 195.6 191.2 185.7 179.6 172.6 164.5 155.0 144.1 131.4 116.8 100.0 80.00 57.00 30.00 2.000 2.000 ;
  YM_316L = evol manu 'T' LT1 'YOUN' LYM1 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  TBIB1 . 'YOUN' = 1.e9 * YM_316L ;



*--- Coefficient de Poisson :
  TBIB1 . 'NU'   = 0.29 ;



*--- Coeficient de dilatation thermique [1/K] :
  LT1      = prog 20 100 200 300 400 500 600 700 800 900 1000 1100 1200 1300 1400 4000 ;
  LALPHA1  = prog 1.46E-05 1.54E-05 1.62E-05 1.69E-05 1.74E-05 1.78E-05 1.81E-05 1.84E-05 1.87E-05 1.90E-05 1.93E-05 1.95E-05 1.98E-05 2.00E-05 2.02E-05 2.02E-05 ;
  AL_316L = evol manu 'T' LT1 'ALPH' LALPHA1 ;
  TBIB1 . 'ALPH' = AL_316L ;



*--- limite élastique [MPa]
  LT1      = prog 20 275 550 750 900 1000 1100 1400 ;
  LSY1     = prog 125.6 97.60 90.90 71.40 66.20 31.82 19.73 2.100 ;
  EVSY1    = evol manu 'T' LT1 'SIGY' LSY1 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  SY_316L = 1.e6 * EVSY1 ;
  TBIB1 . 'SIGY' = SY_316L ;



*--- Coefficients ecrouissage cinematique modele EP Chaboche :
*    LCiMur : coefficient Ci article Muransky
*    LGiMur : coefficient Gammai article Muransky
*    LCiC3M : coefficient Ci loi EP Chaboche Cast3M
*    LAiC3M : coefficient Ai loi EP Chaboche Cast3M
  LT1      = prog 20 275 550 750 900 1000 1100 1400 ;
  LC1Mur   = prog 156435.0 100631.0 64341.00 56232.00 0.050000 0 0 0 ;
  LG1Mur   = 1410.9 ;
  LC2Mur   = prog 6134.0 5568.0 5227.0 4108.0 292.00 0 0 0 ;
  LG2Mur   = 47.19 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  LC1Mur   = 1.e6 * LC1Mur ;
  LC2Mur   = 1.e6 * LC2Mur ;
  LC1C3M   = LG1Mur ;
  LC2C3M   = LG2Mur ;
  LA1C3M   = LC1Mur / LG1Mur ;
  LA2C3M   = LC2Mur / LG2Mur ;
  EVA1     = evol manu 'T' LT1 'A1' LA1C3M ;
  EVA2     = evol manu 'T' LT1 'A2' LA2C3M ;
  R0_316L = evol manu 'T' (extr SY_316L absc) 'R0' (extr SY_316L ordo) ;
  TBIB1 . 'R0' = R0_316L ;
  TBIB1 . 'A1' = EVA1 ;
  TBIB1 . 'C1' = LC1C3M ;
  TBIB1 . 'A2' = EVA2 ;
  TBIB1 . 'C2' = LC2C3M ;



*--- Coefficients ecrouissage isotrope modele EP Chaboche :
  LT1      = prog 20 275 550 750 900 1000 1100 1400 ;
  LRM1     = prog 153.4 154.7 150.6 57.90 0 0 0 0 ;
  EVRM1    = evol manu 'T' LT1 'RM' LRM1 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  EVRM1    = 1.e6 * EVRM1 ;
  TBIB1 . 'RM' = EVRM1 + (evol manu 'T' (extr SY_316L absc) 'RM' (extr SY_316L ordo)) ;
  TBIB1 . 'B'  = 6.9 ;



    TBIB1 . 'CREATEUR' = mot 'BIBLIO' ;
    TBIB1 . 'REFERENCE' = chai mot1 '_' ent1 ;

    resp TBIB1 ;
    quit biblio ;

  fins ;
* Fin [4], "316L"

* Reference ent1 n'existe pas pour mot1
  erre (chai '*****  La reference' ' ' ent1 ' ne concerne pas' ' ' mot1) ;
  quit biblio ;

* Fin mot-cle "316L"
fins ;

*----------------------------------------------------------------------*
*                           MOT-CLE : 9Cr ODS                          *
*----------------------------------------------------------------------*

si (ega mot1 '9Cr ODS') ;
  imot1    = 2 ;

* Initialisation table de sortie :
  TBIB1    = table ;

*----------------------------- 9Cr ODS [3] ----------------------------*

* Brendan Le Gloannec.
* "Modifications microstructurales sous sollicitations thermomécaniques sévères :
* application au soudage par résistance des gaines de combustibles en aciers ODS".
* Thèse de doctorat.
* Université de Bordeaux.
* 2016.

* Numero reference bib. par defaut :
  si (ent1 ega 0) ; ent1 = 3 ; fins ;

  si (ent1 ega 3) ;


*--- Masse volumique [Kg/m3] :
  RHO_9ODS =      7760. ;
  TBIB1 . 'RHO' = RHO_9ODS ;



*--- Conductivite thermique  [w/mm.K] :
  CONDTH_9ODS1  = EVOL MANU 'T' (PROG  2.5e+01  5e+01     1e+02    1.5e+02
                                       2e+02    2.5e+02   3e+02    3.5e+02
                                       4e+02    4.5e+02   5e+02    5.5e+02)
                            'K' (PROG  2.3e-02  2.27e-02  2.23e-02
                                       2.36e-02 2.49e-02  2.54e-02  2.63e-02
                                       2.6e-02  2.65e-02  2.71e-02  2.74e-02
                                       2.72e-02) ;
  CONDTH_9ODS2  = EVOL MANU 'T' (PROG 6e+02     6.5e+02   7e+02    7.5e+02
                                      8e+02     8.5e+02   9e+02    9.5e+02
                                      1e+03     1.05e+03  1.1e+03  1.15e+03
                                      1.18e+03  1.45e+03)
                            'K' (PROG 2.73e-02  2.65e-02    2.57e-02
                                        2.14e-02  2.53e-02  4.44e-02  2.9e-02
                                        2.65e-02  2.65e-02  2.65e-02  2.73e-02
                                        2.82e-02  2.88e-02  3.28e-02) ;
  comm /!\  conversion [w/mm.K] -> [w/m.K] ;
  CONDTH_9ODS   = 1.e3 * (CONDTH_9ODS1 + CONDTH_9ODS2) ;
  TBIB1 . 'K' = CONDTH_9ODS ;



*--- Capacite calorifique massique [J/Kg.K] :
  CAPAC_9ODS1 = EVOL MANU 'T' (PROG 2.5e+01  5.0e+01  1.0e+02  1.5e+02  2.0e+02
                                    2.5e+02  3.0e+02  3.5e+02  4.0e+02
                                    4.5e+02  5.0e+02  5.5e+02  7.0e+02
                                    7.5e+02  8.0e+02  8.5e+02  9.0e+02)
                          'C' (PROG 4.4e+02  4.4e+02  4.4e+02  4.75e+02 5.1e+02
                                    5.3e+02  5.6e+02  5.7e+02  6.0e+02
                                    6.4e+02  6.8e+02  7.2e+02  9.5e+02
                                    9.6e+02  7.8e+02  1.14e+03 6.8e+02) ;
  CAPAC_9ODS2 = EVOL MANU 'T' (PROG 9.5e+02   1.0e+03   1.05e+03  1.10e+03
                                    1.15e+03  1.45e+03  1.46e+03  1.47e+03
                                    1.48e+03  1.5e+03)
                          'C' (PROG 6.2e+02   6.2e+02   6.2e+02   6.4e+02
                                    6.6e+02   7.95e+02  9.94e+03  9.942e+03
                                    8.38e+02  8.38e+02) ;
  CAPAC_9ODS  = (CAPAC_9ODS1 + CAPAC_9ODS2) ;
  TBIB1 . 'C' = CAPAC_9ODS ;



*--- Conductivite electrique 9Cr ODS [Ohm.mm]^-1 :
  CONDEL_9ODS  = EVOL MANU 'T'  (PROG  2.2e+01   6.7e+02  1.5e+03   1.6e+03)
                           'KD' (PROG  0.2e+04   1.0e+03  0.606e+03 0.606e+03) ;
  comm /!\ conversion [Ohm.mm]^-1 -> [Ohm.m]^-1 ;
  TBIB1 . 'KE' = 1.e3*CONDEL_9ODS ;



*--- Module d'Young (MPa) :
  YONG_9CrODS = EVOL MANU 'T' (PROG 2.e+01    1.2e+02  2.2e+02  4.0e+02   4.7e+02   6.15e+02  6.6e+02  7.6e+02
                                    8.3e+02   9.6e+02  1.e+03   1.5e+03)

                       'YOUN' (PROG  2.16e+5  2.1e+5   2.05e+5  1.9e+5    1.8e+5    1.6e+5    1.5e+5   1.2e+5
                                     1.15e+5  1.15e+5  1.14e+5  1.     ) ;
  comm /!\ conversion [MPa] -> [Pa] ;
  TBIB1 . 'YOUN' = 1.e6 * YONG_9CrODS ;



*--- Coefficient de Poisson :
  NU_9CrODS = EVOL MANU 'T' (PROG 2.e+01   1.45e+03  1.5e+03 )
                       'NU' (PROG 2.9e-01  2.9e-01   0.49e-01) ;
  comm /!\ : on prend une valeur constante car le choix de modelisation du comportement en phase liquide ;
*       n'est pas du ressort des donnees :
  TBIB1 . 'NU'   = 0.29 ;



*--- Coeficient de dilatation thermique [1/K] :
  ALPH_9CrODS1 = EVOL MANU 'T'(PROG  2.e+01  1.e+02    1.5e+02  2.e+02  2.5e+02  3.e+02   3.5e+02  4.e+02  4.5e+02
                                     5.e+02  5.5e+02 )
                      'ALPH' (PROG 1.01e-05  1.07e-05  1.1e-05   1.13e-05  1.17e-05  1.21e-05  1.24e-05 1.28e-05
                                   1.31e-05  1.36e-05  1.39e-05  );
  ALPH_9CrODS2 = EVOL MANU 'T'(PROG  6.e+02   6.5e+02  7.e+02   7.5e+02  8.e+02   8.5e+02 9.5e+02
                                     1.e+03  1.05e+03  1.1e+03  1.5e+03)
                      'ALPH' (PROG 1.42e-05  1.46e-05  1.5e-05  1.53e-05 1.57e-05
                                   1.6e-05   -3.e-06   2.4e-05  2.4e-05   2.4e-05   2.91e-05) ;
  ALPH_9CrODS =   ALPH_9CrODS1+ALPH_9CrODS2;
  TBIB1 . 'ALPH' = ALPH_9CrODS ;



*--- limite élastique [MPa]
  KK_9CrODS = EVOL MANU 'T'  (PROG   2.e+01     4.e+02    5.e+02   6.e+02   6.5e+02   7.5e+02  9.5e+02  1.25e+03 1.45e+03 1.5e+03)
                        'KK' (PROG   1.083e+03  8.87e+02  7.03e+02 4.32e+02 1.96e+02  1.65e+02  1.e+02  2.2e+01  1.        1.);
  comm /!\ conversion [MPa] -> [Pa] ;
  KK_9CrODS = 1.e6 * KK_9CrODS ;
  TBIB1 . 'KK' = KK_9CrODS ;



*--- Coefficient d'ecrouissage isotrope a saturation Rmin & Rmax (Rmax = KK + Rmin) [MPa] lisse :
  RMIN_9CrODS =  EVOL MANU 'T'    (PROG  2.0e+01  4.e+02   5.e+02   6.e+02   7.5e+02   9.5e+02  1.45e+03)
                           'RMAX' (PROG  1.33e+02 6.6e+01  4.7e+01  4.3e+01  3.8e+01   1.       0.) ;
  comm /!\ conversion [MPa] -> [Pa] ;
  RMIN_9CrODS = 1.e6 * RMIN_9CrODS ;
  TBIB1 . 'RMIN' = RMIN_9CrODS ;
  KK_9CrODS      = EVOL MANU 'T' (EXTR KK_9CrODS ABSC) 'RMAX' (EXTR KK_9CrODS ORDO) ;
  TBIB1 . 'RMAX' = KK_9CrODS + RMIN_9CrODS ;



*--- Coefficient d'ecrouissage isotrope BR [MPa]
  BR_9CrODS =  EVOL MANU 'T'  (PROG  2.e+01    4.e+02   5.e+2    6.e+02    6.5e+02  7.5e+2    9.5e+02  1.50e+03)
                         'BR' (PROG  1.24e+02  1.6e+02  2.53e+02  1.26e+02 6.7e+01  1.08e+02  0.       0.      ) ;
  comm /!\ conversion [MPa] -> [Pa] ;
  BR_9CrODS = 1.e6 * BR_9CrODS ;
  TBIB1 . 'BR' = BR_9CrODS ;



*--- Exposant viscosite N :
  N_9CrODS = EVOL MANU 'T' (PROG  2.e+01    5.e+02   6.5e+02   7.5e+02  9.5e+02   1.25e+03  1.45e+03  )
                       'N' (PROG  6.43e+00  6.43e+00 4.32e+00  2.77e+00 1.81e+01  1.136e+01 1.1360e+01) ;
  TBIB1 . 'N'    = N_9CrODS ;



*--- Parametre viscosite K0 [MPa.s]
  K0_9CrODS = EVOL MANU 'T'  (PROG   2.e+01    5.e+02    6.5e+02   7.5e+02   9.5e+02    1.25e+03  1.50e+03)
                        'K0' (PROG   3.11e+02  3.11e+02  3.03e+02  4.61e+02  1.412e+02  1.02e+02  1.02e+02 ) ;
  comm /!\ conversion [MPa] -> [Pa] ;
  K0_9CrODS = 1.e6 * K0_9CrODS ;
  TBIB1 . 'K0' = K0_9CrODS ;



    TBIB1 . 'CREATEUR' = mot 'BIBLIO' ;
    TBIB1 . 'REFERENCE' = chai mot1 '_' ent1 ;

    resp TBIB1 ;
    quit biblio ;

  fins ;
*--- Fin [3], "9Cr ODS"



* Numero reference bib. ent1 n'existe pas pour mot1
  erre (chai '*****  La reference' ' ' ent1 ' ne concerne pas' ' ' mot1) ;
  quit biblio ;

* Fin mot-cle "9Cr ODS"
