  LALPHA1  = prog 7.83000E-06 7.82000E-06 7.81000E-06 7.80000E-06 7.78000E-06 7.77000E-06 7.75000E-06 7.73000E-06 7.72000E-06 7.70000E-06 7.68000E-06 7.67000E-06 7.65000E-06 7.70000E-06 7.68000E-06 7.66000E-06 7.64000E-06 7.62000E-06 7.59000E-06 7.57000E-06 7.55000E-06 7.55000E-06 7.55000E-06 7.55000E-06 7.55000E-06 ;
  AL_A508 = evol manu 'T' LT1 'ALPH' LALPHA1 ;
