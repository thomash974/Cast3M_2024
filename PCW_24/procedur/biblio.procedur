  si (ent1 ega 4) ;


*--- Masse volumique [Kg/m3] :
*  RHO1     =      'XX' ;
*  TBIB1 . 'RHO' = RHO1 ;



*--- Conductivite thermique  [w/mm.K] :
  LT1      = prog 27. 77. 127. 177. 227. PAS 100. 1327. ;
  LK1      = prog 0.0142 0.0151 0.0160 0.0168 0.0177 0.0195 0.0213 0.0230 0.0248 0.0265 0.0283 0.0301 0.0318 0.0336 0.0353 0.0371 ;
  EVK1     = EVOL MANU 'T' LT1 'K' LK1 ;
  comm /!\  conversion [w/mm.K] -> [w/m.K] ;
  K_INCO82   = 1.e3 * EVK1 ;
  TBIB1 . 'K' = K_INCO82 ;



*--- Capacite calorifique massique [J/Kg.K] :
  LT1      = prog 20. 100. PAS 100. 900. 1204. 1316. ;
  LCP1     = prog 444 465 486 502 519 536 578 595 611 628 733 766 ;
  EVCP1    = evol manu 'T' LT1 'C' LCP1 ;
  C_INCO82 = EVCP1 ;
  TBIB1 . 'C' = C_INCO82 ;



*--- Module d'Young (GPa) :
  LT1      = prog 21 93 149 204 260 316 371 427 482 538 600 PAS 100. 1000. 1150 1260 1316 1371 ;
  LYM1     = prog 213.7 208.2 206.2 203.4 200.0 197.9 194.4 190.3 186.2 182.0 180.0 172.0 164.0 154.0 143.0 115.0 78.30 39.30 2.000 ;
  YM_INCO82 = evol manu 'T' LT1 'YOUN' LYM1 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  TBIB1 . 'YOUN' = 1.e9 * YM_INCO82 ;



*--- Coefficient de Poisson :
  TBIB1 . 'NU'   = 0.31 ;



*--- Coeficient de dilatation thermique [1/K] :
  LT1      = prog 38 66 93 121 149 178 204 232 260 288 316 343 371 399 428 500 PAS 100. 900. 1093 1371 ;
  LALPHA1  = prog 1.24E-05 1.27E-05 1.30E-05 1.32E-05 1.33E-05 1.35E-05 1.36E-05 1.38E-05 1.39E-05 1.40E-05 1.41E-05 1.42E-05 1.43E-05 1.44E-05 1.45E-05 1.49E-05 1.53E-05 1.58E-05 1.61E-05 1.64E-05 1.70E-05 1.78E-05 ;
  AL_INCO82 = evol manu 'T' LT1 'ALPH' LALPHA1 ;
  TBIB1 . 'ALPH' = AL_INCO82 ;



*--- limite élastique [MPa]
  LT1      = prog 22 316 538 760 982 1200 1400 ;
  LSY1     = prog 206.8 161.0 171.0 144.7 34.80 21.00 2.000 ;
  EVSY1    = evol manu 'T' LT1 'SIGY' LSY1 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  SY_INCO82 = 1.e6 * EVSY1 ;
  TBIB1 . 'SIGY' = SY_INCO82 ;



*--- Coefficients ecrouissage cinematique modele EP Chaboche :
*    LCiMur : coefficient Ci article Muransky
*    LGiMur : coefficient Gammai article Muransky
*    LCiC3M : coefficient Ci loi EP Chaboche Cast3M
*    LAiC3M : coefficient Ai loi EP Chaboche Cast3M
  LT1      = prog 22.000 316.00 538.00 760.00 982.00 1200.0 1400.0 ;
  LC1Mur   = prog 2.54865E+05 1.92628E+05 1.04132E+05 1.31679E+05 1.79993E+05 0.0000 0.0000 ;
  LG1Mur   = 2496.2 ;
  LC2Mur   = prog 1731.0 2304.6 2571.2 2668.4 623.60 0.0000 0.0000 ;
  LG2Mur   = 3.9560 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  LC1Mur   = 1.e6 * LC1Mur ;
  LC2Mur   = 1.e6 * LC2Mur ;
  LC1C3M   = LG1Mur ;
  LC2C3M   = LG2Mur ;
  LA1C3M   = LC1Mur / LG1Mur ;
  LA2C3M   = LC2Mur / LG2Mur ;
  EVA1     = evol manu 'T' LT1 'A1' LA1C3M ;
  EVA2     = evol manu 'T' LT1 'A2' LA2C3M ;
  R0_INCO82 = evol manu 'T' (extr SY_INCO82 absc) 'R0' (extr SY_INCO82 ordo) ;
  TBIB1 . 'R0' = R0_INCO82 ;
  TBIB1 . 'A1' = EVA1 ;
  TBIB1 . 'C1' = LC1C3M ;
  TBIB1 . 'A2' = EVA2 ;
  TBIB1 . 'C2' = LC2C3M ;



*--- Coefficients ecrouissage isotrope modele EP Chaboche :
  LT1      = prog 22.000 316.00 538.00 760.00 982.00 1200.0 1400.0 ;
  LRM1     = prog 83.5    75.3   83.2    0.     0.      0.     0. ;
  EVRM1    = evol manu 'T' LT1 'RM' LRM1 ;
  comm /!\ conversion [MPa] -> [Pa] ;
  EVRM1    = 1.e6 * EVRM1 ;
  TBIB1 . 'RM' = EVRM1 + (evol manu 'T' (extr SY_INCO82 absc) 'RM' (extr SY_INCO82 ordo)) ;
  TBIB1 . 'B'  = 20. ;



    TBIB1 . 'CREATEUR' = mot 'BIBLIO' ;
    TBIB1 . 'REFERENCE' = chai mot1 '_' ent1 ;

    resp TBIB1 ;
    quit biblio ;

  fins ;
*--- Fin [4], "Inconel 82"



* Numero reference bib. ent1 n'existe pas pour mot1
  erre (chai '*****  La reference' ' ' ent1 ' ne concerne pas' ' ' mot1) ;
  quit biblio ;

* Fin mot-cle "Inconel 82"
