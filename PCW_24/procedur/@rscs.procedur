$$$$ @RSCS
* @RSCS     PROCEDUR  CB215821  19/11/18    21:15:02     10383          
*----------------------------------------------------------------------
*      CETTE METHODE A ETE MISE GRACIEUSEMENT
*      A DISPOSITION DE  LA COMMUNAUTE CAST3M
*      PAR TAMASKOVICS N.
*     (Freiberg Institut für Geotechnik )
*----------------------------------------------------------------------
'DEBM'  @RSCS  CPB*'LISTREEL'  DBG/'ENTIER' ;
*----------------------------------------------------------------------
* La methode @RSCS converti les valeurs dans le LISTREEL en un random
* set notation pour la probabilite cumulee
*----------------------------------------------------------------------
 'SI' ('EXIS' DBG ) ;
  !DBG = DBG ;
 'SINO' ;
  !DBG = 0 ;
 'FINS' ;
*
 !IX  ='DIME' CPB ;
 !IIX = 2 * !IX ;
 !CPBS ='PROG' !IIX * 0.0 ;
*
 !VV  = 0.0 ;
 !JX  = 2 ;
*
 'REPE' I !IX ;
  !CPBI ='EXTR'  CPB  &I;
  'REPE' J !JX ;
   !JJ = (2 * (&I-1)) + &J ;
   'REMP'  !CPBS  !JJ  !VV ;
   'SI' ( &J 'EGA' 1 ) ;
    !VV = !VV + !CPBI ;
   'FINS' ;
  'FIN' J ;
 'FIN' I ;
*
'FINM'  !CPBS ;
