$$$$ USACCE
* USACCE    PROCEDUR  MB234859  24/02/06    21:15:02     11833          
***********************************************************************
*                         PROCEDURE USACCE 
*
* Procedure recuperant ou estimant le facteur de saut de cycle.
*
* Entree :
*   T1     : Table de PASAPAS
*
* Sortie :
*   deltaN : facteur de saut de cycle
*
* Appelee par USIMPL et USEXPL
*
************************************************************************
'DEBP' USACCE T1*'TABLE' ;
*
  BOITE_US = T1.'BOITES_USURE' ; 
  CycActu  = BOITE_US.'INFOS'.'INDICE_CYCLE_ACTUEL';
  NbCycRe  = BOITE_US.'INFOS'.'NB_CYCLES_RESTANTS' ;
  NCycle   = BOITE_US.'DONNEES'.'NB_CYCLES';
  deltaN   = BOITE_US.'INFOS'.'ACCELERATION' ;
*
  'SI' ('NON' BOITE_US.'INFOS'.'SCH_EXPL');
    'SI' ('EXIS' BOITE_US.'POST'.'FACTEUR_ACCELERATION' CycActu) ;
      deltaN = BOITE_US.'POST'.'FACTEUR_ACCELERATION'. CycActu ;
      'QUIT' USACCE ;
    'SINON';
      deltaNList = 'PROG' 0. 0. ;
      'SI' (CycActu '>EG' BOITE_US.'INFOS'.'DN_CYCLES_INIT') ;
        'REPE' BU BOITE_US.'INFOS'.'N_BOITES';
*
*         Deduire la valeur du facteur d'acceleration a partir de L(N)
          LLargCont = BOITE_US. &BU  .'LARGEUR_CONTACT_CYCLE';
          LCycReels = BOITE_US.'POST'.'CYCLES_REELS';
*
*         On calcule lambda1 et lambda2 de maniere a approcher cette evolution
          paramsIn = 'PROG' 0.005 0.3;

*         On retranche la largeur de contact initiale 
*         (uniquement si L(N) = L_0 + lambda_1*N**lambda_2)
          LLargCont = LLargCont '-' ('EXTR' LLargCont 1) ;

*         LPoids : la liste des ponderations pour LEVM
          LPoids = 'PROG' ('DIME' LLargCont) '*' 1. ;
***       repe i (dime LLargCont);
***          LPoids = LPoids et ((extr listLargContRedu &i)**2);
***         LPoids = LPoids et 1.;
***       fin i;

*         Appel à LEVM : determiner lambda1 et lambda2
          paramsOut chi2Out = levm 'ABSC' LCycReels 'ORDO' LLargCont
            'SIGM' LPoids 'PARA' paramsIn 'PROC' USADAC ; 
*
          A DN = USADAC (PROG) (paramsOut 'ET' (NCycle '-' NbCycRe)) ;
          deltaNBU = BOITE_US.'INFOS'.'DELTA_L0' '/' DN ;
          'REMP' deltaNList &BU deltaNBu ;
        'FIN' BU;
      'FINSI' ;
      deltaN = 'MINI' deltaNList;
      'SI' (deltaN '<' BOITE_US.'INFOS'.'ACCELERATION');
        deltaN = BOITE_US.'INFOS'.'ACCELERATION';
      'FINSI';
    'FINSI';
  'FINSI';
*  
  'SI' (deltaN '>' NbCycRe);
    deltaN = NbCycRe;
  'FINSI';
  BOITE_US.'POST'.'FACTEUR_ACCELERATION'. CycActu = deltaN ;
*-----------------------------------------------------------------------
'FINP' deltaN ;
 
