<!-- *                           C O N T E X T S                         *  -->
<!-- * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *  -->
		<contexts>
        
            <!-- 	Taitement du Texte Normal (=initial)		 -->
            
            <context attribute="Normal Text" lineEndContext="#stay" name="Start">
                  <IncludeRules context="Normal"/>
                  <IncludeRules context="FindCommands"/>
            </context>
            
			<context attribute="Normal Text" lineEndContext="#stay" name="Normal">
                <keyword attribute="Keyword" context="#stay" String="keywords"/>
<!-- 				<keyword attribute="ISO/Delphi Extended" context="#stay" String="ISO/Delphi Extended"/> -->
				<keyword attribute="Procedure" context="#stay" String="Procedures"/>
                <RegExpr attribute="Logical" context="#stay" String="\bvrai" insensitive="true"/>
                <RegExpr attribute="Logical" context="#stay" String="\bfaux" insensitive="true"/>
				<Float attribute="Number" context="#stay"/>
				<Int attribute="Number" context="#stay"/>
                <DetectChar attribute="String" context="String" char="'"/>
				<StringDetect attribute="Directive" context="Prep1" String="(*$"/>
				<Detect2Chars attribute="Directive" context="Prep2" char="{" char1="$"/>
				<DetectChar attribute="Comment" context="Comment3" char="^/*"/>
<!-- 				<RegExpr attribute="Comment" context="Comment3" String="^\*" insensitive="true" endRegion="Region1"/> -->
				<RegExpr attribute="Comment" context="Comment3" String="^\*" insensitive="true"/>
            </context>
			      
            <!-- On match les bloc REPE et SI -->
            
            <context attribute="Normal Text" lineEndContext="#stay" name="FindCommands">
                <RegExpr attribute="Keyword" context="#stay" String="\brepe" insensitive="true" beginRegion="do"/>
                <RegExpr attribute="Keyword" context="#stay" String="\bfin(?=($|\s))" insensitive="true" endRegion="do"/>
                <RegExpr attribute="Keyword" context="#stay" String="\bsi(?![\w$+-])" insensitive="true" beginRegion="if"/>
                <RegExpr attribute="Keyword" context="#stay" String="\bsino" insensitive="true" endRegion="if" beginRegion="if"/>
                <RegExpr attribute="Keyword" context="#stay" String="\bsinon" insensitive="true" endRegion="if" beginRegion="if"/>
                <RegExpr attribute="Keyword" context="#stay" String="\bfins" insensitive="true" endRegion="if"/>
                <RegExpr attribute="Keyword" context="#stay" String="\bdebp" insensitive="true" beginRegion="procedure"/>
                <RegExpr attribute="Keyword" context="#stay" String="\bfinp" insensitive="true" endRegion="procedure"/>
            </context>




            

            <!-- Traitement des Strings et on pop au niveau Normal-->
            <context attribute="String" lineEndContext="#pop" name="String">
                <DetectChar attribute="String" context="#pop" char="'"/>
                <!-- exception : on fait attention aux Blocs cachés-->
                <RegExpr attribute="Keyword" context="#pop" String="\brepe'" insensitive="true" beginRegion="do"/>
                <RegExpr attribute="Keyword" context="#pop" String="\brepeter'" insensitive="true" beginRegion="do"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bfin'" insensitive="true" endRegion="do"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bsi'" insensitive="true" beginRegion="if"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bsino'" insensitive="true" endRegion="if" beginRegion="if"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bsinon'" insensitive="true" endRegion="if" beginRegion="if"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bfins'" insensitive="true" endRegion="if"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bfinsi'" insensitive="true" endRegion="if"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bdebp'" insensitive="true" beginRegion="procedure"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bdebproc'" insensitive="true" beginRegion="procedure"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bfinp'" insensitive="true" endRegion="procedure"/>
                <RegExpr attribute="Keyword" context="#pop" String="\bfinproc'" insensitive="true" endRegion="procedure"/>
                <!-- exception : on fait attention aux operateurs cachés : pas fait pour l instant-->
            </context>
            
			<context attribute="Directive" lineEndContext="#pop" name="Prep1">
				<Detect2Chars attribute="Directive" context="#pop" char="*" char1=")"/>
			</context>
			<context attribute="Directive" lineEndContext="#pop" name="Prep2">
				<DetectChar attribute="Directive" context="#pop" char="}"/>
			</context>
			<context attribute="Comment" lineEndContext="#pop" name="Comment3">
				<keyword attribute="Alert" context="#stay" String="attention"/>
			</context>
 		</contexts>
            

<!-- * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *  -->
<!-- *             S T Y L E   I T E M   D E F I N I T I O N S           *  -->
<!-- * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *  -->

		<itemDatas>
			<itemData name="Normal Text" defStyleNum="dsNormal"/>
			<itemData name="Keyword" defStyleNum="dsKeyword" color="#000080"/>
<!-- 			<itemData name="ISO/Delphi Extended"  defStyleNum="dsKeyword" color="#0000ff" /> -->
			<!--itemData name="Type"  defStyleNum="dsNormal" color="#ff0000"/-->
			<itemData name="Procedure" defStyleNum="dsKeyword" color="#006600"/>
			<itemData name="Logical" defStyleNum="dsOthers" color="#800080" selColor="#ffa0a0" bold="1" italic="0"/>
			<itemData name="Number" defStyleNum="dsDecVal" color="#004000"/>
			<itemData name="String" defStyleNum="dsString"/>
			<itemData name="Directive" defStyleNum="dsOthers"/>
			<itemData name="Comment" defStyleNum="dsComment " color="#a0a0a0"/>
			<itemData name="Alert" defStyleNum="dsAlert"/>
		</itemDatas>
	</highlighting>
	<general>
		<keywords casesensitive="0"/>
		<comments>
			<comment name="singleLine" start="*"/>
            <!--comment name="multiLine" start="{" end="}" /-->
			<comment name="multiLine" start="*"/>
		</comments>
	</general>
</language>